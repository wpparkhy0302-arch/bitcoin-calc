<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Freedom Planner — SkipTheLatte</title>
<style is:global>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f5f7fa;color:#1a1a1a;min-height:100vh}
nav{background:#fff;border-bottom:1px solid #e1e4e8;padding:0 24px;height:56px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.nav-logo{font-size:16px;font-weight:700;color:#1763B6;letter-spacing:-0.02em}
.nav-links{display:flex;gap:24px;font-size:13px}
.nav-links a{text-decoration:none;color:#586069;transition:color 0.15s}
.nav-links a:hover{color:#1763B6}
.nav-links a.active{color:#1763B6;font-weight:500}
.layout{display:grid;grid-template-columns:280px 1fr;gap:0;min-height:calc(100vh - 56px);padding:0 350px}
.sidebar{background:#fff;border-right:1px solid #e1e4e8;padding:20px;overflow-y:auto}
.sidebar-title{font-size:11px;font-weight:600;letter-spacing:0.08em;color:#8b949e;text-transform:uppercase;margin-bottom:16px}
.input-group{margin-bottom:14px}
.input-label{font-size:12px;color:#586069;margin-bottom:5px;font-weight:500}
.input-wrap{display:flex;align-items:center;border:1px solid #e1e4e8;border-radius:8px;padding:8px 12px;background:#f5f7fa;gap:6px}
.input-wrap:focus-within{border-color:#1763B6;background:#fff}
.input-wrap span{font-size:13px;color:#8b949e}
.input-wrap input{border:none;background:transparent;color:#1a1a1a;font-size:14px;font-weight:500;width:100%;outline:none}
.usd-val{font-size:11px;color:#8b949e;margin-top:3px;padding-left:4px}
.cagr-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:14px}
.cagr-btn{border:1px solid #e1e4e8;border-radius:8px;padding:8px;text-align:center;cursor:pointer;background:#f5f7fa;transition:all 0.15s}
.cagr-btn:hover{border-color:#1763B6}
.cagr-btn.active{background:#1763B6;border-color:#1763B6;color:#fff}
.cagr-btn .cname{font-size:12px;font-weight:600}
.cagr-btn .cval{font-size:10px;color:#8b949e}
.cagr-btn.active .cval{color:rgba(255,255,255,0.75)}
.custom-row{display:none;gap:8px;margin-bottom:14px;align-items:center}
.custom-row.show{display:flex}
.custom-row input{flex:1;border:1px solid #e1e4e8;border-radius:8px;padding:8px 12px;font-size:13px;outline:none}
.custom-row input:focus{border-color:#1763B6}
.custom-row span{font-size:13px;color:#586069}
.cagr-info{background:#f0f5ff;border:1px solid #b8d4f4;border-radius:8px;padding:10px 12px;margin-bottom:14px;font-size:12px;color:#1763B6;line-height:1.5}
.btc-price-box{background:#f5f7fa;border:1px solid #e1e4e8;border-radius:8px;padding:12px;margin-bottom:14px}
.btc-price-label{font-size:11px;color:#8b949e;margin-bottom:4px}
.btc-price-val{font-size:20px;font-weight:700;color:#1763B6}
.btc-price-change{font-size:11px;margin-top:2px}
.btc-price-change.up{color:#1a7a4a}
.btc-price-change.down{color:#c0392b}
.score-box{background:#f0f5ff;border-radius:8px;padding:12px;margin-bottom:14px;text-align:center}
.score-val{font-size:28px;font-weight:700;color:#1763B6}
.score-label{font-size:11px;color:#586069;margin-top:2px}
.score-sub{font-size:11px;color:#8b949e;margin-top:4px}
.main{padding:20px;overflow-y:auto}
.main-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #e1e4e8}
.main-header-left{font-size:13px;color:#586069}
.main-header-right{font-size:12px;font-weight:600;color:#1763B6}
.milestone-card{background:#fff;border:1px solid #e1e4e8;border-radius:12px;padding:14px 16px;margin-bottom:10px;display:grid;grid-template-columns:44px 1fr auto;gap:12px;align-items:start;transition:border-color 0.15s}
.milestone-card:hover{border-color:#1763B6}
.milestone-card.reached{border-color:#1a7a4a;background:#f0faf5}
.milestone-card.next{border-color:#1763B6;border-width:2px}
.m-icon{width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:22px;background:#f5f7fa;flex-shrink:0}
.m-title{font-size:14px;font-weight:600;color:#1a1a1a;margin-bottom:2px}
.m-desc{font-size:12px;color:#586069;margin-bottom:8px}
.m-progress-track{height:4px;background:#e1e4e8;border-radius:2px;overflow:hidden}
.m-progress-bar{height:100%;border-radius:2px;transition:width 0.5s ease}
.m-meta{text-align:right;flex-shrink:0;min-width:90px}
.m-date{font-size:11px;font-weight:600;background:#f0f5ff;color:#1763B6;padding:3px 8px;border-radius:4px;margin-bottom:4px;display:inline-block}
.m-time{font-size:10px;color:#8b949e;margin-bottom:2px}
.m-portfolio{font-size:11px;color:#586069}
.reached-badge{background:#1a7a4a;color:#fff;font-size:10px;font-weight:600;padding:3px 8px;border-radius:4px;display:inline-block}
.next-badge{background:#1763B6;color:#fff;font-size:10px;font-weight:600;padding:3px 8px;border-radius:4px;display:inline-block}
.recs{margin-top:20px}
.recs-title{font-size:12px;font-weight:600;letter-spacing:0.08em;color:#8b949e;text-transform:uppercase;margin-bottom:12px}
.rec-card{background:#fff;border:1px solid #e1e4e8;border-radius:10px;padding:14px;margin-bottom:8px;display:flex;gap:12px;align-items:flex-start}
.rec-icon{font-size:20px;flex-shrink:0;margin-top:2px}
.rec-body .rec-title{font-size:13px;font-weight:600;color:#1a1a1a;margin-bottom:4px}
.rec-body .rec-desc{font-size:12px;color:#586069;line-height:1.5}
.rec-badge{display:inline-block;margin-top:8px;font-size:11px;font-weight:600;padding:3px 10px;border-radius:4px}
.badge-high{background:#fdf3e3;color:#854F0B}
.badge-med{background:#f0f5ff;color:#1763B6}
.disclaimer{margin-top:20px;padding:14px;background:#fafbfc;border:1px solid #e1e4e8;border-radius:8px;font-size:11px;color:#8b949e;line-height:1.6}
.disclaimer strong{color:#586069}
.no-stack-msg{text-align:center;padding:60px 20px;color:#8b949e}
.no-stack-msg .big{font-size:40px;margin-bottom:12px}
.no-stack-msg p{font-size:14px}
</style>
</head>
<body>
<nav>
  <div class="nav-logo">SkipTheLatte</div>
  <div class="nav-links">
    <a href="/">Calculator</a>
    <a href="/freedom" class="active">Freedom Planner</a>
    <a href="/faq">FAQ</a>
  </div>
</nav>

<div style="background:#fff;border-bottom:1px solid #e1e4e8;padding:52px 350px 44px">
  <div style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1763B6;margin-bottom:16px;display:flex;align-items:center;gap:8px">
    <span style="display:inline-block;width:18px;height:2px;background:#1763B6"></span>
    Freedom Planner
  </div>
  <h1 style="font-size:clamp(44px,8vw,80px);font-weight:900;letter-spacing:-.04em;line-height:.95;margin-bottom:20px">
    <span style="color:#1763B6">SKIP</span> THE LATTE.
  </h1>
  <p style="font-size:clamp(15px,2vw,17px);color:#586069;line-height:1.6;max-width:520px">When will your Bitcoin stack set you free?</p>
</div>

<div class="layout">
  <div class="sidebar">
    <div class="sidebar-title">Your Numbers</div>

    <div class="input-group">
      <div class="input-label">Bitcoin Stack (BTC)</div>
      <div class="input-wrap">
        <span>&#x20BF;</span>
        <input type="number" id="btcStack" value="0.1" step="0.001" min="0" oninput="update()">
      </div>
      <div class="usd-val" id="btcUsdVal">≈ $7,345 USD</div>
    </div>

    <div class="input-group">
      <div class="input-label">Monthly DCA ($)</div>
      <div class="input-wrap">
        <span>$</span>
        <input type="number" id="monthlyDca" value="200" min="0" oninput="update()">
      </div>
    </div>

    <div class="input-group">
      <div class="input-label">Monthly Expenses ($)</div>
      <div class="input-wrap">
        <span>$</span>
        <input type="number" id="monthlyExpenses" value="3500" min="0" oninput="update()">
      </div>
    </div>

    <div class="input-label" style="margin-bottom:8px">Annual Growth Rate (CAGR)</div>
    <div class="cagr-grid">
      <div class="cagr-btn" onclick="setCagr(20,'bear')"><div class="cname">Bear</div><div class="cval">~20%/yr</div></div>
      <div class="cagr-btn active" id="btn-base" onclick="setCagr(55,'base')"><div class="cname">Base</div><div class="cval">~55%/yr</div></div>
      <div class="cagr-btn" onclick="setCagr(110,'bull')"><div class="cname">Bull</div><div class="cval">~110%/yr</div></div>
      <div class="cagr-btn" id="btn-custom" onclick="toggleCustom()"><div class="cname">Custom</div><div class="cval">you pick</div></div>
    </div>

    <div class="custom-row" id="customRow">
      <input type="number" id="customCagr" value="55" min="1" max="500" oninput="setCustomCagr()">
      <span>%/yr</span>
    </div>

    <div class="cagr-info" id="cagrInfo">Base 55%/yr · 3.72%/mo · historical avg</div>

    <div class="btc-price-box">
      <div class="btc-price-label">BTC Current Price</div>
      <div class="btc-price-val" id="btcPriceDisplay">Loading...</div>
      <div class="btc-price-change up" id="btcChangeDisplay"></div>
    </div>

    <div class="score-box">
      <div class="score-val" id="sovereigntyScore">0</div>
      <div class="score-label">Sovereignty Score</div>
      <div class="score-sub" id="scoreDesc">Enter your stack to begin</div>
    </div>

    <div class="input-group">
      <div class="input-label">&#127919; Freedom Target Year</div>
      <div class="input-wrap">
        <input type="number" id="targetYear" placeholder="e.g. 2035" min="2025" max="2100" oninput="update()">
      </div>
    </div>
  </div>

  <div class="main">
    <div class="main-header">
      <div class="main-header-left">Projections based on growth rate:</div>
      <div class="main-header-right" id="headerCagr">CAGR 55% · 3.72%/mo</div>
    </div>

    <div id="milestoneList">
      <div class="no-stack-msg">
        <div class="big">&#x20BF;</div>
        <p>Enter your Bitcoin stack to unlock your sovereignty timeline.</p>
      </div>
    </div>

    <div class="recs" id="recsSection" style="display:none">
      <div class="recs-title">&#128172; Plan Recommendations</div>
      <div id="recsList"></div>
    </div>

    <div class="disclaimer">
      <strong>Simulation Only — Not Financial Advice.</strong> All projections are based on historical Bitcoin performance and user-defined assumptions. Past performance is not indicative of future results. Bitcoin is highly volatile. This tool is for educational purposes only. Always consult a qualified financial advisor.
    </div>
  </div>
</div>

<script is:inline>
let btcPrice = 73000;
let currentCagr = 55;
let activeBtn = 'base';

const milestones = [
  { id: 'm1', emoji: '☕', title: '3 Months Free', desc: 'First taste of breathing room', multiplier: 3/12, color: '#1a7a4a' },
  { id: 'm2', emoji: '🌊', title: '6 Months Runway', desc: 'Half a year — no financial pressure', multiplier: 6/12, color: '#1763B6' },
  { id: 'm3', emoji: '🦅', title: '1 Year of Freedom', desc: '12 months of expenses stored in your stack', multiplier: 1, color: '#8957e5' },
  { id: 'm4', emoji: '⚡', title: '5-Year Sovereignty', desc: '5 years — no employer can touch you', multiplier: 5, color: '#e3a228' },
  { id: 'm5', emoji: '🎯', title: 'FIRE Number', desc: 'Annual expenses x25 — retirement threshold', multiplier: 25, color: '#d73a49', fireBased: true },
  { id: 'm6', emoji: '💎', title: '$1M Stack', desc: '7-figure hard money', target: 1000000, fixedTarget: true, color: '#1763B6' },
  { id: 'm7', emoji: '∞', title: 'Never Sell Time Again', desc: 'Appreciation alone covers your lifestyle — forever', multiplier: 0, perpetual: true, color: '#8957e5' },
  { id: 'm8', emoji: '🏛️', title: 'Generational Wealth', desc: 'Annual income x100 — a legacy that outlasts you', multiplier: 100, annualBased: true, color: '#e3a228' },
];

async function fetchBtcPrice() {
  try {
    const r = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_change=true');
    const d = await r.json();
    btcPrice = d.bitcoin.usd;
    const change = d.bitcoin.usd_24h_change;
    document.getElementById('btcPriceDisplay').textContent = '$' + btcPrice.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
    const el = document.getElementById('btcChangeDisplay');
    el.textContent = (change >= 0 ? '+' : '') + change.toFixed(2) + '% (24h)';
    el.className = 'btc-price-change ' + (change >= 0 ? 'up' : 'down');
    update();
  } catch(e) {
    document.getElementById('btcPriceDisplay').textContent = '$73,000.00';
    document.getElementById('btcChangeDisplay').textContent = 'Price unavailable';
    update();
  }
}

function setCagr(val, name) {
  currentCagr = val;
  activeBtn = name;
  document.querySelectorAll('.cagr-btn').forEach(b => b.classList.remove('active'));
  if (name !== 'custom') {
    document.getElementById('btn-' + name)?.classList.add('active');
    document.getElementById('customRow').classList.remove('show');
  }
  updateCagrInfo();
  update();
}

function toggleCustom() {
  const row = document.getElementById('customRow');
  row.classList.toggle('show');
  if (row.classList.contains('show')) {
    document.querySelectorAll('.cagr-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('btn-custom').classList.add('active');
    setCustomCagr();
  }
}

function setCustomCagr() {
  const v = parseFloat(document.getElementById('customCagr').value) || 55;
  currentCagr = v;
  updateCagrInfo();
  update();
}

function updateCagrInfo() {
  const monthly = ((1 + currentCagr/100) ** (1/12) - 1) * 100;
  document.getElementById('cagrInfo').textContent = currentCagr + '%/yr · ' + monthly.toFixed(2) + '%/mo compounding';
  document.getElementById('headerCagr').textContent = 'CAGR ' + currentCagr + '% · ' + monthly.toFixed(2) + '%/mo';
}

function monthsToReach(currentBtcVal, monthlyDca, targetUsd, cagr) {
  const monthlyRate = (1 + cagr/100) ** (1/12) - 1;
  let portfolio = currentBtcVal;
  for (let m = 0; m < 600; m++) {
    portfolio = portfolio * (1 + monthlyRate) + monthlyDca;
    if (portfolio >= targetUsd) return m + 1;
  }
  return null;
}

function formatK(val) {
  if (val >= 1000000) return '$' + (val/1000000).toFixed(2) + 'M';
  if (val >= 1000) return '$' + Math.round(val/1000) + 'K';
  return '$' + Math.round(val);
}

function update() {
  const btcStack = parseFloat(document.getElementById('btcStack').value) || 0;
  const monthlyDca = parseFloat(document.getElementById('monthlyDca').value) || 0;
  const monthlyExpenses = parseFloat(document.getElementById('monthlyExpenses').value) || 0;
  const targetYear = parseInt(document.getElementById('targetYear').value) || null;
  const annualExpenses = monthlyExpenses * 12;
  const currentBtcVal = btcStack * btcPrice;

  document.getElementById('btcUsdVal').textContent = '≈ $' + currentBtcVal.toLocaleString('en-US', {maximumFractionDigits:0});

  if (btcStack <= 0) {
    document.getElementById('milestoneList').innerHTML = '<div class="no-stack-msg"><div class="big">₿</div><p>Enter your Bitcoin stack to unlock your sovereignty timeline.</p></div>';
    document.getElementById('recsSection').style.display = 'none';
    document.getElementById('sovereigntyScore').textContent = '0';
    document.getElementById('scoreDesc').textContent = 'Enter your stack to begin';
    return;
  }

  const now = new Date();
  let reached = 0;
  let html = '';

  milestones.forEach((m, i) => {
    let targetUsd;
    if (m.fixedTarget) {
      targetUsd = m.target;
    } else if (m.fireBased) {
      targetUsd = annualExpenses * m.multiplier;
    } else if (m.annualBased) {
      targetUsd = annualExpenses * m.multiplier;
    } else if (m.perpetual) {
      targetUsd = (annualExpenses / (currentCagr/100)) * 100;
    } else {
      targetUsd = monthlyExpenses * m.multiplier * 12;
    }

    if (targetUsd <= 0) targetUsd = currentBtcVal * 2;

    const months = monthsToReach(currentBtcVal, monthlyDca, targetUsd, currentCagr);
    const isReached = currentBtcVal >= targetUsd;
    if (isReached) reached++;

    let dateStr = '', timeStr = '', portfolioStr = '';
    if (isReached) {
      dateStr = 'Reached';
      timeStr = '';
    } else if (months !== null) {
      const d = new Date(now);
      d.setMonth(d.getMonth() + months);
      dateStr = d.toLocaleDateString('en-US', {month:'short', year:'numeric'});
      const yrs = (months/12).toFixed(1);
      timeStr = 'In ' + yrs + ' yrs';
    } else {
      dateStr = '50+ yrs';
      timeStr = 'Very long horizon';
    }

    const monthlyRate = (1 + currentCagr/100) ** (1/12) - 1;
    let futureVal = currentBtcVal;
    const mCount = months || 120;
    for (let x = 0; x < mCount; x++) futureVal = futureVal * (1 + monthlyRate) + monthlyDca;

    portfolioStr = formatK(currentBtcVal) + ' / ' + formatK(Math.min(futureVal, targetUsd * 1.1));

    const progress = isReached ? 100 : Math.min(99, (currentBtcVal / targetUsd) * 100);
    const isNext = !isReached && i === milestones.findIndex(x => {
      const t = x.fixedTarget ? x.target : (x.fireBased ? annualExpenses*x.multiplier : monthlyExpenses*x.multiplier*12);
      return currentBtcVal < t;
    });

    html += `<div class="milestone-card ${isReached?'reached':''} ${isNext?'next':''}">
      <div class="m-icon">${m.emoji}</div>
      <div>
        <div class="m-title">${m.title}</div>
        <div class="m-desc">${m.desc}</div>
        <div class="m-progress-track"><div class="m-progress-bar" style="width:${progress}%;background:${m.color}"></div></div>
      </div>
      <div class="m-meta">
        ${isReached ? '<span class="reached-badge">✓ Reached</span>' : isNext ? '<span class="next-badge">Next</span>' : '<span class="m-date">'+dateStr+'</span>'}
        <div class="m-time">${timeStr}</div>
        <div class="m-portfolio">${portfolioStr}</div>
      </div>
    </div>`;
  });

  document.getElementById('milestoneList').innerHTML = html;

  const score = Math.min(100, Math.round((reached / milestones.length) * 100 + (currentBtcVal / (monthlyExpenses*12)) * 10));
  document.getElementById('sovereigntyScore').textContent = score;
  const descs = ['Just getting started','Building momentum','On the right path','Getting serious','Almost sovereign','Truly sovereign'];
  document.getElementById('scoreDesc').textContent = descs[Math.min(5, Math.floor(score/20))];

  buildRecs(btcStack, monthlyDca, monthlyExpenses, currentBtcVal, annualExpenses);
  document.getElementById('recsSection').style.display = 'block';
}

function buildRecs(btcStack, monthlyDca, monthlyExpenses, currentBtcVal, annualExpenses) {
  let recs = [];
  const dcaRatio = monthlyDca / monthlyExpenses;

  if (dcaRatio < 0.1) {
    recs.push({
      icon: '⚠️',
      title: `You're stacking ${(dcaRatio*100).toFixed(1)}% of spending — below escape velocity`,
      desc: `Stackers who reach sovereignty typically put 10–20% of budget into Bitcoin. Raising to $${Math.round(monthlyExpenses*0.1)}/mo would lift your rate to 10%.`,
      badge: 'High Impact', type: 'high'
    });
  }

  if (monthlyExpenses > 3000) {
    recs.push({
      icon: '✂️',
      title: `Cut $500/mo → your FIRE target drops by $150K`,
      desc: `Going from $${monthlyExpenses.toLocaleString()} to $${(monthlyExpenses-500).toLocaleString()}/mo shrinks your FIRE number significantly and compresses every single milestone.`,
      badge: 'High Impact', type: 'high'
    });
  }

  recs.push({
    icon: '📈',
    title: `Bull scenario (110% CAGR) compresses your timeline by ${Math.round((1 - Math.log(1+55/100)/Math.log(1+110/100))*100)}%`,
    desc: `If Bitcoin performs at historical peak rates, FIRE could arrive years earlier. The base vs bull difference is about one Bitcoin cycle.`,
    badge: 'Medium Impact', type: 'med'
  });

  let html = recs.map(r => `<div class="rec-card">
    <div class="rec-icon">${r.icon}</div>
    <div class="rec-body">
      <div class="rec-title">${r.title}</div>
      <div class="rec-desc">${r.desc}</div>
      <span class="rec-badge ${r.type==='high'?'badge-high':'badge-med'}">${r.badge}</span>
    </div>
  </div>`).join('');
  document.getElementById('recsList').innerHTML = html;
}

updateCagrInfo();
fetchBtcPrice();
setInterval(fetchBtcPrice, 60000);
</script>
</body>
</html>
