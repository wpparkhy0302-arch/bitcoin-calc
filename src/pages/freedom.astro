// ════════════════════════════════════════════
//  Formatters
// ════════════════════════════════════════════
function fK(n) {
  if (n == null || isNaN(n)) return '—';
  if (n >= 1e9) return '$'+(n/1e9).toFixed(2)+'B';
  if (n >= 1e6) return '$'+(n/1e6).toFixed(2)+'M';
  if (n >= 1e3) return '$'+(n/1e3).toFixed(1)+'K';
  return '$'+n.toFixed(0);
}
function fFull(n) {
  if (n == null || isNaN(n)) return '—';
  return '$'+n.toLocaleString('en-US',{maximumFractionDigits:0});
}
function fDate(d) {
  if (!d) return '> 40 yrs';
  return d.toLocaleString('en-US',{month:'short',year:'numeric'});
}
function fYrs(y) {
  if (y == null) return '';
  if (y < 0.08) return 'Now ✓';
  return 'In '+y.toFixed(1)+' yrs';
}

// ════════════════════════════════════════════
//  Slider / scenario
// ════════════════════════════════════════════
function setPct(el) {
  const pct = ((el.value - el.min)/(el.max - el.min)*100).toFixed(1)+'%';
  el.style.setProperty('--pct', pct);
}
function getCagr() { return +document.getElementById('cagr-sl').value || 55; }

function onSlide(el) {
  setPct(el);
  activeSc = 'custom';
  SC.custom.cagr = +el.value;
  document.getElementById('cust-pct').textContent = el.value+'%';
  document.querySelectorAll('.cg').forEach(b => b.classList.toggle('on', b.dataset.sc === 'custom'));
  // Update slider color to purple for custom
  el.style.background = `linear-gradient(to right,#8b5cf6 0%,#8b5cf6 ${((el.value-el.min)/(el.max-el.min)*100).toFixed(1)}%,var(--surf3) ${((el.value-el.min)/(el.max-el.min)*100).toFixed(1)}%,var(--surf3) 100%)`;
  updCagrUI();
  go();
}

function setSc(sc) {
  activeSc = sc;
  const s = SC[sc];
  const sl = document.getElementById('cagr-sl');
  if (sc !== 'custom') {
    sl.value = s.cagr;
    setPct(sl);
    // Update slider track color
    const pct = ((s.cagr - 5)/(150 - 5)*100).toFixed(1);
    sl.style.background = `linear-gradient(to right,${s.color} 0%,${s.color} ${pct}%,var(--surf3) ${pct}%,var(--surf3) 100%)`;
  }
  document.getElementById('cust-pct').textContent = s.cagr+'%';
  document.querySelectorAll('.cg').forEach(b => b.classList.toggle('on', b.dataset.sc === sc));
  updCagrUI();
  go();
}

function updCagrUI() {
  const cagr = getCagr();
  const mo   = (Math.pow(1 + cagr/100, 1/12) - 1) * 100;
  const s    = SC[activeSc];
  document.getElementById('cagr-main').textContent = s.label + ' CAGR ' + cagr + '%/yr · monthly: ' + mo.toFixed(1) + '%';
  document.getElementById('cagr-sub').textContent  = s.sub;
  document.getElementById('proj-cagr').textContent = 'CAGR ' + cagr + '%/yr · ' + mo.toFixed(1) + '%/mo compounding';
}

// ════════════════════════════════════════════
//  CoinGecko fetch
// ════════════════════════════════════════════
async function fetchPrice(manual = false) {
  const rb = document.getElementById('ref-btn');
  if (rb) rb.classList.add('sp');
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 9000);
  try {
    const r = await fetch(
      'https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_change=true',
      { signal: ctrl.signal }
    );
    clearTimeout(timer);
    if (!r.ok) throw new Error('HTTP '+r.status);
    const d = await r.json();
    BTC   = d.bitcoin.usd;
    chg24 = d.bitcoin.usd_24h_change ?? 0;

    const pn = document.getElementById('btc-price-num');
    const pc = document.getElementById('btc-chg');
    const np = document.getElementById('nav-price');
    if (pn) pn.textContent = '$'+BTC.toLocaleString('en-US');
    if (pc) { pc.textContent = (chg24>=0?'▲ +':'▼ ')+Math.abs(chg24).toFixed(2)+'%'; pc.style.color = chg24>=0?'#22c55e':'#ef4444'; }
    if (np) np.textContent  = '$'+BTC.toLocaleString('en-US')+' '+(chg24>=0?'▲':'▼')+' '+Math.abs(chg24).toFixed(2)+'%';
    go();
  } catch(e) {
    clearTimeout(timer);
    const np = document.getElementById('nav-price');
    if (np) np.textContent = 'API Error';
    console.warn('fetchPrice failed:', e.message);
  } finally {
    if (rb) rb.classList.remove('sp');
  }
}

// ════════════════════════════════════════════
//  Core monthly simulation
// ════════════════════════════════════════════
function simulate(stack, dca, exp, price, cagrPct) {
  if (!price) return null;
  const mGrow = Math.pow(1 + cagrPct/100, 1/12);
  const now   = new Date();
  const curP  = stack * price;

  // Build milestone targets (some depend on cagr)
  const mss = MS_DEF.map(m => ({
    ...m,
    tgt: m.target(exp, cagrPct),
    reached: false, date: null, yrsAway: null, portAtMs: null,
  }));

  // Mark already achieved at t=0
  mss.forEach(m => {
    if (curP >= m.tgt) { m.reached = true; m.date = new Date(); m.yrsAway = 0; m.portAtMs = curP; }
  });

  // Simulate month by month
  const pending = mss.filter(m => !m.reached);
  let s = stack, p = price;
  for (let mo = 1; mo <= 480 && pending.length > 0; mo++) {
    s += dca / p;
    p *= mGrow;
    const port = s * p;
    for (let i = pending.length - 1; i >= 0; i--) {
      if (port >= pending[i].tgt) {
        pending[i].date    = new Date(now.getFullYear(), now.getMonth() + mo, 1);
        pending[i].yrsAway = mo / 12;
        pending[i].portAtMs= port;
        pending.splice(i, 1);
      }
    }
  }
  return mss;
}

// ════════════════════════════════════════════
//  Render milestones
// ════════════════════════════════════════════
function renderMs(mss) {
  const list = document.getElementById('ms-list');
  list.innerHTML = '';
  if (!mss || !BTC) return;

  const stack  = parseFloat(document.getElementById('btc-stack').value) || 0;
  const curP   = stack * BTC;
  let reached  = 0;

  mss.forEach(m => {
    const isReached = curP >= m.tgt;
    if (isReached) reached++;
    const pct     = m.tgt > 0 ? Math.min(100, (curP / m.tgt) * 100) : 0;
    const barClr  = isReached ? '#22c55e' : m.color;
    const dateStr = isReached ? 'Achieved ✓' : fDate(m.date);
    const timeStr = isReached ? 'Complete'   : fYrs(m.yrsAway);
    const valL    = fK(curP);
    const valR    = fK(m.tgt);

    const card = document.createElement('div');
    card.className = 'ms-card' + (isReached ? ' achieved' : '');
    card.innerHTML = `
      <div class="ms-bar-l" style="background:${barClr}"></div>
      <div class="ms-content">
        <div class="ms-r1">
          <div class="ms-left">
            <span class="ms-emoji">${m.emoji}</span>
            <div class="ms-txt">
              <div class="ms-name">${m.name}</div>
              <div class="ms-desc">${m.desc}</div>
            </div>
          </div>
          <div class="ms-right">
            <div class="ms-date">${dateStr}</div>
            <div class="ms-time">${timeStr}</div>
          </div>
        </div>
        <div class="ms-r2">
          <div class="ms-vals">
            <span class="ms-val-l">${valL} / ${valR}</span>
            <span class="ms-val-r" style="color:${barClr}">${pct.toFixed(0)}%</span>
          </div>
          <div class="ms-prog-bg">
            <div class="ms-prog" style="width:${pct}%;background:${barClr}"></div>
          </div>
        </div>
      </div>`;
    list.appendChild(card);
  });

  // Update sidebar score
  const fireMs  = mss.find(m => m.id === 'fire');
  const fireTgt = fireMs?.tgt ?? 1;
  const rawScore= BTC ? Math.min(100, (stack * BTC / fireTgt) * 100) : 0;
  const score   = Math.round(rawScore);
  const scoreEl = document.getElementById('sov-score');
  const barEl   = document.getElementById('sov-bar');
  const statEl  = document.getElementById('sov-status');
  const cntEl   = document.getElementById('ms-count');
  if (scoreEl) scoreEl.innerHTML = score+'<span style="font-size:12px;font-weight:500;color:var(--t3)">/100</span>';
  const barColor = score < 20 ? '#ef4444' : score < 50 ? '#f59e0b' : score < 80 ? '#1763B6' : '#22c55e';
  if (barEl) { barEl.style.width = score+'%'; barEl.style.background = barColor; }
  const statuses = [[5,'Just getting started'],[15,'Accumulating'],[30,'Building momentum'],[50,'Stacking up'],[75,'Almost there'],[95,'Near freedom'],[100,'Sovereign ✓']];
  if (statEl) statEl.textContent = statuses.find(([t])=>score<=t)?.[1] ?? 'Sovereign ✓';
  if (cntEl) cntEl.textContent = reached+'/'+mss.length;
}

// ════════════════════════════════════════════
//  Render recommendations
// ════════════════════════════════════════════
function renderRecs(stack, dca, exp, cagr, mss) {
  const cont  = document.getElementById('rec-list');
  cont.innerHTML = '';
  const recs  = [];
  const curP  = stack * BTC;
  const fireMs = mss?.find(m => m.id === 'fire');
  const fireYrs= fireMs?.yrsAway;
  const dcaRatio = exp > 0 ? (dca / exp) * 100 : 0;
  const ty     = parseInt(document.getElementById('target-yr').value);
  const cyear  = new Date().getFullYear();

  // 1 — DCA velocity check
  if (dcaRatio < 10 && exp > 0) {
    const sug = Math.ceil(exp * 0.1 / 50) * 50;
    recs.push({
      ic:'⚠️', tag:'High Impact', cls:'tag-hi',
      ttl:`You're only stacking ${dcaRatio.toFixed(1)}% of your spending — that's below escape velocity`,
      body:`Stackers who reach sovereignty typically put 10–20% of their budget into Bitcoin. Right now you're putting $${dca} against $${exp}/mo of expenses. Raising to $${sug}/mo would lift your rate to ${((sug/exp)*100).toFixed(0)}% and compress every single milestone on your timeline.`,
    });
  }

  // 2 — Expense cut impact
  if (exp > 1000) {
    const cut  = Math.round(exp * 0.1 / 50) * 50;
    const save = cut * 12 * 25;
    recs.push({
      ic:'✂️', tag:'High Impact', cls:'tag-hi',
      ttl:`Cut $${cut}/mo → your FIRE target drops by ${fK(save)}`,
      body:`Going from $${exp} to $${exp-cut}/mo in expenses shrinks your FIRE number from ${fK(exp*12*25)} to ${fK((exp-cut)*12*25)} — and hits your FIRE number months earlier. Every dollar you stop spending is worth 25× in freedom.`,
    });
  }

  // 3 — Target year vs projection
  if (ty && fireMs?.date) {
    const projYr = fireMs.date.getFullYear();
    const diff   = projYr - ty;
    if (diff > 2) {
      recs.push({
        ic:'🎯', tag:'Medium Impact', cls:'tag-md',
        ttl:`You're projected to be free ${diff} years after your ${ty} target`,
        body:`Current trajectory hits FIRE in ${projYr}. To hit ${ty}, try increasing your DCA, cutting expenses, or switching to the Bull scenario to see the impact.`,
      });
    } else if (diff <= 0) {
      recs.push({
        ic:'✅', tag:'On Track', cls:'tag-ok',
        ttl:`On track to hit freedom before your ${ty} target!`,
        body:`Projected FIRE date is ${fDate(fireMs.date)} — ${Math.abs(diff)} year${Math.abs(diff)!==1?'s':''} ahead of schedule. Keep stacking. ₿`,
      });
    }
  }

  // 4 — Bull upside
  if (cagr < 110 && fireYrs && fireYrs > 3) {
    const bRes  = simulate(stack, dca, exp, BTC, 110);
    const bFire = bRes?.find(m => m.id === 'fire');
    if (bFire?.yrsAway) {
      const saved = (fireYrs - bFire.yrsAway).toFixed(1);
      if (parseFloat(saved) > 0.5) {
        recs.push({
          ic:'🐂', tag:'Medium Impact', cls:'tag-md',
          ttl:`Bull scenario (110% CAGR) cuts ${saved} years off your timeline`,
          body:`If Bitcoin achieves its historical adoption growth rate, you'd hit FIRE in ${bFire.yrsAway.toFixed(1)} years instead of ${fireYrs.toFixed(1)}. The difference between Base and Bull is roughly one Bitcoin halving cycle of outperformance.`,
        });
      }
    }
  }

  if (recs.length === 0) {
    cont.innerHTML = '<div style="font-size:12px;color:var(--t3);padding:4px 0">Looking solid — keep stacking! ₿</div>';
    return;
  }
  recs.slice(0, 3).forEach(r => {
    const el = document.createElement('div');
    el.className = 'rec';
    el.innerHTML = `
      <div class="rec-top"><span class="rec-ic">${r.ic}</span><div class="rec-ttl">${r.ttl}</div></div>
      <div class="rec-body">${r.body}</div>
      <span class="tag ${r.cls}">${r.tag}</span>`;
    cont.appendChild(el);
  });
}

// ════════════════════════════════════════════
//  Main go()
// ════════════════════════════════════════════
function go() {
  const stack = parseFloat(document.getElementById('btc-stack').value) || 0;
  const dca   = parseFloat(document.getElementById('monthly-dca').value) || 0;
  const exp   = parseFloat(document.getElementById('monthly-exp').value) || 0;
  const cagr  = getCagr();

  // Stack hint
  const sh = document.getElementById('stack-hint');
  if (sh) sh.textContent = BTC ? '≈ '+fFull(stack * BTC)+' USD' : '≈ $— USD';

  // Target year hint
  const ty = parseInt(document.getElementById('target-yr').value);
  const th = document.getElementById('target-hint');
  if (th && ty) {
    const left = ty - new Date().getFullYear();
    th.textContent = left > 0 ? left+' years from now' : left === 0 ? 'This year!' : 'In the past';
  } else if (th) th.textContent = '';

  if (!BTC) return;
  const mss = simulate(stack, dca, exp, BTC, cagr);
  renderMs(mss);
  renderRecs(stack, dca, exp, cagr, mss);
}

