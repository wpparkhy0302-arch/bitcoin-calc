---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="description" content="SkipTheLatte Freedom Planner — Bitcoin milestone timeline to financial sovereignty."/>
  <title>Freedom Planner — SkipTheLatte</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:     #0a0a0a;
      --surf:   #111111;
      --surf2:  #1a1a1a;
      --surf3:  #222222;
      --bd:     rgba(255,255,255,.07);
      --bd2:    rgba(255,255,255,.12);
      --blue:   #1763B6;
      --blue-l: rgba(23,99,182,.15);
      --green:  #05b26b;
      --red:    #f04452;
      --amber:  #f59e0b;
      --text:   #f0f0f0;
      --text2:  #888888;
      --text3:  #555555;
      --nav-h:  52px;
      --left-w: 288px;
      --font:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    }
    html{font-family:var(--font);background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
    body{height:100vh;display:flex;flex-direction:column;overflow:hidden}
    button{font-family:inherit;cursor:pointer}
    input,select{font-family:inherit}

    /* ── NAV ──────────────────────────────────── */
    .nav{
      flex-shrink:0;height:var(--nav-h);
      background:var(--surf);border-bottom:1px solid var(--bd);
      display:flex;align-items:center;justify-content:space-between;
      padding:0 20px;z-index:100;
    }
    .nav-logo{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:800;color:var(--text);letter-spacing:-.02em;text-decoration:none}
    .logo-dot{width:7px;height:7px;border-radius:50%;background:var(--blue)}
    .nav-links{display:flex;align-items:center;gap:2px}
    .nav-a{
      padding:4px 11px;font-size:13px;font-weight:500;color:var(--text2);
      border-radius:6px;text-decoration:none;transition:all .12s;
    }
    .nav-a:hover{color:var(--text);background:var(--surf2)}
    .nav-a.active{color:var(--blue);background:var(--blue-l)}
    .nav-btc{font-size:12px;font-weight:600;color:var(--text2);display:flex;align-items:center;gap:5px}
    .live-dot{width:5px;height:5px;border-radius:50%;background:var(--green);animation:blink 2s ease-in-out infinite;flex-shrink:0}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

    /* ── APP LAYOUT ───────────────────────────── */
    .app{flex:1;display:flex;overflow:hidden;min-height:0}

    /* ── LEFT PANEL ───────────────────────────── */
    .left{
      width:var(--left-w);flex-shrink:0;
      background:var(--surf);border-right:1px solid var(--bd);
      overflow-y:auto;display:flex;flex-direction:column;gap:0;
    }
    .left::-webkit-scrollbar{width:4px}
    .left::-webkit-scrollbar-thumb{background:var(--bd2);border-radius:2px}

    .l-section{padding:16px;border-bottom:1px solid var(--bd)}
    .l-section:last-child{border-bottom:none}

    .l-label{
      font-size:9px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
      color:var(--text3);margin-bottom:10px;
    }
    .l-field{display:flex;flex-direction:column;gap:5px;margin-bottom:12px}
    .l-field:last-child{margin-bottom:0}
    .l-field label{font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--text3)}
    .l-irow{position:relative;display:flex;align-items:center}
    .l-pre{position:absolute;left:10px;font-size:12px;font-weight:600;color:var(--text3);pointer-events:none;z-index:1}
    .l-suf{position:absolute;right:10px;font-size:11px;font-weight:600;color:var(--text3);pointer-events:none;z-index:1}
    .l-field input[type="number"],.l-field input[type="text"]{
      width:100%;background:var(--surf2);border:1px solid var(--bd2);color:var(--text);
      padding:9px 10px 9px 26px;border-radius:7px;
      font-size:14px;font-weight:600;font-variant-numeric:tabular-nums;
      transition:border-color .15s;-moz-appearance:textfield;
    }
    .l-field input::-webkit-inner-spin-button,.l-field input::-webkit-outer-spin-button{-webkit-appearance:none}
    .l-field input:focus{outline:none;border-color:var(--blue);background:#151515}
    .l-field input::placeholder{color:var(--text3);font-weight:400}
    .l-hint{font-size:11px;color:var(--text3);margin-top:2px;font-variant-numeric:tabular-nums}

    /* CAGR buttons */
    .cagr-btns{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:10px}
    .cagr-btn{
      padding:7px 6px;border-radius:7px;font-size:12px;font-weight:700;
      background:var(--surf2);border:1px solid var(--bd2);color:var(--text2);
      transition:all .12s;
    }
    .cagr-btn:hover{border-color:var(--bd2);color:var(--text)}
    .cagr-btn.on[data-sc="bear"] {background:rgba(240,68,82,.15);border-color:var(--red);color:var(--red)}
    .cagr-btn.on[data-sc="base"] {background:rgba(23,99,182,.15);border-color:var(--blue);color:var(--blue)}
    .cagr-btn.on[data-sc="bull"] {background:rgba(5,178,107,.15);border-color:var(--green);color:var(--green)}
    .cagr-btn.on[data-sc="custom"]{background:rgba(245,158,11,.15);border-color:var(--amber);color:var(--amber)}

    /* Slider */
    .l-slider{-webkit-appearance:none;width:100%;height:3px;border-radius:2px;outline:none;cursor:pointer;
      background:linear-gradient(to right,var(--blue) 0%,var(--blue) var(--pct,30%),var(--surf3) var(--pct,30%),var(--surf3) 100%);
      margin:8px 0 4px;
    }
    .l-slider::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:50%;background:var(--blue);border:2px solid var(--surf);cursor:pointer;box-shadow:0 0 0 3px rgba(23,99,182,.2)}
    .l-slider::-moz-range-thumb{width:16px;height:16px;border-radius:50%;background:var(--blue);border:2px solid var(--surf);cursor:pointer}

    .cagr-info-box{
      background:var(--surf2);border:1px solid var(--bd);border-radius:7px;
      padding:8px 10px;margin-top:6px;
    }
    .cagr-info-main{font-size:12px;font-weight:700;color:var(--text);margin-bottom:2px}
    .cagr-info-sub{font-size:11px;color:var(--text3)}

    .btc-price-box{
      background:var(--surf2);border:1px solid var(--bd);border-radius:7px;
      padding:10px 12px;display:flex;align-items:center;justify-content:space-between;
    }
    .btc-price-val{font-size:16px;font-weight:800;color:var(--text);font-variant-numeric:tabular-nums}
    .btc-price-change{font-size:12px;font-weight:600}
    .btn-tiny-refresh{background:transparent;border:1px solid var(--bd2);border-radius:5px;color:var(--text3);padding:3px 7px;font-size:13px;transition:all .12s}
    .btn-tiny-refresh:hover{color:var(--text);border-color:var(--bd2)}
    .btn-tiny-refresh.spin{animation:spin .6s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}

    .target-hint{font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);margin-bottom:6px}
    .target-input{
      width:100%;background:var(--surf2);border:1px solid var(--bd2);color:var(--text);
      padding:9px 12px;border-radius:7px;font-size:14px;font-weight:600;
      -moz-appearance:textfield;
    }
    .target-input::-webkit-inner-spin-button,.target-input::-webkit-outer-spin-button{-webkit-appearance:none}
    .target-input:focus{outline:none;border-color:var(--blue);background:#151515}
    .target-input::placeholder{color:var(--text3);font-weight:400}

    /* ── RIGHT PANEL ──────────────────────────── */
    .right{flex:1;overflow-y:auto;display:flex;flex-direction:column;min-height:0}
    .right::-webkit-scrollbar{width:4px}
    .right::-webkit-scrollbar-thumb{background:var(--bd2);border-radius:2px}

    .r-header{
      flex-shrink:0;padding:12px 20px;
      border-bottom:1px solid var(--bd);
      display:flex;align-items:center;justify-content:space-between;
      background:rgba(255,255,255,.015);
    }
    .r-header-left{font-size:11px;color:var(--text3)}
    .r-header-right{font-size:12px;font-weight:700;color:var(--blue)}

    /* ── MILESTONE CARDS ──────────────────────── */
    .milestones{display:flex;flex-direction:column;padding:8px 0}

    .ms-card{
      padding:14px 20px;border-bottom:1px solid var(--bd);
      transition:background .15s;cursor:default;
    }
    .ms-card:hover{background:rgba(255,255,255,.025)}
    .ms-card.achieved{background:rgba(5,178,107,.04)}
    .ms-card.achieved:hover{background:rgba(5,178,107,.07)}

    .ms-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}
    .ms-left-block{display:flex;align-items:center;gap:10px;flex:1;min-width:0}
    .ms-icon-wrap{
      width:34px;height:34px;border-radius:9px;flex-shrink:0;
      display:flex;align-items:center;justify-content:center;font-size:16px;
    }
    .ms-text{flex:1;min-width:0}
    .ms-name{font-size:14px;font-weight:700;color:var(--text);line-height:1.2}
    .ms-sub{font-size:11px;color:var(--text3);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .ms-card.achieved .ms-sub{color:#4de0a0}

    .ms-right-block{display:flex;flex-direction:column;align-items:flex-end;gap:3px;flex-shrink:0}
    .ms-date-badge{
      padding:3px 9px;border-radius:5px;font-size:11px;font-weight:700;
      background:var(--surf2);color:var(--text2);border:1px solid var(--bd2);
      font-variant-numeric:tabular-nums;
    }
    .ms-card.achieved .ms-date-badge{background:rgba(5,178,107,.15);border-color:rgba(5,178,107,.3);color:var(--green)}
    .ms-time{font-size:11px;color:var(--text3);font-variant-numeric:tabular-nums}
    .ms-values{font-size:11px;color:var(--text3);font-variant-numeric:tabular-nums}

    .ms-bar-wrap{height:3px;background:var(--surf3);border-radius:2px;overflow:hidden}
    .ms-bar{height:100%;border-radius:2px;transition:width .4s ease}

    /* ── RECOMMENDATIONS ──────────────────────── */
    .recs-section{padding:16px 20px;border-top:1px solid var(--bd);margin-top:auto}
    .recs-header{
      font-size:9px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
      color:var(--text3);display:flex;align-items:center;gap:8px;margin-bottom:12px;
    }
    .recs-header::before{content:'■';font-size:8px}
    .rec-cards{display:flex;flex-direction:column;gap:8px}
    .rec-card{
      background:var(--surf2);border:1px solid var(--bd);border-radius:10px;padding:14px 16px;
    }
    .rec-card-top{display:flex;align-items:flex-start;gap:10px;margin-bottom:6px}
    .rec-icon{font-size:16px;flex-shrink:0;margin-top:1px}
    .rec-title{font-size:13px;font-weight:700;color:var(--text);line-height:1.35}
    .rec-body{font-size:12px;color:var(--text2);line-height:1.6;margin-bottom:8px;padding-left:26px}
    .rec-tag{
      display:inline-block;padding:3px 9px;border-radius:5px;font-size:11px;font-weight:700;
      letter-spacing:.04em;
    }
    .tag-high{background:rgba(245,158,11,.15);color:var(--amber);border:1px solid rgba(245,158,11,.3)}
    .tag-med {background:rgba(23,99,182,.15); color:#60a5fa;border:1px solid rgba(23,99,182,.3)}

    /* ── MOBILE ───────────────────────────────── */
    @media(max-width:700px){
      body{overflow:auto}
      .app{flex-direction:column;overflow:visible;height:auto}
      .left{width:100%;height:auto;overflow:visible;border-right:none;border-bottom:1px solid var(--bd)}
      .right{overflow:visible;height:auto}
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav class="nav">
  <a class="nav-logo" href="/"><span class="logo-dot"></span>SkipTheLatte</a>
  <div class="nav-links">
    <a href="/" class="nav-a">Calculator</a>
    <a href="/freedom" class="nav-a active">Freedom Planner</a>
    <a href="/faq" class="nav-a">FAQ</a>
  </div>
  <div class="nav-btc">
    <span class="live-dot"></span>
    <span id="nav-btc">Loading...</span>
  </div>
</nav>

<div class="app">

  <!-- ════ LEFT PANEL ════ -->
  <aside class="left">

    <!-- YOUR NUMBERS -->
    <div class="l-section">
      <div class="l-label">Your Numbers</div>

      <div class="l-field">
        <label>Bitcoin Stack (BTC)</label>
        <div class="l-irow">
          <span class="l-pre" style="font-size:14px">₿</span>
          <input type="number" id="btc-stack" value="0.1" min="0" step="any" placeholder="0.00" oninput="onAnyChange()"/>
        </div>
        <div class="l-hint" id="stack-usd">≈ $0 USD</div>
      </div>

      <div class="l-field">
        <label>Monthly DCA ($)</label>
        <div class="l-irow">
          <span class="l-pre">$</span>
          <input type="number" id="monthly-dca" value="200" min="0" step="any" placeholder="200" oninput="onAnyChange()"/>
        </div>
      </div>

      <div class="l-field" style="margin-bottom:0">
        <label>Monthly Expenses ($)</label>
        <div class="l-irow">
          <span class="l-pre">$</span>
          <input type="number" id="monthly-exp" value="3000" min="0" step="any" placeholder="3000" oninput="onAnyChange()"/>
        </div>
      </div>
    </div>

    <!-- CAGR -->
    <div class="l-section">
      <div class="l-label">Annual Growth Rate (CAGR)</div>

      <div class="cagr-btns">
        <button class="cagr-btn" data-sc="bear"   onclick="setScenario('bear')">Bear<br><span style="font-size:10px;font-weight:400">15%</span></button>
        <button class="cagr-btn on" data-sc="base" onclick="setScenario('base')">Base<br><span style="font-size:10px;font-weight:400">21%</span></button>
        <button class="cagr-btn" data-sc="bull"   onclick="setScenario('bull')">Bull<br><span style="font-size:10px;font-weight:400">35%</span></button>
        <button class="cagr-btn" data-sc="custom" onclick="setScenario('custom')">Custom<br><span style="font-size:10px;font-weight:400" id="custom-pct">—%</span></button>
      </div>

      <input type="range" id="cagr-slider" class="l-slider" min="5" max="60" value="21" oninput="onCagrSlide(this)"/>
      <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--text3);margin-bottom:4px"><span>5%</span><span>60%</span></div>

      <div class="cagr-info-box">
        <div class="cagr-info-main" id="cagr-main-txt">Base CAGR 21%/yr · monthly: 1.6%</div>
        <div class="cagr-info-sub" id="cagr-sub-txt">Conservative long-term Bitcoin estimate</div>
      </div>
    </div>

    <!-- BTC PRICE -->
    <div class="l-section">
      <div class="l-label">BTC Current Price</div>
      <div class="btc-price-box">
        <div>
          <div class="btc-price-val" id="btc-price-val">$—</div>
          <div style="font-size:10px;color:var(--text3);margin-top:2px">via CoinGecko</div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
          <span class="btc-price-change" id="btc-change-val">—</span>
          <button class="btn-tiny-refresh" id="refresh-btn" onclick="fetchPrice(true)">↻</button>
        </div>
      </div>
    </div>

    <!-- FREEDOM TARGET YEAR -->
    <div class="l-section">
      <div class="l-label">Freedom Target Year</div>
      <div class="target-hint">I want to be free by...</div>
      <input type="number" id="target-year" class="target-input"
        placeholder="e.g., 2035" min="2025" max="2065"
        oninput="onAnyChange()"/>
      <div class="l-hint" id="target-hint" style="margin-top:5px"></div>
    </div>

  </aside>

  <!-- ════ RIGHT PANEL ════ -->
  <div class="right">

    <div class="r-header">
      <span class="r-header-left">Projections based on growth rate:</span>
      <span class="r-header-right" id="r-cagr-header">CAGR 21%/yr · 1.6%/mo compounding</span>
    </div>

    <!-- MILESTONE CARDS -->
    <div class="milestones" id="milestones-list">
      <!-- populated by JS -->
    </div>

    <!-- RECOMMENDATIONS -->
    <div class="recs-section">
      <div class="recs-header">Plan Recommendations</div>
      <div class="rec-cards" id="rec-cards">
        <!-- populated by JS -->
      </div>
    </div>

  </div>

</div><!-- /app -->

<script is:inline>
// ═══════════════════════════════════════════════
//  State
// ═══════════════════════════════════════════════
let btcPriceNow = 0;
let btcChange24 = 0;

const SCENARIOS = {
  bear:   { cagr: 15, label: 'Bear Case',   sub: 'Conservative downside scenario' },
  base:   { cagr: 21, label: 'Base Case',   sub: 'Conservative long-term Bitcoin estimate' },
  bull:   { cagr: 35, label: 'Bull Case',   sub: 'Strong adoption growth scenario' },
  custom: { cagr: 21, label: 'Custom',      sub: 'Your own growth assumption' },
};
let activeScenario = 'base';

// Milestone definitions
const MS_DEFS = [
  { id:'m3mo',  name:'3 Months Free',          sub:'Your first taste of breathing room',                    icon:'🌱', color:'#05b26b', targetFn: (mo)=> mo*3           },
  { id:'m6mo',  name:'6 Months Runway',         sub:'Half a year — no financial pressure',                   icon:'🌊', color:'#0891b2', targetFn: (mo)=> mo*6           },
  { id:'m1yr',  name:'1 Year of Freedom',       sub:'12 months of living expenses in your stack',            icon:'⚡', color:'#1763B6', targetFn: (mo)=> mo*12          },
  { id:'m5yr',  name:'5-Year Sovereignty',      sub:'Half a decade — no employer can touch you',             icon:'🚀', color:'#7c3aed', targetFn: (mo)=> mo*60          },
  { id:'fire',  name:'FIRE Number',             sub:'25× annual expenses — retirement threshold',            icon:'🔥', color:'#f59e0b', targetFn: (mo)=> mo*12*25       },
  { id:'m1m',   name:'$1M Stack',               sub:'Seven figures in hard money',                           icon:'💎', color:'#e2b714', targetFn: ()  => 1_000_000      },
  { id:'nsta',  name:'Never Sell Time Again',   sub:'Appreciation alone covers your lifestyle — forever',   icon:'♾️', color:'#ef4444', targetFn: (mo)=> mo*12*50       },
  { id:'gw',    name:'Generational Wealth 💰',  sub:'Your annual expenses — a legacy that outlasts you',    icon:'👑', color:'#c2410c', targetFn: (mo)=> mo*12*100      },
];

// ═══════════════════════════════════════════════
//  Formatters
// ═══════════════════════════════════════════════
function fmtUSD(n) {
  if (!n && n !== 0) return '—';
  if (n >= 1e9)  return '$' + (n/1e9).toFixed(2)  + 'B';
  if (n >= 1e6)  return '$' + (n/1e6).toFixed(2)  + 'M';
  if (n >= 1e3)  return '$' + (n/1e3).toFixed(1)  + 'K';
  return '$' + n.toFixed(0);
}
function fmtUSDfull(n) {
  if (!n && n !== 0) return '—';
  return '$' + n.toLocaleString('en-US', { maximumFractionDigits: 0 });
}
function fmtBTC(n) {
  if (n == null) return '—';
  return n.toFixed(4) + ' BTC';
}
function fmtDate(d) {
  if (!d) return '—';
  return d.toLocaleString('en-US', { month:'short', year:'numeric' });
}
function fmtYears(y) {
  if (y == null) return '—';
  if (y < 0.1) return '< 0.1 yrs';
  return 'In ' + y.toFixed(1) + ' yrs';
}

// ═══════════════════════════════════════════════
//  Price fetch
// ═══════════════════════════════════════════════
async function fetchPrice(manual = false) {
  const rb = document.getElementById('refresh-btn');
  if (rb) rb.classList.add('spin');
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 9000);
  try {
    const r = await fetch(
      'https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_change=true',
      { signal: ctrl.signal }
    );
    clearTimeout(timer);
    if (!r.ok) throw new Error();
    const d = await r.json();
    btcPriceNow  = d.bitcoin.usd;
    btcChange24  = d.bitcoin.usd_24h_change ?? 0;
    updatePriceDisplay();
    onAnyChange();
  } catch(e) {
    clearTimeout(timer);
    console.warn('fetchPrice failed');
  } finally {
    if (rb) rb.classList.remove('spin');
  }
}

function updatePriceDisplay() {
  const pv = document.getElementById('btc-price-val');
  const ch = document.getElementById('btc-change-val');
  const nb = document.getElementById('nav-btc');
  if (pv) pv.textContent = '$' + btcPriceNow.toLocaleString('en-US');
  if (ch) {
    ch.textContent = (btcChange24 >= 0 ? '▲ +' : '▼ ') + Math.abs(btcChange24).toFixed(2) + '%';
    ch.style.color = btcChange24 >= 0 ? '#05b26b' : '#f04452';
  }
  if (nb) {
    nb.textContent = '$' + btcPriceNow.toLocaleString('en-US') + ' ' +
      (btcChange24 >= 0 ? '▲' : '▼') + ' ' + Math.abs(btcChange24).toFixed(2) + '%';
  }
}

// ═══════════════════════════════════════════════
//  CAGR controls
// ═══════════════════════════════════════════════
function setPct(el) {
  const pct = ((el.value - el.min) / (el.max - el.min) * 100).toFixed(1) + '%';
  el.style.setProperty('--pct', pct);
}

function setScenario(sc) {
  activeScenario = sc;
  const s = SCENARIOS[sc];
  const sl = document.getElementById('cagr-slider');
  if (sc !== 'custom') { sl.value = s.cagr; setPct(sl); }
  updateCagrDisplay();
  document.querySelectorAll('.cagr-btn').forEach(b => b.classList.toggle('on', b.dataset.sc === sc));
  onAnyChange();
}

function onCagrSlide(el) {
  setPct(el);
  activeScenario = 'custom';
  document.querySelectorAll('.cagr-btn').forEach(b => b.classList.toggle('on', b.dataset.sc === 'custom'));
  SCENARIOS.custom.cagr = parseInt(el.value);
  document.getElementById('custom-pct').textContent = el.value + '%';
  updateCagrDisplay();
  onAnyChange();
}

function updateCagrDisplay() {
  const cagr = getCagr();
  const monthly = (Math.pow(1 + cagr/100, 1/12) - 1) * 100;
  document.getElementById('cagr-main-txt').textContent =
    (activeScenario === 'custom' ? 'Custom' : SCENARIOS[activeScenario].label) +
    ' CAGR ' + cagr + '%/yr · monthly: ' + monthly.toFixed(1) + '%';
  document.getElementById('cagr-sub-txt').textContent = SCENARIOS[activeScenario]?.sub ?? 'Custom growth assumption';
  document.getElementById('r-cagr-header').textContent =
    'CAGR ' + cagr + '%/yr · ' + monthly.toFixed(1) + '%/mo compounding';
  document.getElementById('custom-pct').textContent = cagr + '%';
}

function getCagr() {
  return parseInt(document.getElementById('cagr-slider').value) || 21;
}

// ═══════════════════════════════════════════════
//  Core simulation
// ═══════════════════════════════════════════════
function simulate(stackBTC, dca, expenses, price, cagrPct) {
  if (!price) return null;
  const mGrowth = Math.pow(1 + cagrPct/100, 1/12);
  const targets = MS_DEFS.map(m => ({ ...m, target: m.targetFn(expenses), achieved: false, date: null, yearsAway: null, portVal: null, btcAmt: null }));

  let stack = stackBTC, p = price;
  const now = new Date();
  const currentPort = stack * p;

  // Mark already achieved
  targets.forEach(t => {
    if (currentPort >= t.target) {
      t.achieved = true;
      t.date = new Date();
      t.yearsAway = 0;
      t.portVal = currentPort;
      t.btcAmt = stack;
      t.priceAtMs = p;
    }
  });

  // Simulate forward
  const pending = targets.filter(t => !t.achieved);
  for (let mo = 1; mo <= 480 && pending.length > 0; mo++) {
    stack += dca / p;
    p *= mGrowth;
    const port = stack * p;
    const d = new Date(now.getFullYear(), now.getMonth() + mo, 1);
    for (let i = pending.length - 1; i >= 0; i--) {
      if (port >= pending[i].target) {
        pending[i].date = d;
        pending[i].yearsAway = mo / 12;
        pending[i].portVal = port;
        pending[i].btcAmt = stack;
        pending[i].priceAtMs = p;
        pending.splice(i, 1);
      }
    }
  }

  return targets;
}

// ═══════════════════════════════════════════════
//  Render milestones
// ═══════════════════════════════════════════════
function renderMilestones(results) {
  if (!results) return;
  const container = document.getElementById('milestones-list');
  container.innerHTML = '';

  results.forEach(m => {
    const currentPort = parseFloat(document.getElementById('btc-stack').value || 0) * btcPriceNow;
    const progress = m.target > 0 ? Math.min(100, (currentPort / m.target) * 100) : 0;

    const card = document.createElement('div');
    card.className = 'ms-card' + (m.achieved ? ' achieved' : '');

    const dateStr  = m.date ? fmtDate(m.date) : '> 40 yrs';
    const timeStr  = m.achieved && m.yearsAway === 0 ? 'Now ✓' : fmtYears(m.yearsAway);
    const valueStr = m.portVal ? fmtUSD(m.portVal) : 'Beyond 40yr';
    const targetStr = fmtUSD(m.target);

    card.innerHTML = `
      <div class="ms-top">
        <div class="ms-left-block">
          <div class="ms-icon-wrap" style="background:${m.color}1a;border:1px solid ${m.color}33">
            ${m.icon}
          </div>
          <div class="ms-text">
            <div class="ms-name">${m.name}</div>
            <div class="ms-sub">${m.sub}</div>
          </div>
        </div>
        <div class="ms-right-block">
          <div class="ms-date-badge">${dateStr}</div>
          <div class="ms-time">${timeStr}</div>
          <div class="ms-values">${fmtUSD(currentPort)} / ${targetStr}</div>
        </div>
      </div>
      <div class="ms-bar-wrap">
        <div class="ms-bar" style="width:${progress}%;background:${m.color}"></div>
      </div>
    `;
    container.appendChild(card);
  });
}

// ═══════════════════════════════════════════════
//  Render recommendations
// ═══════════════════════════════════════════════
function renderRecs(stackBTC, dca, expenses, price, cagrPct, results) {
  const container = document.getElementById('rec-cards');
  container.innerHTML = '';
  const recs = [];
  const cagr = cagrPct;
  const monthlyToAnnualExp = expenses;
  const dcaRatio = monthlyToAnnualExp > 0 ? (dca / monthlyToAnnualExp) * 100 : 0;
  const fireMs = results?.find(m => m.id === 'fire');
  const fireYears = fireMs?.yearsAway;
  const targetYearVal = parseInt(document.getElementById('target-year').value);
  const currentYear = new Date().getFullYear();

  // Rec 1: DCA vs expenses ratio
  if (dcaRatio < 10 && monthlyToAnnualExp > 0) {
    const suggested = Math.round(monthlyToAnnualExp * 0.1);
    recs.push({
      icon: '⚠️',
      title: `You're only stacking ${dcaRatio.toFixed(1)}% of your spending — that's below escape velocity`,
      body: `Stackers who reach sovereignty typically put 10-20% of their budget into Bitcoin. Right now you're putting $${dca} against $${monthlyToAnnualExp}/mo of expenses. Raising to $${suggested}/mo would lift your rate to 10% and compress every single milestone on your timeline.`,
      tag: 'High Impact', tagClass: 'tag-high',
    });
  }

  // Rec 2: Expense reduction
  if (monthlyToAnnualExp > 2000) {
    const cut = Math.round(monthlyToAnnualExp * 0.1 / 50) * 50;
    const fireTarget = monthlyToAnnualExp * 12 * 25;
    const newFireTarget = (monthlyToAnnualExp - cut) * 12 * 25;
    const saving = fireTarget - newFireTarget;
    recs.push({
      icon: '✂️',
      title: `Cut $${cut}/mo → your FIRE target drops by ${fmtUSD(saving)}`,
      body: `Going from $${monthlyToAnnualExp} to $${monthlyToAnnualExp - cut}/mo in expenses shrinks your FIRE number from ${fmtUSD(fireTarget)} to ${fmtUSD(newFireTarget)} — and hits your FIRE number months earlier. Every dollar you stop spending is worth 25× in freedom.`,
      tag: 'High Impact', tagClass: 'tag-high',
    });
  }

  // Rec 3: On-track vs target year
  if (targetYearVal && fireMs?.date) {
    const projectedYear = fireMs.date.getFullYear();
    const diff = projectedYear - targetYearVal;
    if (diff > 2) {
      const needed = (Math.pow(1 + cagr/100, fireYears) - 1) * dca * 12 / fireYears / 12;
      recs.push({
        icon: '🎯',
        title: `You're projected to be free ${diff} years after your ${targetYearVal} target`,
        body: `Current trajectory reaches FIRE in ${projectedYear}. To hit ${targetYearVal}, you'd need to significantly increase DCA or reduce expenses. Try switching to the Bull scenario to see the impact.`,
        tag: 'Medium Impact', tagClass: 'tag-med',
      });
    } else if (diff <= 0) {
      recs.push({
        icon: '✅',
        title: `You're on track to hit freedom before your ${targetYearVal} target!`,
        body: `Projected FIRE date is ${fmtDate(fireMs.date)} — ${Math.abs(diff)} year${Math.abs(diff) !== 1 ? 's' : ''} ahead of schedule. Keep stacking.`,
        tag: 'On Track', tagClass: 'tag-med',
      });
    }
  }

  // Rec 4: CAGR upgrade
  if (cagr < 35 && fireYears && fireYears > 5) {
    const { simulate: sim2 } = { simulate };
    const bullResults = simulate(stackBTC, dca, expenses, price, 35);
    const bullFire = bullResults?.find(m => m.id === 'fire');
    if (bullFire?.yearsAway && fireYears) {
      const saved = (fireYears - bullFire.yearsAway).toFixed(1);
      if (parseFloat(saved) > 0.5) {
        recs.push({
          icon: '🐂',
          title: `Bull scenario (35% CAGR) shaves ${saved} years off your timeline`,
          body: `If Bitcoin achieves its historical adoption growth rate, you'd hit FIRE in ${bullFire.yearsAway.toFixed(1)} years instead of ${fireYears.toFixed(1)}. The difference between Base and Bull is roughly a Bitcoin halving cycle of outperformance.`,
          tag: 'Medium Impact', tagClass: 'tag-med',
        });
      }
    }
  }

  recs.slice(0, 3).forEach(r => {
    const el = document.createElement('div');
    el.className = 'rec-card';
    el.innerHTML = `
      <div class="rec-card-top">
        <div class="rec-icon">${r.icon}</div>
        <div class="rec-title">${r.title}</div>
      </div>
      <div class="rec-body">${r.body}</div>
      <span class="rec-tag ${r.tagClass}">${r.tag}</span>
    `;
    container.appendChild(el);
  });

  if (recs.length === 0) {
    container.innerHTML = '<div style="font-size:13px;color:var(--text3);padding:8px 0">Keep stacking — looking good! 🟠</div>';
  }
}

// ═══════════════════════════════════════════════
//  Main update
// ═══════════════════════════════════════════════
function onAnyChange() {
  const stackBTC = parseFloat(document.getElementById('btc-stack').value) || 0;
  const dca      = parseFloat(document.getElementById('monthly-dca').value) || 0;
  const expenses = parseFloat(document.getElementById('monthly-exp').value) || 0;
  const cagr     = getCagr();
  const price    = btcPriceNow || 0;

  // Stack USD value hint
  const stackUSD = stackBTC * price;
  const el = document.getElementById('stack-usd');
  if (el) el.textContent = price ? '≈ ' + fmtUSDfull(stackUSD) + ' USD' : '≈ $— USD';

  // Target year hint
  const targetYearVal = parseInt(document.getElementById('target-year').value);
  const targetHint = document.getElementById('target-hint');
  if (targetHint && targetYearVal) {
    const yearsLeft = targetYearVal - new Date().getFullYear();
    targetHint.textContent = yearsLeft > 0 ? yearsLeft + ' years from now' : yearsLeft === 0 ? 'This year' : 'In the past';
  }

  // Simulate
  if (price <= 0) return;
  const results = simulate(stackBTC, dca, expenses, price, cagr);
  renderMilestones(results);
  renderRecs(stackBTC, dca, expenses, price, cagr, results);
}

// ═══════════════════════════════════════════════
//  Init
// ═══════════════════════════════════════════════
const sl = document.getElementById('cagr-slider');
setPct(sl);
updateCagrDisplay();
fetchPrice();
setInterval(() => fetchPrice(), 60000);
</script>

