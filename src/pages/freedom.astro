<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="description" content="SkipTheLatte — Bitcoin Sovereignty Timeline. Calculate your path to financial freedom."/>
  <title>Freedom Planner — SkipTheLatte</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:    #0a0a0a;
      --panel: #0f0f0f;
      --surf:  #141414;
      --surf2: #1c1c1c;
      --surf3: #242424;
      --bd:    rgba(255,255,255,.06);
      --bd2:   rgba(255,255,255,.1);
      --bd3:   rgba(255,255,255,.16);
      --blue:  #1763B6;
      --green: #22c55e;
      --red:   #ef4444;
      --amber: #f59e0b;
      --cyan:  #06b6d4;
      --purple:#8b5cf6;
      --rose:  #f43f5e;
      --text:  #f2f2f2;
      --t2:    #909090;
      --t3:    #555;
      --t4:    #333;
      --nav:   52px;
      --sw:    290px;
      --font: 'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    }
    html{font-family:var(--font);background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
    body{height:100vh;display:flex;flex-direction:column;overflow:hidden}
    button{font-family:inherit;cursor:pointer}
    input{font-family:inherit}
    a{text-decoration:none}

    /* ══ NAV ══════════════════════════════════ */
    .nav{
      flex-shrink:0;height:var(--nav);
      background:var(--panel);border-bottom:1px solid var(--bd);
      display:flex;align-items:center;justify-content:space-between;padding:0 18px;
    }
    .nav-brand{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:800;color:var(--text);letter-spacing:-.02em}
    .brand-dot{width:7px;height:7px;border-radius:50%;background:var(--blue)}
    .nav-links{display:flex;gap:1px}
    .nl{padding:4px 11px;font-size:12px;font-weight:500;color:var(--t2);border-radius:6px;transition:all .12s}
    .nl:hover{color:var(--text);background:var(--surf)}
    .nl.on{color:var(--blue);background:rgba(23,99,182,.12)}
    .nav-r{display:flex;align-items:center;gap:10px}
    .live-tag{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--t2)}
    .ldot{width:5px;height:5px;border-radius:50%;background:var(--green);animation:blink 2s ease-in-out infinite}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

    /* ══ APP ══════════════════════════════════ */
    .app{flex:1;display:flex;min-height:0;overflow:hidden}

    /* ══ SIDEBAR ══════════════════════════════ */
    .sb{
      width:var(--sw);flex-shrink:0;
      background:var(--panel);border-right:1px solid var(--bd);
      overflow-y:auto;display:flex;flex-direction:column;
    }
    .sb::-webkit-scrollbar{width:3px}
    .sb::-webkit-scrollbar-thumb{background:var(--surf3);border-radius:2px}

    /* section block */
    .sb-blk{padding:14px 15px;border-bottom:1px solid var(--bd)}
    .sb-blk:last-child{border-bottom:none}
    .blk-title{
      font-size:9px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
      color:var(--t3);margin-bottom:11px;
    }

    /* inputs */
    .inp-grp{display:flex;flex-direction:column;gap:4px;margin-bottom:9px}
    .inp-grp:last-child{margin-bottom:0}
    .inp-grp label{font-size:9px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--t3)}
    .inp-row{position:relative}
    .inp-pre{
      position:absolute;left:10px;top:50%;transform:translateY(-50%);
      font-size:12px;font-weight:600;color:var(--t3);pointer-events:none;z-index:1;
    }
    .inp-row input{
      width:100%;background:var(--surf);border:1px solid var(--bd2);color:var(--text);
      padding:9px 10px 9px 26px;border-radius:8px;
      font-size:14px;font-weight:700;font-variant-numeric:tabular-nums;
      transition:border-color .15s;-moz-appearance:textfield;
    }
    .inp-row input::-webkit-inner-spin-button,.inp-row input::-webkit-outer-spin-button{-webkit-appearance:none}
    .inp-row input:focus{outline:none;border-color:rgba(255,255,255,.25);background:var(--surf2)}
    .inp-row input::placeholder{color:var(--t4);font-weight:400;font-size:13px}
    .inp-hint{font-size:11px;color:var(--t3);margin-top:3px;font-variant-numeric:tabular-nums}

    /* CAGR buttons */
    .cagr-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:9px}
    .cg{
      padding:8px 6px;border-radius:8px;font-size:11px;font-weight:700;
      text-align:center;line-height:1.4;
      background:var(--surf);border:1px solid var(--bd2);color:var(--t2);
      transition:all .12s;display:flex;flex-direction:column;gap:0;
    }
    .cg-sub{font-size:9px;font-weight:500;opacity:.65;margin-top:1px}
    .cg:hover{border-color:var(--bd3);color:var(--text)}
    .cg.on[data-sc="bear"] {background:rgba(239,68,68,.12) ;border-color:rgba(239,68,68,.4) ;color:var(--red)}
    .cg.on[data-sc="base"] {background:rgba(245,158,11,.12);border-color:rgba(245,158,11,.4);color:var(--amber)}
    .cg.on[data-sc="bull"] {background:rgba(34,197,94,.12) ;border-color:rgba(34,197,94,.4) ;color:var(--green)}
    .cg.on[data-sc="custom"]{background:rgba(139,92,246,.12);border-color:rgba(139,92,246,.4);color:var(--purple)}

    /* CAGR slider */
    .cagr-sl{
      -webkit-appearance:none;width:100%;height:3px;border-radius:2px;outline:none;cursor:pointer;
      background:linear-gradient(to right,var(--amber) 0%,var(--amber) var(--pct,30%),var(--surf3) var(--pct,30%),var(--surf3) 100%);
      margin:7px 0 3px;
    }
    .cagr-sl::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--amber);border:2px solid var(--panel);cursor:pointer;box-shadow:0 0 0 3px rgba(245,158,11,.2)}
    .cagr-sl::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:var(--amber);border:2px solid var(--panel);cursor:pointer}
    .cagr-mm{display:flex;justify-content:space-between;font-size:9px;color:var(--t4)}

    /* CAGR info box */
    .cagr-box{
      background:var(--surf);border:1px solid var(--bd);border-radius:8px;
      padding:9px 11px;margin-top:8px;
    }
    .cagr-box-main{font-size:12px;font-weight:700;color:var(--text)}
    .cagr-box-sub{font-size:10px;color:var(--t3);margin-top:2px}
    .cagr-box-hist{
      display:flex;gap:8px;margin-top:7px;padding-top:7px;
      border-top:1px solid var(--bd);
    }
    .hist-item{display:flex;flex-direction:column;gap:1px;flex:1}
    .hist-item label{font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:var(--t4)}
    .hist-item span{font-size:11px;font-weight:700;font-variant-numeric:tabular-nums}

    /* BTC price box */
    .price-box{
      background:var(--surf);border:1px solid var(--bd2);border-radius:8px;
      padding:10px 12px;display:flex;align-items:center;justify-content:space-between;
    }
    .price-num{font-size:18px;font-weight:800;color:var(--text);font-variant-numeric:tabular-nums}
    .price-label{font-size:9px;color:var(--t3);margin-top:1px;text-transform:uppercase;letter-spacing:.06em}
    .price-chg{font-size:11px;font-weight:700;font-variant-numeric:tabular-nums}
    .price-r{display:flex;flex-direction:column;align-items:flex-end;gap:5px}
    .btn-ref{
      background:transparent;border:1px solid var(--bd2);border-radius:5px;
      color:var(--t3);padding:3px 7px;font-size:13px;transition:all .12s;
    }
    .btn-ref:hover{color:var(--text);border-color:var(--bd3)}
    .btn-ref.sp{animation:spin .6s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}

    /* Sovereignty score */
    .sov-box{
      background:var(--surf);border:1px solid var(--bd);border-radius:8px;padding:10px 12px;
    }
    .sov-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px}
    .sov-label{font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--t3)}
    .sov-score{font-size:18px;font-weight:800;color:var(--text);font-variant-numeric:tabular-nums}
    .sov-bar-bg{height:4px;background:var(--surf3);border-radius:2px;overflow:hidden;margin-bottom:6px}
    .sov-bar{height:100%;border-radius:2px;transition:width .4s ease,background .4s}
    .sov-status{font-size:11px;color:var(--t3)}
    .ms-count{
      margin-top:7px;padding-top:7px;border-top:1px solid var(--bd);
      font-size:11px;color:var(--t3);display:flex;align-items:center;justify-content:space-between;
    }
    .ms-count-val{font-size:13px;font-weight:700;color:var(--text)}

    /* Target year */
    .target-lbl{font-size:9px;color:var(--t3);margin-bottom:5px;text-transform:uppercase;letter-spacing:.08em}
    .target-inp{
      width:100%;background:var(--surf);border:1px solid var(--bd2);color:var(--text);
      padding:9px 12px;border-radius:8px;font-size:14px;font-weight:700;
      transition:border-color .15s;-moz-appearance:textfield;
    }
    .target-inp::-webkit-inner-spin-button,.target-inp::-webkit-outer-spin-button{-webkit-appearance:none}
    .target-inp:focus{outline:none;border-color:rgba(255,255,255,.25);background:var(--surf2)}
    .target-inp::placeholder{color:var(--t4);font-weight:400;font-size:13px}
    .target-hint{font-size:10px;color:var(--t3);margin-top:4px}

    /* ══ MAIN ═════════════════════════════════ */
    .main{flex:1;min-width:0;overflow-y:auto;display:flex;flex-direction:column;background:var(--bg)}
    .main::-webkit-scrollbar{width:4px}
    .main::-webkit-scrollbar-thumb{background:var(--surf3);border-radius:2px}

    /* Projection header */
    .proj-hdr{
      flex-shrink:0;padding:10px 18px;border-bottom:1px solid var(--bd);
      display:flex;align-items:center;justify-content:space-between;
      background:rgba(255,255,255,.01);
    }
    .proj-hdr-l{font-size:11px;color:var(--t3)}
    .proj-hdr-r{font-size:12px;font-weight:700;color:var(--amber)}

    /* ══ MILESTONE CARDS ══════════════════════ */
    .ms-list{display:flex;flex-direction:column}

    .ms-card{
      display:flex;align-items:stretch;
      border-bottom:1px solid var(--bd);
      transition:background .12s;
    }
    .ms-card:last-child{border-bottom:none}
    .ms-card:hover{background:rgba(255,255,255,.02)}
    .ms-card.achieved{background:rgba(34,197,94,.025)}
    .ms-card.achieved:hover{background:rgba(34,197,94,.05)}

    /* Left color bar */
    .ms-bar-l{width:4px;flex-shrink:0;border-radius:0}

    /* Card content */
    .ms-content{flex:1;padding:13px 16px;min-width:0;display:flex;flex-direction:column;gap:9px}

    /* Row 1: icon+text | date */
    .ms-r1{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
    .ms-left{display:flex;align-items:flex-start;gap:10px;flex:1;min-width:0}
    .ms-emoji{font-size:18px;line-height:1.4;flex-shrink:0}
    .ms-txt .ms-name{font-size:13px;font-weight:700;color:var(--text);line-height:1.3}
    .ms-txt .ms-desc{font-size:11px;color:var(--t3);margin-top:2px;line-height:1.4}
    .ms-card.achieved .ms-txt .ms-desc{color:rgba(34,197,94,.6)}

    .ms-right{display:flex;flex-direction:column;align-items:flex-end;gap:3px;flex-shrink:0}
    .ms-date{
      padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700;
      background:var(--surf);border:1px solid var(--bd2);color:var(--t2);
      font-variant-numeric:tabular-nums;white-space:nowrap;
    }
    .ms-card.achieved .ms-date{background:rgba(34,197,94,.1);border-color:rgba(34,197,94,.25);color:var(--green)}
    .ms-time{font-size:10px;color:var(--t3);font-variant-numeric:tabular-nums}

    /* Row 2: values + progress bar */
    .ms-r2{display:flex;flex-direction:column;gap:5px}
    .ms-vals{display:flex;align-items:center;justify-content:space-between}
    .ms-val-l{font-size:11px;color:var(--t3);font-variant-numeric:tabular-nums}
    .ms-val-r{font-size:11px;font-weight:700;font-variant-numeric:tabular-nums}
    .ms-prog-bg{height:2px;background:var(--surf3);border-radius:1px;overflow:hidden}
    .ms-prog{height:100%;border-radius:1px;transition:width .4s ease}

    /* ══ RECOMMENDATIONS ══════════════════════ */
    .recs{padding:14px 18px;border-top:1px solid var(--bd)}
    .recs-hdr{
      font-size:9px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
      color:var(--t3);margin-bottom:10px;display:flex;align-items:center;gap:8px;
    }
    .recs-hdr::before{content:'■';font-size:7px}
    .recs-list{display:flex;flex-direction:column;gap:7px}
    .rec{background:var(--panel);border:1px solid var(--bd);border-radius:9px;padding:12px 14px}
    .rec-top{display:flex;align-items:flex-start;gap:9px;margin-bottom:5px}
    .rec-ic{font-size:14px;flex-shrink:0;margin-top:1px}
    .rec-ttl{font-size:12px;font-weight:700;color:var(--text);line-height:1.4}
    .rec-body{font-size:11px;color:var(--t2);line-height:1.6;margin-bottom:7px;padding-left:23px}
    .tag{display:inline-flex;align-items:center;padding:2px 7px;border-radius:4px;font-size:9px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
    .tag-hi{background:rgba(245,158,11,.1);color:var(--amber);border:1px solid rgba(245,158,11,.2)}
    .tag-md{background:rgba(23,99,182,.1);color:#60a5fa;border:1px solid rgba(23,99,182,.2)}
    .tag-ok{background:rgba(34,197,94,.1);color:var(--green);border:1px solid rgba(34,197,94,.2)}

    /* footer note */
    .footer-note{padding:12px 18px;border-top:1px solid var(--bd);font-size:10px;color:var(--t4);line-height:1.5}

    @media(max-width:700px){
      body{overflow:auto;height:auto}
      .app{flex-direction:column;overflow:visible;height:auto}
      .sb{width:100%;height:auto;overflow:visible;border-right:none;border-bottom:1px solid var(--bd)}
      .main{overflow:visible;height:auto}
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav class="nav">
  <a class="nav-brand" href="/"><span class="brand-dot"></span>SkipTheLatte</a>
  <div class="nav-links">
    <a href="/" class="nl">Calculator</a>
    <a href="/freedom" class="nl on">Freedom Planner</a>
    <a href="/faq" class="nl">FAQ</a>
  </div>
  <div class="nav-r">
    <div class="live-tag">
      <span class="ldot"></span>
      <span id="nav-price">Loading...</span>
    </div>
  </div>
</nav>

<div class="app">

  <!-- ════════ SIDEBAR ════════ -->
  <aside class="sb">

    <!-- YOUR NUMBERS -->
    <div class="sb-blk">
      <div class="blk-title">Your Numbers</div>

      <div class="inp-grp">
        <label>Bitcoin Stack (BTC)</label>
        <div class="inp-row">
          <span class="inp-pre" style="font-size:13px;font-weight:800">₿</span>
          <input type="number" id="btc-stack" value="0.1" min="0" step="any" placeholder="0.00" oninput="go()"/>
        </div>
        <div class="inp-hint" id="stack-hint">≈ $— USD</div>
      </div>

      <div class="inp-grp">
        <label>Monthly DCA ($)</label>
        <div class="inp-row">
          <span class="inp-pre">$</span>
          <input type="number" id="monthly-dca" value="200" min="0" step="any" placeholder="200" oninput="go()"/>
        </div>
      </div>

      <div class="inp-grp" style="margin-bottom:0">
        <label>Monthly Expenses ($)</label>
        <div class="inp-row">
          <span class="inp-pre">$</span>
          <input type="number" id="monthly-exp" value="3000" min="0" step="any" placeholder="3000" oninput="go()"/>
        </div>
      </div>
    </div>

    <!-- CAGR -->
    <div class="sb-blk">
      <div class="blk-title">Annual Growth Rate (CAGR)</div>

      <div class="cagr-grid">
        <button class="cg" data-sc="bear" onclick="setSc('bear')">
          Bear<span class="cg-sub">20%/yr</span>
        </button>
        <button class="cg on" data-sc="base" onclick="setSc('base')">
          Base<span class="cg-sub">55%/yr</span>
        </button>
        <button class="cg" data-sc="bull" onclick="setSc('bull')">
          Bull<span class="cg-sub">110%/yr</span>
        </button>
        <button class="cg" data-sc="custom" onclick="setSc('custom')">
          Custom<span class="cg-sub" id="cust-pct">—%</span>
        </button>
      </div>

      <input type="range" id="cagr-sl" class="cagr-sl" min="5" max="150" value="55" oninput="onSlide(this)"/>
      <div class="cagr-mm"><span>5%</span><span>150%</span></div>

      <div class="cagr-box">
        <div class="cagr-box-main" id="cagr-main">Base CAGR 55%/yr · monthly: 3.7%</div>
        <div class="cagr-box-sub"  id="cagr-sub">4-year historical Bitcoin average</div>
        <div class="cagr-box-hist">
          <div class="hist-item">
            <label>4yr CAGR</label>
            <span style="color:var(--amber)">~55%</span>
          </div>
          <div class="hist-item">
            <label>10yr CAGR</label>
            <span style="color:var(--green)">~80%</span>
          </div>
          <div class="hist-item">
            <label>Since 2009</label>
            <span style="color:var(--cyan)">~130%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- BTC PRICE -->
    <div class="sb-blk">
      <div class="blk-title">BTC Current Price</div>
      <div class="price-box">
        <div>
          <div class="price-num" id="btc-price-num">$—</div>
          <div class="price-label">via CoinGecko</div>
        </div>
        <div class="price-r">
          <span class="price-chg" id="btc-chg">—</span>
          <button class="btn-ref" id="ref-btn" onclick="fetchPrice(true)">↻</button>
        </div>
      </div>
    </div>

    <!-- SOVEREIGNTY SCORE -->
    <div class="sb-blk">
      <div class="blk-title">Sovereignty Score</div>
      <div class="sov-box">
        <div class="sov-row">
          <span class="sov-label">Score</span>
          <span class="sov-score" id="sov-score">0<span style="font-size:12px;font-weight:500;color:var(--t3)">/100</span></span>
        </div>
        <div class="sov-bar-bg">
          <div class="sov-bar" id="sov-bar" style="width:0%;background:var(--red)"></div>
        </div>
        <div class="sov-status" id="sov-status">Just getting started</div>
        <div class="ms-count">
          <span>Milestones Reached</span>
          <span class="ms-count-val" id="ms-count">0/8</span>
        </div>
      </div>
    </div>

    <!-- FREEDOM TARGET YEAR -->
    <div class="sb-blk">
      <div class="blk-title">Freedom Target Year</div>
      <div class="target-lbl">I want to be free by...</div>
      <input type="number" id="target-yr" class="target-inp" placeholder="e.g. 2035" min="2025" max="2075" oninput="go()"/>
      <div class="target-hint" id="target-hint"></div>
    </div>

  </aside>

  <!-- ════════ MAIN ════════ -->
  <div class="main">

    <!-- Header -->
    <div class="proj-hdr">
      <span class="proj-hdr-l">Projections based on growth rate:</span>
      <span class="proj-hdr-r" id="proj-cagr">CAGR 55%/yr · 3.7%/mo compounding</span>
    </div>

    <!-- Milestone list -->
    <div class="ms-list" id="ms-list"></div>

    <!-- Recommendations -->
    <div class="recs">
      <div class="recs-hdr">Plan Recommendations</div>
      <div class="recs-list" id="rec-list"></div>
    </div>

    <!-- Disclaimer -->
    <div class="footer-note">
      ⚠️ Simulation Only — Not Financial Advice. All projections assume consistent CAGR compounding with monthly DCA. Bitcoin is volatile; past performance does not guarantee future results. SkipTheLatte · Price data: CoinGecko
    </div>

  </div>

</div>

<script is:inline>
// ════════════════════════════════════════════
//  Config
// ════════════════════════════════════════════
let BTC = 0, chg24 = 0;

const SC = {
  bear:  { cagr:20,  color:'#ef4444', label:'Bear',   sub:'Conservative downside scenario'      },
  base:  { cagr:55,  color:'#f59e0b', label:'Base',   sub:'4-year historical Bitcoin average'   },
  bull:  { cagr:110, color:'#22c55e', label:'Bull',   sub:'Aggressive adoption growth scenario' },
  custom:{ cagr:55,  color:'#8b5cf6', label:'Custom', sub:'Your own growth assumption'          },
};
let activeSc = 'base';

// Milestone definitions — targets are functions of (monthly_exp, cagr)
const MS_DEF = [
  {
    id:'m3mo', emoji:'☕', name:'3 Months Free',
    desc:'Your first taste of breathing room',
    color:'#22c55e',
    target:(e)=> e * 3,
  },
