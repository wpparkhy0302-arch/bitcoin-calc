<script is:inline>
// ── Currency ──────────────────────────────────────────
const CURR = {
  usd:{sym:'$',   name:'USD',dec:2},
  krw:{sym:'₩',   name:'KRW',dec:0},
  jpy:{sym:'¥',   name:'JPY',dec:0},
  eur:{sym:'€',   name:'EUR',dec:2},
  gbp:{sym:'£',   name:'GBP',dec:2},
  cad:{sym:'C$',  name:'CAD',dec:2},
  aud:{sym:'A$',  name:'AUD',dec:2},
  sgd:{sym:'S$',  name:'SGD',dec:2},
  hkd:{sym:'HK$', name:'HKD',dec:2},
  aed:{sym:'د.إ', name:'AED',dec:2},
  inr:{sym:'₹',   name:'INR',dec:0},
};
let cur = 'usd', prices = {}, ratesExpiry = 0;
const RATES_TTL = 5 * 60 * 1000;

let btcPrice = 73000;
let currentCagr = 55;
let activeBtn = 'base';

const milestones = [
  { id:'m1', emoji:'☕',  title:'3 Months Free',         desc:'First taste of breathing room',                              multiplier:3/12,  color:'#1a7a4a' },
  { id:'m2', emoji:'🌊',  title:'6 Months Runway',        desc:'Half a year — no financial pressure',                        multiplier:6/12,  color:'#1763B6' },
  { id:'m3', emoji:'🦅',  title:'1 Year of Freedom',      desc:'12 months of expenses stored in your stack',                 multiplier:1,     color:'#8957e5' },
  { id:'m4', emoji:'⚡',  title:'5-Year Sovereignty',     desc:'5 years — no employer can touch you',                        multiplier:5,     color:'#e3a228' },
  { id:'m5', emoji:'🎯',  title:'FIRE Number',             desc:'Annual expenses x25 — retirement threshold',                 multiplier:25,    color:'#d73a49', fireBased:true },
  { id:'m6', emoji:'💎',  title:'$1M Stack',               desc:'7-figure hard money',                                        target:1000000,   fixedTarget:true, color:'#1763B6' },
  { id:'m7', emoji:'∞',   title:'Never Sell Time Again',   desc:'Appreciation alone covers your lifestyle — forever',         multiplier:0,     perpetual:true,   color:'#8957e5' },
  { id:'m8', emoji:'🏛️', title:'Generational Wealth',    desc:'Annual income x100 — a legacy that outlasts you',            multiplier:100,   annualBased:true, color:'#e3a228' },
];

// ── Formatters ────────────────────────────────────────
function fmt(n) {
  if (n == null || isNaN(n)) return '—';
  const d = CURR[cur].dec;
  return CURR[cur].sym + n.toLocaleString('en-US', {minimumFractionDigits:d, maximumFractionDigits:d});
}

function formatK(val) {
  const sym = CURR[cur].sym;
  if (CURR[cur].dec === 0) return sym + Math.round(val).toLocaleString('en-US'); // KRW/JPY: full number
  if (val >= 1000000) return sym + (val/1000000).toFixed(2) + 'M';
  if (val >= 1000)    return sym + Math.round(val/1000) + 'K';
  return sym + val.toFixed(2);
}

// ── Currency switch ───────────────────────────────────
function setCur(c) {
  const prevRate = prices.usd && prices[cur] ? prices[cur] / prices.usd : 0;
  const nextRate = prices.usd && prices[c]   ? prices[c]   / prices.usd : 0;
  if (prevRate > 0 && nextRate > 0) {
    ['monthlyDca', 'monthlyExpenses'].forEach(id => {
      const el = document.getElementById(id);
      const v  = parseFloat(el.value);
      if (!isNaN(v)) el.value = (v / prevRate * nextRate).toFixed(CURR[c].dec);
    });
  }
  cur = c;
  btcPrice = prices[cur] || btcPrice;
  document.getElementById('cur-sym').textContent = CURR[c].sym;
  document.getElementById('exp-sym').textContent = CURR[c].sym;
  const lbl = document.getElementById('btcPriceLabel');
  if (lbl) lbl.textContent = 'BTC Current Price (' + CURR[c].name + ')';
  const sel = document.getElementById('currency-select');
  if (sel) sel.value = c;
  updateBtcDisplay();
  update();
}

// ── Price fetch (5-min cache) ─────────────────────────
async function fetchBtcPrice() {
  const now = Date.now();
  if (now < ratesExpiry && prices.usd) { updateBtcDisplay(); update(); return; }
  try {
    const r = await fetch(
      'https://api.coingecko.com/api/v3/simple/price' +
      '?ids=bitcoin&vs_currencies=usd,krw,jpy,eur,gbp,cad,aud,sgd,hkd,aed,inr&include_24hr_change=true'
    );
    const d = await r.json();
    const b = d.bitcoin;
    prices = {usd:b.usd, krw:b.krw, jpy:b.jpy, eur:b.eur, gbp:b.gbp, cad:b.cad, aud:b.aud, sgd:b.sgd, hkd:b.hkd, aed:b.aed, inr:b.inr};
    ratesExpiry = Date.now() + RATES_TTL;
    btcPrice = prices[cur];
    updateBtcDisplay(b.usd_24h_change);
    update();
  } catch(e) {
    document.getElementById('btcPriceDisplay').textContent = CURR[cur].sym + '73,000';
    document.getElementById('btcChangeDisplay').textContent = 'Price unavailable';
    update();
  }
}

function updateBtcDisplay(change24h) {
  if (prices[cur]) btcPrice = prices[cur];
  document.getElementById('btcPriceDisplay').textContent = fmt(btcPrice);
  if (change24h !== undefined) {
    const el = document.getElementById('btcChangeDisplay');
    el.textContent  = (change24h >= 0 ? '+' : '') + change24h.toFixed(2) + '% (24h)';
    el.className    = 'btc-price-change ' + (change24h >= 0 ? 'up' : 'down');
  }
}

// ── CAGR controls ─────────────────────────────────────
function setCagr(val, name) {
  currentCagr = val;
  activeBtn   = name;
  document.querySelectorAll('.cagr-btn').forEach(b => b.classList.remove('active'));
  if (name !== 'custom') {
    document.getElementById('btn-' + name)?.classList.add('active');
    document.getElementById('customRow').classList.remove('show');
  }
  updateCagrInfo();
  update();
}

function toggleCustom() {
  const row = document.getElementById('customRow');
  row.classList.toggle('show');
  if (row.classList.contains('show')) {
    document.querySelectorAll('.cagr-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('btn-custom').classList.add('active');
    setCustomCagr();
  }
}

function setCustomCagr() {
  currentCagr = parseFloat(document.getElementById('customCagr').value) || 55;
  updateCagrInfo();
  update();
}

function updateCagrInfo() {
  const monthly = ((1 + currentCagr/100) ** (1/12) - 1) * 100;
  document.getElementById('cagrInfo').textContent    = currentCagr + '%/yr · ' + monthly.toFixed(2) + '%/mo compounding';
  document.getElementById('headerCagr').textContent  = 'CAGR ' + currentCagr + '% · ' + monthly.toFixed(2) + '%/mo';
}

// ── Projection math ───────────────────────────────────
function monthsToReach(currentBtcVal, monthlyDca, targetFiat, cagr) {
  const monthlyRate = (1 + cagr/100) ** (1/12) - 1;
  let portfolio = currentBtcVal;
  for (let m = 0; m < 600; m++) {
    portfolio = portfolio * (1 + monthlyRate) + monthlyDca;
    if (portfolio >= targetFiat) return m + 1;
  }
  return null;
}

function calcTarget(m, monthlyExpenses, annualExpenses, usdToFiat) {
  if (m.fixedTarget)  return m.target * usdToFiat;
  if (m.fireBased)    return annualExpenses * m.multiplier;
  if (m.annualBased)  return annualExpenses * m.multiplier;
  if (m.perpetual)    return (annualExpenses / (currentCagr / 100)) * 100;
  return monthlyExpenses * m.multiplier * 12;
}

// ── Main update ───────────────────────────────────────
function update() {
  const btcStack        = parseFloat(document.getElementById('btcStack').value) || 0;
  const monthlyDca      = parseFloat(document.getElementById('monthlyDca').value) || 0;
  const monthlyExpenses = parseFloat(document.getElementById('monthlyExpenses').value) || 0;
  const annualExpenses  = monthlyExpenses * 12;
  const currentBtcVal   = btcStack * btcPrice;
  const usdToFiat       = (prices.usd && prices[cur]) ? prices[cur] / prices.usd : 1;

  document.getElementById('btcUsdVal').textContent = '≈ ' + fmt(currentBtcVal);

  if (btcStack <= 0) {
    document.getElementById('milestoneList').innerHTML =
      '<div class="no-stack-msg"><div class="big">₿</div><p>Enter your Bitcoin stack to unlock your sovereignty timeline.</p></div>';
    document.getElementById('recsSection').style.display = 'none';
    document.getElementById('sovereigntyScore').textContent = '0';
    document.getElementById('scoreDesc').textContent = 'Enter your stack to begin';
    return;
  }

  const now = new Date();
  let reached = 0, html = '';

  milestones.forEach((m, i) => {
    let targetFiat = calcTarget(m, monthlyExpenses, annualExpenses, usdToFiat);
    if (targetFiat <= 0) targetFiat = currentBtcVal * 2;

    const months    = monthsToReach(currentBtcVal, monthlyDca, targetFiat, currentCagr);
    const isReached = currentBtcVal >= targetFiat;
    if (isReached) reached++;

    let dateStr = '', timeStr = '';
    if (isReached) {
      dateStr = 'Reached';
    } else if (months !== null) {
      const d = new Date(now);
      d.setMonth(d.getMonth() + months);
      dateStr = d.toLocaleDateString('en-US', {month:'short', year:'numeric'});
      timeStr = 'In ' + (months/12).toFixed(1) + ' yrs';
    } else {
      dateStr = '50+ yrs';
      timeStr = 'Very long horizon';
    }

    const monthlyRate = (1 + currentCagr/100) ** (1/12) - 1;
    let futureVal = currentBtcVal;
    const mCount  = months || 120;
    for (let x = 0; x < mCount; x++) futureVal = futureVal * (1 + monthlyRate) + monthlyDca;

    const portfolioStr = formatK(currentBtcVal) + ' / ' + formatK(Math.min(futureVal, targetFiat * 1.1));
    const progress     = isReached ? 100 : Math.min(99, (currentBtcVal / targetFiat) * 100);
    const isNext       = !isReached && i === milestones.findIndex(x => currentBtcVal < calcTarget(x, monthlyExpenses, annualExpenses, usdToFiat));

    html += `<div class="milestone-card ${isReached?'reached':''} ${isNext?'next':''}">
      <div class="m-icon">${m.emoji}</div>
      <div>
        <div class="m-title">${m.title}</div>
        <div class="m-desc">${m.desc}</div>
        <div class="m-progress-track"><div class="m-progress-bar" style="width:${progress}%;background:${m.color}"></div></div>
      </div>
      <div class="m-meta">
        ${isReached ? '<span class="reached-badge">✓ Reached</span>' : isNext ? '<span class="next-badge">Next</span>' : '<span class="m-date">'+dateStr+'</span>'}
        <div class="m-time">${timeStr}</div>
        <div class="m-portfolio">${portfolioStr}</div>
      </div>
    </div>`;
  });

  document.getElementById('milestoneList').innerHTML = html;

  const score = Math.min(100, Math.round((reached / milestones.length) * 100 + (currentBtcVal / (monthlyExpenses*12 || 1)) * 10));
  document.getElementById('sovereigntyScore').textContent = score;
  const descs = ['Just getting started','Building momentum','On the right path','Getting serious','Almost sovereign','Truly sovereign'];
  document.getElementById('scoreDesc').textContent = descs[Math.min(5, Math.floor(score/20))];

  buildRecs(monthlyDca, monthlyExpenses, usdToFiat);
  document.getElementById('recsSection').style.display = 'block';
}

// ── Recommendations ───────────────────────────────────
function buildRecs(monthlyDca, monthlyExpenses, usdToFiat) {
  let recs = [];
  const dcaRatio = monthlyExpenses > 0 ? monthlyDca / monthlyExpenses : 0;
  const cutAmt   = Math.round(500 * usdToFiat);

  if (dcaRatio < 0.1) {
    recs.push({
      icon:'⚠️',
      title:`You're stacking ${(dcaRatio*100).toFixed(1)}% of spending — below escape velocity`,
      desc:`Stackers who reach sovereignty typically put 10–20% of budget into Bitcoin. Raising to ${formatK(Math.round(monthlyExpenses*0.1))}/mo would lift your rate to 10%.`,
      badge:'High Impact', type:'high'
    });
  }

  if (monthlyExpenses > 3000 * usdToFiat) {
    recs.push({
      icon:'✂️',
      title:`Cut ${formatK(cutAmt)}/mo → your FIRE target drops by ${formatK(cutAmt * 12 * 25)}`,
      desc:`Going from ${formatK(monthlyExpenses)} to ${formatK(monthlyExpenses - cutAmt)}/mo shrinks your FIRE number significantly and compresses every single milestone.`,
      badge:'High Impact', type:'high'
    });
  }

  recs.push({
    icon:'📈',
    title:`Bull scenario (110% CAGR) compresses your timeline by ${Math.round((1 - Math.log(1+55/100)/Math.log(1+110/100))*100)}%`,
    desc:`If Bitcoin performs at historical peak rates, FIRE could arrive years earlier. The base vs bull difference is about one Bitcoin cycle.`,
    badge:'Medium Impact', type:'med'
  });

  document.getElementById('recsList').innerHTML = recs.map(r => `<div class="rec-card">
    <div class="rec-icon">${r.icon}</div>
    <div class="rec-body">
      <div class="rec-title">${r.title}</div>
      <div class="rec-desc">${r.desc}</div>
      <span class="rec-badge ${r.type==='high'?'badge-high':'badge-med'}">${r.badge}</span>
    </div>
  </div>`).join('');
}

updateCagrInfo();
fetchBtcPrice();
setInterval(fetchBtcPrice, 60000);
</script>
