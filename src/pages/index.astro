// ══════════════════════════════════════════════
//  Currency
// ══════════════════════════════════════════════
const CURR = {
  usd:{sym:'$',name:'USD',dec:2},
  krw:{sym:'₩',name:'KRW',dec:0},
  jpy:{sym:'¥',name:'JPY',dec:0},
  eur:{sym:'€',name:'EUR',dec:2},
  gbp:{sym:'£',name:'GBP',dec:2},
};
let cur = 'usd', prices = {}, priceData = null;

// Convert spend-amount field to new currency when user switches
function setCur(c){
  const prevRate = prices.usd && prices[cur] ? prices[cur] / prices.usd : 0;
  const nextRate = prices.usd && prices[c]   ? prices[c]   / prices.usd : 0;
  const amtEl   = document.getElementById('spend-amount');
  const oldAmt  = parseFloat(amtEl.value);
  if (prevRate > 0 && nextRate > 0 && !isNaN(oldAmt)) {
    const inUSD  = oldAmt / prevRate;           // convert to USD
    const inNew  = inUSD  * nextRate;            // convert to target
    amtEl.value  = inNew.toFixed(CURR[c].dec);
  }
  cur = c;
  document.querySelectorAll('#cur-group .pill-btn').forEach(b=>b.classList.toggle('on',b.dataset.cur===c));
  document.getElementById('cur-sym').textContent = CURR[c].sym;
  updateTicker();
}

function fmt(n, c=cur){
  if(n==null||isNaN(n)) return '—';
  const d = CURR[c].dec;
  return CURR[c].sym + n.toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});
}
function fmtUSD(n){ return fmt(n,'usd') }
function fmtBTC(n){
  if(n==null||isNaN(n)) return '—';
  if(n<0.000001) return '<0.000001 BTC';
  return n.toLocaleString('en-US',{minimumFractionDigits:8,maximumFractionDigits:8})+' BTC';
}
function fmtBig(n, c=cur){
  if(n==null||isNaN(n)) return '—';
  const s=CURR[c].sym;
  if(n>=1e12) return s+(n/1e12).toFixed(2)+'T';
  if(n>=1e9)  return s+(n/1e9).toFixed(2)+'B';
  if(n>=1e6)  return s+(n/1e6).toFixed(2)+'M';
  return fmt(n,c);
}
function sign(n){ return n>=0?'+':'' }

// ══════════════════════════════════════════════
//  Price fetch  (simple/price endpoint — faster + less rate-limited)
// ══════════════════════════════════════════════
async function fetchPrice(manual=false){
  const rb = document.getElementById('refresh-btn');
  if(rb) rb.classList.add('spin');

  // AbortController for timeout (works on all modern browsers)
  const ctrl  = new AbortController();
  const timer = setTimeout(()=>ctrl.abort(), 9000);

  try{
    const r = await fetch(
      'https://api.coingecko.com/api/v3/simple/price' +
      '?ids=bitcoin&vs_currencies=usd,krw,jpy,eur,gbp&include_24hr_change=true',
      { signal: ctrl.signal }
    );
    clearTimeout(timer);
    if(!r.ok) throw new Error('HTTP '+r.status);

    const d = await r.json();
    const b = d.bitcoin;
    prices = { usd:b.usd, krw:b.krw, jpy:b.jpy, eur:b.eur, gbp:b.gbp };
    priceData = { change24h: b.usd_24h_change ?? 0 };

    const pi = document.getElementById('btc-price-input');
    if(pi && !pi.dataset.manual) pi.value = prices.usd;

    updateTicker();
  }catch(e){
    clearTimeout(timer);
    const np = document.getElementById('nav-btc-price');
    if(np) np.textContent = 'API Error';
    console.warn('fetchPrice failed:', e.message);
  }finally{
    if(rb) rb.classList.remove('spin');
  }
}

function updateTicker(){
  if(!prices.usd) return;
  const ch = priceData?.change24h ?? 0;
  const np  = document.getElementById('nav-btc-price');
  const cel = document.getElementById('nav-btc-change');
  if(np)  np.textContent  = fmt(prices[cur]);
  if(cel){
    cel.textContent = (ch>=0?'▲ +':'▼ ')+Math.abs(ch).toFixed(2)+'%';
    cel.className   = ch>=0?'up':'down';
  }
}
document.getElementById('btc-price-input').addEventListener('input',function(){this.dataset.manual='true'});

// ══════════════════════════════════════════════
//  Sliders
// ══════════════════════════════════════════════
function setPct(el){
  const pct = ((el.value-el.min)/(el.max-el.min)*100).toFixed(1)+'%';
  el.style.setProperty('--pct',pct);
}
function onYearsChange(el){
  setPct(el);
  const y = parseInt(el.value);
  document.getElementById('years-val').textContent = y;
  document.getElementById('target-year').textContent = '→ '+(new Date().getFullYear()+y);
}
function onCagrChange(el){
  setPct(el);
  const v = parseInt(el.value);
  document.getElementById('cagr-val').textContent = v;
  // Match scenario label and highlight button
  let matched = null;
  if      (v === 15) matched = 'bear';
  else if (v === 21) matched = 'base';
  else if (v === 35) matched = 'bull';
  else if (v === 55) matched = 'hyperbull';
  document.querySelectorAll('.sc-btn').forEach(b =>
    b.classList.toggle('on', b.dataset.sc === matched)
  );
  let label = 'Custom';
  if      (v <= 18) label = 'Bear Case';
  else if (v <= 28) label = 'Base Case';
  else if (v <= 45) label = 'Bull Case';
  else if (v  >  45) label = 'Hyperbull';
  document.getElementById('cagr-scenario-label').textContent = matched
    ? SCENARIOS[matched].label
    : label;
}

const SCENARIOS = {
  bear:      {cagr:15, label:'Bear Case'},
  base:      {cagr:21, label:'Base Case'},
  bull:      {cagr:35, label:'Bull Case'},
  hyperbull: {cagr:55, label:'Hyperbull'},
};
function setScenario(sc){
  const s = SCENARIOS[sc];
  const sl = document.getElementById('cagr-slider');
  sl.value = s.cagr;
  setPct(sl);
  document.getElementById('cagr-val').textContent = s.cagr;
  document.getElementById('cagr-scenario-label').textContent = s.label;
  document.querySelectorAll('.sc-btn').forEach(b=>b.classList.toggle('on',b.dataset.sc===sc));
}

// ══════════════════════════════════════════════
//  Frequency
// ══════════════════════════════════════════════
let activeFreq = 'daily';
const FREQ_MULT = {daily:365,weekly:52,biweekly:26,monthly:12,once:1};
const FREQ_LABEL= {daily:'daily',weekly:'weekly',biweekly:'bi-weekly',monthly:'monthly',once:'one-time'};
function setFreq(f){
  activeFreq=f;
  document.querySelectorAll('.freq-btn').forEach(b=>b.classList.toggle('on',b.dataset.freq===f));
}

// ══════════════════════════════════════════════
//  CALCULATE
// ══════════════════════════════════════════════
function calculate(){
  const amountFiat = parseFloat(document.getElementById('spend-amount').value) || 0;
  const label      = document.getElementById('spend-label').value.trim() || 'My Latte Habit';
  const years      = parseInt(document.getElementById('years-slider').value) || 10;
  const cagr       = parseFloat(document.getElementById('cagr-slider').value) || 21;
  const btcNow     = parseFloat(document.getElementById('btc-price-input').value) || prices.usd || 0;

  const errEl = document.getElementById('err-msg');
  if (amountFiat <= 0 || !btcNow) { errEl.classList.add('show'); return; }
  errEl.classList.remove('show');

  // Normalise amount to USD (all BTC maths are in USD)
  const fiatToUSD = (prices.usd && prices[cur]) ? prices.usd / prices[cur] : 1;
  const amountUSD = amountFiat * fiatToUSD;

  // Core maths
  const mult          = FREQ_MULT[activeFreq];
  const totalUSD      = activeFreq === 'once' ? amountUSD : amountUSD * mult * years;
  const btcAmt        = btcNow > 0 ? totalUSD / btcNow : 0;
  const futureBTCprice = btcNow * Math.pow(1 + cagr / 100, years);
  const portfolioUSD  = btcAmt * futureBTCprice;

  // Display currency conversions
  const usdToFiat  = (prices.usd && prices[cur]) ? prices[cur] / prices.usd : 1;
  const totalFiat  = totalUSD     * usdToFiat;
  const portFiat   = portfolioUSD * usdToFiat;
  const futBTCFiat = futureBTCprice * usdToFiat;

  const returnPct     = totalUSD > 0 ? ((portfolioUSD - totalUSD) / totalUSD) * 100 : 0;
  const satsPerDollar = btcNow > 0 ? Math.round(1e8 / btcNow) : 0;
  const targetYear    = new Date().getFullYear() + years;
  const freqLabel     = FREQ_LABEL[activeFreq];

  // ── VERDICT ──────────────────────────────────────
  document.getElementById('v-sentence').textContent =
    `Your ${freqLabel} ${fmt(amountFiat)} ${label}`;
  document.getElementById('v-big').textContent = fmtBig(portFiat);
  document.getElementById('v-sub').textContent =
    `could be worth this by ${targetYear} — based on ${cagr}% annual Bitcoin CAGR`;
  document.getElementById('v-spent').textContent = fmt(totalFiat);
  document.getElementById('v-stack').textContent = fmtBig(portFiat);

  const roiEl = document.getElementById('v-stack-roi');
  roiEl.textContent = sign(returnPct) + returnPct.toFixed(0) + '% vs. what you spent';
  roiEl.className   = 'v-delta ' + (returnPct >= 0 ? 'delta-pos' : 'delta-neg');

  // v-spent label: e.g. "over 10 years"
  document.getElementById('v-spent-label').textContent =
    activeFreq === 'once' ? 'one-time payment' : `over ${years} year${years > 1 ? 's' : ''}`;

  // ── BREAKDOWN (list) ─────────────────────────────
  const btcSats = btcAmt > 0 ? Math.round(btcAmt * 1e8) : 0;

  document.getElementById('bd-usd').textContent            = fmtUSD(totalUSD);
  document.getElementById('bd-btc').textContent            = fmtBTC(btcAmt);
  document.getElementById('bd-btc-sats').textContent       = btcSats > 0 ? btcSats.toLocaleString('en-US') + ' sats' : '';
  document.getElementById('bd-price-label').textContent    = `BTC Price in ${targetYear}`;
  document.getElementById('bd-future-price').textContent   = fmtUSD(futureBTCprice);
  document.getElementById('bd-portfolio').textContent      = fmtUSD(portfolioUSD);

  const retEl       = document.getElementById('bd-return');
  retEl.textContent = sign(returnPct) + returnPct.toFixed(1) + '%';
  retEl.className   = 'bd-val ' + (returnPct >= 0 ? 'green' : 'red');

  document.getElementById('bd-sats').textContent =
    satsPerDollar.toLocaleString('en-US') + ' sats / $1';

  // ── SHARE TEXT (always English) ──────────────────
  const shareStr =
    `I just calculated that my ${freqLabel} $${amountUSD.toFixed(2)} ${label} habit ` +
    `could be worth ${fmtUSD(portfolioUSD)} in Bitcoin by ${targetYear}.\n\n` +
    `That's ${fmtBTC(btcAmt)} — stacked instead of spent.\n\n` +
    `Based on ${cagr}% annual BTC return (${document.getElementById('cagr-scenario-label').textContent}).\n\n` +
    `What's YOUR habit costing you? 👇\n${window.location.href}`;
  document.getElementById('share-text').value = shareStr;

  // ── SHOW RESULTS ─────────────────────────────────
  const rw = document.getElementById('results');
  rw.classList.add('show');
  setTimeout(() => rw.scrollIntoView({ behavior: 'smooth', block: 'start' }), 80);
}

// ══════════════════════════════════════════════
//  Share
// ══════════════════════════════════════════════
function postToX(){
  const txt = document.getElementById('share-text').value;
  window.open('https://twitter.com/intent/tweet?text='+encodeURIComponent(txt),'_blank');
}
async function copyShareText(){
  const txt = document.getElementById('share-text').value;
  try{
    await navigator.clipboard.writeText(txt);
    const btn = document.getElementById('copy-share-btn');
    btn.textContent = t('copied'); btn.classList.add('done');
    setTimeout(()=>{ btn.textContent=t('btn_copy'); btn.classList.remove('done') },2000);
  }catch(e){}
}

// ══════════════════════════════════════════════
//  Lightning Tip
// ══════════════════════════════════════════════
function validateTip(){
  const v = document.getElementById('tip-addr').value.trim();
  const el = document.getElementById('tip-valid');
  if(!v){ el.textContent=''; el.className='tip-valid'; return; }
  const ok = /^(bc1|[13])[a-zA-HJ-NP-Z0-9]{25,62}$|^lnbc|^lightning@|^[\w.-]+@[\w.-]+\.[a-z]{2,}$/.test(v);
  el.textContent = ok ? '✓ '+t('w_ok') : '✗ '+t('w_err');
  el.className = 'tip-valid '+(ok?'ok':'err');
  if(ok) localStorage.setItem('stl_tip',v);
}
async function copyTip(){
  const v = document.getElementById('tip-addr').value.trim();
  if(!v) return;
  try{
    await navigator.clipboard.writeText(v);
    const btn = document.getElementById('tip-copy-btn');
    btn.textContent = t('copied'); btn.classList.add('done');
    setTimeout(()=>{ btn.textContent=t('btn_copy'); btn.classList.remove('done') },2000);
  }catch(e){}
}

// ══════════════════════════════════════════════
//  Init
// ══════════════════════════════════════════════
// Init sliders
const ys = document.getElementById('years-slider');
const cs = document.getElementById('cagr-slider');
setPct(ys); setPct(cs);
document.getElementById('target-year').textContent = '→ '+(new Date().getFullYear()+parseInt(ys.value));

// Restore tip
const saved = localStorage.getItem('stl_tip');
if(saved){ document.getElementById('tip-addr').value=saved; validateTip(); }

// Set Base scenario active
setScenario('base');

fetchPrice();
setInterval(()=>fetchPrice(), 60000);
</script>
</body>
</html>
