<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="description" content="SkipTheLatte — Calculate the Bitcoin opportunity cost of your daily habits."/>
  <title>SkipTheLatte — Bitcoin Opportunity Cost Calculator</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --blue:#1763B6; --blue-h:#1357a0; --blue-bg:#eaf1fb; --blue-lt:#f2f6fd;
      --green:#05b26b; --green-bg:#eafaf3;
      --red:#f04452;   --red-bg:#fff0f1;
      --amber:#f59e0b; --amber-bg:#fffbeb;
      --bg:#ffffff; --bg2:#f7f8fa; --bg3:#f0f2f5;
      --border:#e5e8eb; --border2:#dde1e7;
      --text:#0a0a0a; --text2:#5c6370; --text3:#9ea5b0;
      --font:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    }
    html{font-family:var(--font);background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
    body{min-height:100vh;display:flex;flex-direction:column}
    button{font-family:inherit;cursor:pointer}
    input,select,textarea{font-family:inherit}
    a{color:var(--blue);text-decoration:none}

    /* ═══ NAV ═══════════════════════════════════════ */
    .nav{
      position:sticky;top:0;z-index:200;
      background:var(--bg);border-bottom:1px solid var(--border);
      display:flex;align-items:center;justify-content:space-between;
      padding:0 24px;height:56px;gap:12px;
    }
    .nav-logo{
      display:flex;align-items:center;gap:8px;
      font-size:16px;font-weight:800;color:var(--text);letter-spacing:-.02em;
      white-space:nowrap;
    }
    .logo-dot{width:8px;height:8px;border-radius:50%;background:var(--blue);flex-shrink:0}

    .nav-center{
      display:flex;align-items:center;gap:6px;
      font-size:13px;color:var(--text2);
    }
    .btc-live-price{font-size:14px;font-weight:700;color:var(--text);font-variant-numeric:tabular-nums}
    #nav-btc-change{font-size:12px;font-weight:600}

    .nav-right{display:flex;align-items:center;gap:6px;flex-shrink:0}
    .pill-group{display:flex;border:1px solid var(--border);border-radius:7px;overflow:hidden}
    .pill-btn{
      padding:5px 11px;font-size:12px;font-weight:600;
      color:var(--text2);background:transparent;border:none;
      border-right:1px solid var(--border);transition:all .12s;
    }
    .pill-btn:last-child{border-right:none}
    .pill-btn:hover{color:var(--blue);background:var(--blue-bg)}
    .pill-btn.on{background:var(--blue);color:#fff}

    /* ═══ MAIN CONTENT ═══════════════════════════════ */
    .wrap{max-width:800px;margin:0 auto;width:100%;padding:0 24px}
    main{flex:1;padding-bottom:64px}

    /* Section header */
    .sec-head{
      display:flex;align-items:center;gap:12px;
      padding:36px 0 20px;
    }
    .sec-num{
      font-size:11px;font-weight:800;letter-spacing:.1em;
      color:var(--blue);
    }
    .sec-line{flex:none;width:24px;height:1.5px;background:var(--border2)}
    .sec-title{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--text2)}

    /* Card wrapper */
    .section-card{
      background:var(--bg);border:1.5px solid var(--border);border-radius:14px;
      padding:24px;display:flex;flex-direction:column;gap:20px;
    }

    /* ─── Field ─────────────────────────────────── */
    .field{display:flex;flex-direction:column;gap:6px}
    .field>label{
      font-size:11px;font-weight:600;text-transform:uppercase;
      letter-spacing:.07em;color:var(--text3);
    }
    .irow{position:relative;display:flex;align-items:center}
    .ipre,.isuf{
      position:absolute;font-size:13px;font-weight:600;color:var(--text3);pointer-events:none;z-index:1
    }
    .ipre{left:12px} .isuf{right:12px}
    input[type="number"],input[type="text"]{
      width:100%;background:var(--bg2);border:1.5px solid var(--border);
      color:var(--text);padding:11px 13px;border-radius:9px;
      font-size:15px;font-weight:500;transition:border-color .15s,box-shadow .15s;
      -moz-appearance:textfield;
    }
    input::-webkit-inner-spin-button,input::-webkit-outer-spin-button{-webkit-appearance:none}
    input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,99,182,.1);background:#fff}
    .with-pre input{padding-left:28px}
    .with-suf input{padding-right:40px}
    input::placeholder{color:var(--text3);font-size:13px}

    /* Frequency pills */
    .freq-pills{display:flex;gap:6px;flex-wrap:wrap}
    .freq-btn{
      padding:8px 14px;border-radius:8px;font-size:13px;font-weight:600;
      background:var(--bg2);border:1.5px solid var(--border);color:var(--text2);
      transition:all .12s;
    }
    .freq-btn:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-lt)}
    .freq-btn.on{background:var(--blue);border-color:var(--blue);color:#fff;box-shadow:0 2px 8px rgba(23,99,182,.2)}

    /* ─── Sliders ──────────────────────────────── */
    .slider-row{display:flex;flex-direction:column;gap:8px}
    .slider-labels{display:flex;justify-content:space-between;align-items:center}
    .slider-val{font-size:20px;font-weight:800;color:var(--blue);font-variant-numeric:tabular-nums}
    .slider-sub{font-size:12px;color:var(--text3)}
    input[type="range"]{
      -webkit-appearance:none;width:100%;height:4px;border-radius:2px;
      background:linear-gradient(to right,var(--blue) 0%,var(--blue) var(--pct,30%),var(--border2) var(--pct,30%),var(--border2) 100%);
      outline:none;cursor:pointer;
    }
    input[type="range"]::-webkit-slider-thumb{
      -webkit-appearance:none;width:20px;height:20px;border-radius:50%;
      background:var(--blue);border:2.5px solid #fff;
      box-shadow:0 1px 6px rgba(23,99,182,.3);cursor:pointer;
    }
    input[type="range"]::-moz-range-thumb{
      width:20px;height:20px;border-radius:50%;
      background:var(--blue);border:2.5px solid #fff;cursor:pointer;
    }
    .slider-minmax{display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-top:2px}

    /* CAGR scenario pills */
    .scenario-pills{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:4px}
    .sc-btn{
      padding:6px 13px;border-radius:7px;font-size:12px;font-weight:700;
      background:var(--bg2);border:1.5px solid var(--border);color:var(--text2);
      transition:all .12s;
    }
    .sc-btn:hover{opacity:.85}
    .sc-btn[data-sc="bear"].on    {background:#fef2f2;border-color:var(--red);  color:var(--red)}
    .sc-btn[data-sc="base"].on    {background:var(--blue-bg);border-color:var(--blue); color:var(--blue)}
    .sc-btn[data-sc="bull"].on    {background:var(--green-bg);border-color:var(--green);color:var(--green)}
    .sc-btn[data-sc="hyperbull"].on{background:var(--amber-bg);border-color:var(--amber);color:var(--amber)}

    /* BTC price row */
    .price-row{display:flex;gap:8px;align-items:stretch}
    .price-row .irow{flex:1}
    .btn-refresh{
      padding:0 14px;background:var(--bg2);border:1.5px solid var(--border);
      border-radius:9px;color:var(--text2);font-size:16px;
      transition:all .12s;flex-shrink:0;
    }
    .btn-refresh:hover{border-color:var(--blue);color:var(--blue)}
    .btn-refresh.spin{animation:spin .6s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}

    /* ═══ CALCULATE BUTTON ═══════════════════════ */
    .calc-wrap{padding:28px 0 0}
    .btn-calculate{
      display:block;width:100%;padding:18px;
      background:var(--blue);color:#fff;border:none;border-radius:12px;
      font-size:15px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
      box-shadow:0 4px 16px rgba(23,99,182,.25);transition:background .15s,transform .1s,box-shadow .15s;
    }
    .btn-calculate:hover{background:var(--blue-h);transform:translateY(-1px);box-shadow:0 6px 22px rgba(23,99,182,.3)}
    .btn-calculate:active{transform:translateY(0)}

    /* ═══ RESULTS ════════════════════════════════ */
    .results-wrap{display:none}
    .results-wrap.show{display:block}

    /* VERDICT */
    .verdict-card{
      background:#0a0a0a;border-radius:14px;
      padding:36px 32px;color:#fff;
      position:relative;overflow:hidden;margin-bottom:16px;
    }
    .verdict-card::after{
      content:'';position:absolute;inset:0;
      background:radial-gradient(ellipse at 85% 30%,rgba(23,99,182,.35) 0%,transparent 60%);
      pointer-events:none;
    }
    .verdict-eyebrow{
      font-size:10px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
      color:rgba(255,255,255,.4);margin-bottom:14px;
    }
    .verdict-hl{
      font-size:clamp(14px,2.5vw,17px);font-weight:400;color:rgba(255,255,255,.7);
      line-height:1.6;margin-bottom:4px;
    }
    .verdict-hl strong{
      display:block;font-size:clamp(32px,6vw,56px);font-weight:900;color:#fff;
      letter-spacing:-.03em;line-height:1.05;font-variant-numeric:tabular-nums;
      margin:6px 0 10px;
    }
    .verdict-sub{font-size:12px;color:rgba(255,255,255,.35);margin-bottom:24px}

    .verdict-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .v-card{
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
      border-radius:10px;padding:16px;
    }
    .v-card label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.4);display:block;margin-bottom:6px}
    .v-card .v-val{font-size:clamp(18px,3vw,24px);font-weight:800;font-variant-numeric:tabular-nums;color:#fff}
    .v-card .v-delta{font-size:12px;font-weight:700;margin-top:3px}
    .delta-pos{color:#4de0a0} .delta-neg{color:#ff8080}

    /* BREAKDOWN */
    .bd-list{border:1.5px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:16px}
    .bd-row{
      display:flex;align-items:center;justify-content:space-between;
      padding:13px 18px;border-bottom:1px solid var(--border2);gap:16px;
    }
    .bd-row:last-child{border-bottom:none}
    .bd-row:nth-child(even){background:var(--bg2)}
    .bd-lbl{font-size:13px;font-weight:500;color:var(--text2);flex-shrink:0}
    .bd-right{text-align:right;display:flex;flex-direction:column;gap:2px}
    .bd-val{font-size:14px;font-weight:700;color:var(--text);font-variant-numeric:tabular-nums}
    .bd-val.blue{color:var(--blue)}
    .bd-val.green{color:var(--green)}
    .bd-val.red{color:var(--red)}
    .bd-sub{font-size:11px;font-weight:500;color:var(--text3);font-variant-numeric:tabular-nums}

    /* SHARE */
    .share-section{border:1.5px solid var(--border);border-radius:12px;padding:20px;margin-bottom:16px}
    .share-head{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--text2);margin-bottom:12px;display:flex;align-items:center;gap:8px}
    .share-head::before{content:'';width:16px;height:1.5px;background:var(--border2)}
    textarea{
      width:100%;background:var(--bg2);border:1.5px solid var(--border);color:var(--text);
      padding:12px 14px;border-radius:9px;font-size:13px;line-height:1.6;
      resize:none;transition:border-color .15s;min-height:88px;
    }
    textarea:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,99,182,.1);background:#fff}
    .share-btns{display:flex;gap:8px;margin-top:10px}
    .btn-x{
      flex:1;padding:11px;background:#000;color:#fff;border:none;border-radius:9px;
      font-size:13px;font-weight:700;letter-spacing:.03em;display:flex;align-items:center;justify-content:center;gap:7px;
      transition:background .12s;
    }
    .btn-x:hover{background:#1a1a1a}
    .btn-copy-share{
      padding:11px 20px;background:var(--bg2);border:1.5px solid var(--border);
      border-radius:9px;font-size:13px;font-weight:600;color:var(--text2);
      transition:all .12s;white-space:nowrap;
    }
    .btn-copy-share:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-bg)}
    .btn-copy-share.done{background:var(--green);border-color:var(--green);color:#fff}

    /* STACKFREEDOM BANNER */
    .sf-banner{
      background:var(--blue);border-radius:14px;padding:28px 28px;
      display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
      margin-bottom:16px;
    }
    .sf-left{}
    .sf-eyebrow{font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:6px}
    .sf-headline{font-size:clamp(18px,3vw,24px);font-weight:800;color:#fff;letter-spacing:-.01em}
    .sf-sub{font-size:13px;color:rgba(255,255,255,.65);margin-top:4px}
    .btn-sf{
      padding:11px 22px;background:#fff;color:var(--blue);
      border:none;border-radius:9px;font-size:13px;font-weight:800;
      white-space:nowrap;transition:opacity .12s;
    }
    .btn-sf:hover{opacity:.9}

    /* LIGHTNING TIP */
    .tip-section{border:1.5px solid var(--border);border-radius:12px;padding:20px;margin-bottom:16px}
    .tip-head{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--text2);margin-bottom:4px;display:flex;align-items:center;gap:8px}
    .tip-head::before{content:'';width:16px;height:1.5px;background:var(--border2)}
    .tip-sub{font-size:12px;color:var(--text3);margin-bottom:14px}
    .tip-row{display:flex;gap:8px}
    .tip-input{
      flex:1;background:var(--bg2);border:1.5px solid var(--border);
      color:var(--text);padding:10px 14px;border-radius:9px;
      font-size:13px;font-family:'Courier New',monospace;letter-spacing:.03em;
    }
    .tip-input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,99,182,.1);background:#fff}
    .tip-input::placeholder{font-family:var(--font);letter-spacing:0;color:var(--text3);font-size:12px}
    .btn-tip-copy{
      padding:10px 18px;background:var(--bg2);border:1.5px solid var(--border);
      border-radius:9px;font-size:13px;font-weight:600;color:var(--text2);
      transition:all .12s;white-space:nowrap;
    }
    .btn-tip-copy:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-bg)}
    .btn-tip-copy.done{background:var(--green);border-color:var(--green);color:#fff}
    .tip-valid{font-size:11px;margin-top:6px}
    .tip-valid.ok{color:var(--green)} .tip-valid.err{color:var(--red)}

    /* ═══ FOOTER ═══════════════════════════════ */
    footer{background:var(--bg2);border-top:1px solid var(--border);padding:40px 24px 24px}
    .footer-inner{max-width:800px;margin:0 auto}
    .footer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-bottom:32px}
    @media(max-width:560px){.footer-grid{grid-template-columns:1fr;gap:20px}}
    .footer-col h4{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--text);margin-bottom:12px}
    .footer-col ul{list-style:none;display:flex;flex-direction:column;gap:7px}
    .footer-col a{font-size:13px;color:var(--text2);text-decoration:none;transition:color .12s}
    .footer-col a:hover{color:var(--blue)}
    .footer-bottom{border-top:1px solid var(--border);padding-top:16px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
    .footer-bottom p{font-size:12px;color:var(--text3)}
    .footer-brand{font-size:13px;font-weight:800;color:var(--text);letter-spacing:-.01em;display:flex;align-items:center;gap:6px}

    /* MISC */
    .divider{border:none;border-top:1px solid var(--border2);margin:0}
    .live-dot{width:5px;height:5px;border-radius:50%;background:var(--green);display:inline-block;animation:blink 2s ease-in-out infinite}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
    .err-msg{display:none;font-size:12px;color:var(--red);background:#fff0f1;border:1px solid #fcd0d3;border-radius:7px;padding:8px 12px;margin-top:8px}
    .err-msg.show{display:block}

    @media(max-width:600px){
      .nav{padding:0 16px;gap:8px}
      .nav-center{display:none}
      .wrap{padding:0 16px}
      .verdict-cards{grid-template-columns:1fr}
      .breakdown-grid{grid-template-columns:1fr}
      .bd-item{border-right:none!important}
      .bd-item:last-child{border-bottom:none}
      .bd-item:nth-last-child(-n+2){border-bottom:1px solid var(--border2)}
      .bd-item:last-child{border-bottom:none!important}
    }
  </style>
</head>
<body>

<!-- ═══ NAV ═══════════════════════════════════════════ -->
<nav class="nav">
  <a class="nav-logo" href="/">
    <span class="logo-dot"></span>
    SkipTheLatte
  </a>

  <div class="nav-center">
    <span class="live-dot"></span>
    <span id="nav-btc-price" class="btc-live-price">—</span>
    <span id="nav-btc-change">—</span>
  </div>

  <div class="nav-right" style="display:flex;align-items:center;gap:6px">
    <a href="/freedom" style="font-size:13px;font-weight:600;color:var(--blue);padding:5px 12px;border:1px solid var(--blue);border-radius:7px;text-decoration:none;background:var(--blue-bg);transition:all .12s;">Freedom Planner</a>
    <a href="/faq" style="font-size:13px;font-weight:600;color:var(--text2);padding:5px 12px;border:1px solid var(--border);border-radius:7px;text-decoration:none;transition:color .12s,border-color .12s;" onmouseover="this.style.color='#1763B6';this.style.borderColor='#1763B6'" onmouseout="this.style.color='';this.style.borderColor=''">FAQ</a>
  </div>
</nav>

<!-- ═══ MAIN ═══════════════════════════════════════════ -->
<main>
<div class="wrap">

  <!-- 01 THE SPEND -->
  <div class="sec-head">
    <span class="sec-num">01</span>
    <span class="sec-line"></span>
    <span class="sec-title" data-i18n="sec_spend">THE SPEND</span>
  </div>
  <div class="section-card">

    <div class="field">
      <label data-i18n="label_name">What is this habit? (optional)</label>
      <div class="irow">
        <input type="text" id="spend-label" value="My Latte Habit" placeholder="latte, coffee, gym, Netflix..." maxlength="40"/>
      </div>
    </div>

    <div class="field">
      <label data-i18n="label_amount">Amount per purchase</label>
      <div class="irow with-pre">
        <span class="ipre" id="cur-sym">$</span>
        <input type="number" id="spend-amount" value="5" min="0.01" step="any" placeholder="5.00"/>
      </div>
    </div>

    <div class="field">
      <label data-i18n="label_freq">Frequency</label>
      <div class="freq-pills">
        <button class="freq-btn on" data-freq="daily"    onclick="setFreq('daily')"   data-i18n="freq_daily">Daily</button>
        <button class="freq-btn"    data-freq="weekly"   onclick="setFreq('weekly')"  data-i18n="freq_weekly">Weekly</button>
        <button class="freq-btn"    data-freq="biweekly" onclick="setFreq('biweekly')" data-i18n="freq_biwk">Bi-Wk</button>
        <button class="freq-btn"    data-freq="monthly"  onclick="setFreq('monthly')" data-i18n="freq_monthly">Monthly</button>
        <button class="freq-btn"    data-freq="once"     onclick="setFreq('once')"    data-i18n="freq_once">Once</button>
      </div>
    </div>

  </div>

  <!-- 02 THE FUTURE -->
  <div class="sec-head">
    <span class="sec-num">02</span>
    <span class="sec-line"></span>
    <span class="sec-title" data-i18n="sec_future">THE FUTURE</span>
  </div>
  <div class="section-card">

    <!-- Time slider -->
    <div class="field">
      <label data-i18n="label_years">How far ahead?</label>
      <div class="slider-row">
        <div class="slider-labels">
          <span class="slider-val"><span id="years-val">10</span> <span style="font-size:14px;font-weight:500;color:var(--text2)" data-i18n="years_suffix">years</span></span>
          <span class="slider-sub" id="target-year">→ 2034</span>
        </div>
        <input type="range" id="years-slider" min="1" max="40" value="10" oninput="onYearsChange(this)"/>
        <div class="slider-minmax"><span>1 yr</span><span>40 yrs</span></div>
      </div>
    </div>

    <hr class="divider"/>

    <!-- BTC Price -->
    <div class="field">
      <label data-i18n="label_btc_price">Current BTC Price (USD)</label>
      <div class="price-row">
        <div class="irow with-pre" style="flex:1">
          <span class="ipre">$</span>
          <input type="number" id="btc-price-input" placeholder="Loading..." step="any"/>
        </div>
        <button class="btn-refresh" id="refresh-btn" onclick="fetchPrice(true)" title="Refresh">↻</button>
      </div>
    </div>

    <hr class="divider"/>

    <!-- CAGR Scenarios -->
    <div class="field">
      <label data-i18n="label_cagr">Expected Annual Return (CAGR)</label>
      <div class="scenario-pills">
