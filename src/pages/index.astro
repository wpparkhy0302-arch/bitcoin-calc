let activeLang = 'en';

function setLang(lang) {
  activeLang = lang;
  document.querySelectorAll('.lang-btn').forEach(b => {
    b.classList.toggle('active', b.textContent.toLowerCase() === lang);
  });
  const d = I18N[lang];
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (d[key] != null) el.innerHTML = d[key];
  });
  // Keep cur-unit labels updated
  document.querySelectorAll('.cur-unit').forEach(el => {
    el.textContent = '(' + CURRENCIES[activeCur].name + ')';
  });
}

// ════════════════════════════════════════════════
//  Currency State
// ════════════════════════════════════════════════
const CURRENCIES = {
  usd: { label: 'US Dollar',     sym: '$', name: 'USD', dec: 2 },
  krw: { label: '한국 원',        sym: '₩', name: 'KRW', dec: 0 },
  jpy: { label: '日本円',          sym: '¥', name: 'JPY', dec: 0 },
  eur: { label: 'Euro',           sym: '€', name: 'EUR', dec: 2 },
  gbp: { label: 'British Pound', sym: '£', name: 'GBP', dec: 2 },
};

let activeCur  = 'usd';
let prices     = {};
let priceData  = null;
let dcaCount   = 0;

// ════════════════════════════════════════════════
//  Formatters
// ════════════════════════════════════════════════
function fmtCur(n, cur = activeCur) {
  if (n == null || isNaN(n)) return '—';
  const c = CURRENCIES[cur];
  return c.sym + n.toLocaleString('en-US', { minimumFractionDigits: c.dec, maximumFractionDigits: c.dec });
}
function fmtUSD(n) { return fmtCur(n, 'usd'); }
function fmtBTC(n) {
  if (n == null || isNaN(n)) return '—';
  return n.toFixed(8) + ' BTC';
}
function fmtBig(n, cur = activeCur) {
  if (!n) return '—';
  const s = CURRENCIES[cur].sym;
  if (n >= 1e12) return s + (n / 1e12).toFixed(2) + 'T';
  if (n >= 1e9)  return s + (n / 1e9).toFixed(2) + 'B';
  if (n >= 1e6)  return s + (n / 1e6).toFixed(2) + 'M';
  return s + n.toLocaleString('en-US');
}
function signStr(n) { return n >= 0 ? '+' : ''; }

// ════════════════════════════════════════════════
//  Currency Switch
// ════════════════════════════════════════════════
function setCurrency(cur) {
  activeCur = cur;
  document.querySelectorAll('.cur-tab').forEach(b =>
    b.classList.toggle('active', b.dataset.cur === cur)
  );
  const c = CURRENCIES[cur];
  document.getElementById('c-fiat-label').textContent = c.label;
  document.getElementById('c-cur-name').textContent   = c.name;
  document.getElementById('c-sym').textContent        = c.sym;
  document.querySelectorAll('.cur-unit').forEach(el => el.textContent = '(' + c.name + ')');
  if (priceData) refreshDisplays();
}

// ════════════════════════════════════════════════
//  Fetch
// ════════════════════════════════════════════════
async function fetchPrice(manual = false) {
  const btn = document.getElementById('refresh-btn');
  btn.classList.add('spinning');
  try {
    const res = await fetch(
      'https://api.coingecko.com/api/v3/coins/bitcoin?localization=false&tickers=false&market_data=true&community_data=false&developer_data=false',
      { signal: AbortSignal.timeout(8000) }
    );
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const d = await res.json();
    priceData = d;
    const md = d.market_data;
    prices = {
      usd: md.current_price.usd,
      krw: md.current_price.krw,
      jpy: md.current_price.jpy,
      eur: md.current_price.eur,
      gbp: md.current_price.gbp,
    };
    document.getElementById('api-err').style.display = 'none';
    const plCur = document.getElementById('pl-current');
    if (!plCur.dataset.manual) plCur.value = prices.usd;
    refreshDisplays();
  } catch (e) {
    console.error(e);
    document.getElementById('api-err').style.display = 'block';
  } finally {
    btn.classList.remove('spinning');
  }
}

function refreshDisplays() {
  if (!priceData) return;
  const md  = priceData.market_data;
  const cur = activeCur;
  const p   = prices[cur];

  // Price banner
  const priceEl = document.getElementById('price-main');
  priceEl.textContent = fmtCur(p);

  const ch    = md.price_change_percentage_24h ?? 0;
  const chEl  = document.getElementById('price-change');
  const arrow = ch >= 0 ? '▲' : '▼';
  chEl.textContent = `${arrow} ${signStr(ch)}${ch.toFixed(2)}%`;
  chEl.className   = 'change-badge ' + (ch > 0 ? 'up' : ch < 0 ? 'down' : 'neu');
  priceEl.className = 'price-number ' + (ch > 0 ? 'up' : ch < 0 ? 'down' : '');

  const now = new Date();
  document.getElementById('price-time').textContent =
    now.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' });
  document.getElementById('footer-updated').textContent =
    'Last updated: ' + now.toLocaleTimeString('en-US');

  document.getElementById('s-high').textContent = fmtCur(md.high_24h?.[cur]);
  document.getElementById('s-low').textContent  = fmtCur(md.low_24h?.[cur]);
  document.getElementById('s-mcap').textContent = fmtBig(md.market_cap?.[cur], cur);
  document.getElementById('s-vol').textContent  = fmtBig(md.total_volume?.[cur], cur);
  document.getElementById('s-usd').textContent  = fmtUSD(prices.usd);
  document.getElementById('s-ath').textContent  = fmtCur(md.ath?.[cur]);

  document.getElementById('c-rate').textContent      = `1 BTC = ${fmtCur(p)} / ${fmtUSD(prices.usd)}`;
  document.getElementById('c-1btc-fiat').textContent = fmtCur(p);
  document.getElementById('c-1btc-usd').textContent  = fmtUSD(prices.usd);

  calcPL();
  calcDCA();
}

// ════════════════════════════════════════════════
//  Converter
// ════════════════════════════════════════════════
function convFrom(src) {
  const p = prices[activeCur], pUSD = prices.usd;
  if (!p || !pUSD) return;
  const btc  = document.getElementById('c-btc');
  const fiat = document.getElementById('c-fiat');
  const usd  = document.getElementById('c-usd');
  const dec  = CURRENCIES[activeCur].dec;
  if (src === 'btc') {
    const v = parseFloat(btc.value);
    if (isNaN(v)) { fiat.value = ''; usd.value = ''; return; }
    fiat.value = (v * p).toFixed(dec);
    usd.value  = (v * pUSD).toFixed(2);
  } else if (src === 'fiat') {
    const v = parseFloat(fiat.value);
    if (isNaN(v)) { btc.value = ''; usd.value = ''; return; }
    btc.value = (v / p).toFixed(8);
    usd.value = ((v / p) * pUSD).toFixed(2);
  } else {
    const v = parseFloat(usd.value);
    if (isNaN(v)) { btc.value = ''; fiat.value = ''; return; }
    btc.value  = (v / pUSD).toFixed(8);
    fiat.value = ((v / pUSD) * p).toFixed(dec);
  }
}

// ════════════════════════════════════════════════
//  P&L Calculator
// ════════════════════════════════════════════════
document.getElementById('pl-current').addEventListener('input', function () {
  this.dataset.manual = 'true';
  calcPL();
});

function calcPL() {
  const entry   = parseFloat(document.getElementById('pl-entry').value);
  const amount  = parseFloat(document.getElementById('pl-amount').value);
  const current = parseFloat(document.getElementById('pl-current').value) || prices.usd;
  const p       = prices[activeCur], pUSD = prices.usd;

  const ids = ['pl-pnl','pl-roi','pl-value','pl-cost','pl-be'];
  if (!entry || !amount || !current) {
    ids.forEach(id => { const el=document.getElementById(id); el.textContent='—'; el.className='val'; });
    document.getElementById('pl-be').className = 'val blue';
    return;
  }

  const rate     = (p && pUSD) ? p / pUSD : 1;
  const costUSD  = entry * amount;
  const valUSD   = current * amount;
  const pnlUSD   = valUSD - costUSD;
  const roi      = (pnlUSD / costUSD) * 100;
  const isUp     = pnlUSD > 0;
  const isDown   = pnlUSD < 0;
  const cls      = isUp ? 'val up' : isDown ? 'val down' : 'val';
  const s        = signStr(pnlUSD);

  document.getElementById('pl-pnl').textContent   = s + fmtCur(pnlUSD * rate);
  document.getElementById('pl-pnl').className     = cls;
  document.getElementById('pl-roi').textContent   = s + roi.toFixed(2) + '%';
  document.getElementById('pl-roi').className     = cls;
  document.getElementById('pl-value').textContent = fmtCur(valUSD * rate);
  document.getElementById('pl-value').className   = 'val';
  document.getElementById('pl-cost').textContent  = fmtCur(costUSD * rate);
  document.getElementById('pl-cost').className    = 'val';
  document.getElementById('pl-be').textContent    = fmtUSD(entry);
}

// ════════════════════════════════════════════════
//  DCA Calculator
// ════════════════════════════════════════════════
function addDCARow(date = '', price = '', amount = '') {
  dcaCount++;
  const id = dcaCount;
  const container = document.getElementById('dca-rows');

  const row = document.createElement('div');
  row.className = 'dca-row';
  row.id = 'drow-' + id;

  const dateIn = document.createElement('input');
  dateIn.type = 'date'; dateIn.value = date;

  const priceWrap = document.createElement('div');
  priceWrap.className = 'input-wrap with-pre';
  priceWrap.style.position = 'relative';
  const prePre = document.createElement('span');
  prePre.className = 'input-pre';
  prePre.style.cssText = 'font-size:11px;left:8px;';
  prePre.textContent = '$';
  const priceIn = document.createElement('input');
  priceIn.type = 'number'; priceIn.step = 'any'; priceIn.value = price; priceIn.placeholder = '65000';
  priceIn.style.paddingLeft = '20px';
  priceWrap.append(prePre, priceIn);

  const amtIn = document.createElement('input');
  amtIn.type = 'number'; amtIn.step = 'any'; amtIn.value = amount; amtIn.placeholder = '0.01';

  const rmBtn = document.createElement('button');
  rmBtn.className = 'btn-rm'; rmBtn.textContent = '✕';
  rmBtn.onclick = () => { row.remove(); calcDCA(); };

  row.append(dateIn, priceWrap, amtIn, rmBtn);
  container.appendChild(row);
}

function calcDCA() {
  const rows = document.querySelectorAll('#dca-rows .dca-row');
  let totalBTC = 0, totalCost = 0;

  rows.forEach(row => {
    const inputs = row.querySelectorAll('input[type="number"]');
    const p = parseFloat(inputs[0]?.value);
    const a = parseFloat(inputs[1]?.value);
    if (!isNaN(p) && !isNaN(a) && p > 0 && a > 0) {
      totalBTC  += a;
      totalCost += p * a;
    }
  });

  const p = prices[activeCur], pUSD = prices.usd;
  const rate = (p && pUSD) ? p / pUSD : 1;

  if (totalBTC === 0) {
    ['d-avg','d-btc','d-invested','d-value','d-pnl','d-roi','d-be'].forEach(id => {
      const el = document.getElementById(id);
      el.textContent = '—';
      el.className = id === 'd-avg' || id === 'd-be' ? 'val blue' : 'val';
    });
    return;
  }

  const avg    = totalCost / totalBTC;
  const valUSD = totalBTC * (pUSD || 0);
  const pnlUSD = valUSD - totalCost;
  const roi    = totalCost ? (pnlUSD / totalCost) * 100 : 0;
  const isUp   = pnlUSD > 0, isDown = pnlUSD < 0;
  const s      = signStr(pnlUSD);

  document.getElementById('d-avg').textContent      = fmtUSD(avg);
  document.getElementById('d-btc').textContent      = fmtBTC(totalBTC);
  document.getElementById('d-invested').textContent = fmtCur(totalCost * rate);
  document.getElementById('d-value').textContent    = pUSD ? fmtCur(valUSD * rate) : '—';
  document.getElementById('d-be').textContent       = fmtUSD(avg);

  const pnlEl = document.getElementById('d-pnl');
  pnlEl.textContent = pUSD ? s + fmtCur(pnlUSD * rate) : '—';
  pnlEl.className   = pUSD ? (isUp ? 'val up' : isDown ? 'val down' : 'val') : 'val';

  const roiEl = document.getElementById('d-roi');
  roiEl.textContent = pUSD ? s + roi.toFixed(2) + '%' : '—';
  roiEl.className   = pUSD ? (isUp ? 'val up' : isDown ? 'val down' : 'val') : 'val';
}

// ════════════════════════════════════════════════
//  Init
// ════════════════════════════════════════════════
addDCARow('2024-01-15', '42000', '0.05');
addDCARow('2024-03-10', '68000', '0.03');
addDCARow('2024-08-05', '55000', '0.04');

fetchPrice();
setInterval(() => fetchPrice(), 60_000);
</script>

