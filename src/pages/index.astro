let lang = 'en';
function setLang(l) {
  lang = l;
  document.querySelectorAll('.lang-btn').forEach(b =>
    b.classList.toggle('on', b.textContent.toLowerCase() === l)
  );
  applyLang();
}
function t(key) { return T[lang]?.[key] ?? T.en[key] ?? key; }
function applyLang() {
  // Update select options text
  const sel = document.getElementById('spend-freq');
  if (sel) {
    ['daily','weekly','monthly'].forEach(v => {
      const opt = sel.querySelector(`option[value="${v}"]`);
      if (opt) opt.textContent = t(v);
    });
  }
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    const txt = t(key);
    if (txt) el.innerHTML = txt.replace(/\n/g, '<br>');
  });
}

// ══════════════════════════════════════════
//  Currency
// ══════════════════════════════════════════
const CURR = {
  usd: { sym:'$', name:'USD', dec:2 },
  krw: { sym:'₩', name:'KRW', dec:0 },
  jpy: { sym:'¥', name:'JPY', dec:0 },
  eur: { sym:'€', name:'EUR', dec:2 },
  gbp: { sym:'£', name:'GBP', dec:2 },
};
let cur = 'usd';
let prices = {};
let priceData = null;

function setCur(c) {
  cur = c;
  document.querySelectorAll('.cur-btn').forEach(b =>
    b.classList.toggle('on', b.dataset.cur === c)
  );
  const sym = CURR[c].sym;
  document.getElementById('spend-sym').textContent = sym;
  refreshTicker();
  liveUpdate();
}

function fmt(n, c = cur) {
  if (n == null || isNaN(n)) return '—';
  const d = CURR[c].dec;
  return CURR[c].sym + n.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
}
function fmtUSD(n) { return fmt(n, 'usd'); }
function fmtBTC(n) {
  if (n == null || isNaN(n)) return '—';
  if (n < 0.00001) return '< 0.00001 BTC';
  return n.toFixed(8) + ' BTC';
}
function fmtBig(n, c = cur) {
  if (!n) return '—';
  const s = CURR[c].sym;
  if (n >= 1e12) return s + (n/1e12).toFixed(2) + 'T';
  if (n >= 1e9)  return s + (n/1e9).toFixed(2) + 'B';
  if (n >= 1e6)  return s + (n/1e6).toFixed(2) + 'M';
  return fmt(n, c);
}

// ══════════════════════════════════════════
//  Fetch Price
// ══════════════════════════════════════════
async function fetchPrice(manual = false) {
  try {
    const res = await fetch(
      'https://api.coingecko.com/api/v3/coins/bitcoin?localization=false&tickers=false&market_data=true&community_data=false&developer_data=false',
      { signal: AbortSignal.timeout(8000) }
    );
    if (!res.ok) throw new Error();
    const d = await res.json();
    priceData = d;
    const md = d.market_data;
    prices = { usd: md.current_price.usd, krw: md.current_price.krw, jpy: md.current_price.jpy, eur: md.current_price.eur, gbp: md.current_price.gbp };

    // Auto-fill future price input
    const fp = document.getElementById('future-price');
    if (!fp.dataset.manual) fp.value = prices.usd;

    refreshTicker();
    liveUpdate();
    document.getElementById('footer-time').textContent =
      'Updated ' + new Date().toLocaleTimeString('en-US', {hour:'2-digit',minute:'2-digit',second:'2-digit'});
  } catch(e) {
    document.getElementById('btc-ticker').textContent = 'Unavailable';
  }
}

function refreshTicker() {
  if (!priceData) return;
  const md = priceData.market_data;
  const p  = prices[cur];
  const ch = md.price_change_percentage_24h ?? 0;
  document.getElementById('btc-ticker').textContent = fmt(p);
  const chEl = document.getElementById('btc-change');
  chEl.textContent = (ch >= 0 ? '▲ +' : '▼ ') + ch.toFixed(2) + '%';
  chEl.className = ch >= 0 ? 'up' : 'down';
}

// ══════════════════════════════════════════
//  Live pre-calc (as user types)
// ══════════════════════════════════════════
function liveUpdate() {
  const amount = parseFloat(document.getElementById('spend-amount').value);
  const since  = document.getElementById('spend-since').value;
  const freq   = document.getElementById('spend-freq').value;

  if (!amount || !since) {
    ['s-count','s-total','s-daily','f-btc','f-value','f-roi'].forEach(id =>
      document.getElementById(id).textContent = '—'
    );
    return;
  }

  const start   = new Date(since);
  const now     = new Date();
  const days    = Math.max(0, Math.floor((now - start) / 86400000));
  let purchases, totalUSD;

  if (freq === 'daily')        { purchases = days; totalUSD = amount * days; }
  else if (freq === 'weekly')  { purchases = Math.floor(days / 7); totalUSD = amount * purchases; }
  else                         { purchases = Math.floor(days / 30); totalUSD = amount * purchases; }

  const dailyUSD = days > 0 ? totalUSD / days : 0;

  // Convert totalUSD to selected currency
  const rate = prices.usd && prices[cur] ? prices[cur] / prices.usd : 1;
  const totalFiat = totalUSD * rate;

  document.getElementById('s-count').textContent = purchases.toLocaleString('en-US');
  document.getElementById('s-total').textContent = fmt(totalFiat);
  document.getElementById('s-daily').textContent = fmt(dailyUSD * rate);

  // BTC equivalent
  const btcAmt  = prices.usd ? totalUSD / prices.usd : null;
  const valFiat = btcAmt != null ? btcAmt * (prices[cur] || 0) : null;
  document.getElementById('f-btc').textContent   = fmtBTC(btcAmt);
  document.getElementById('f-value').textContent = fmt(valFiat);

  const roi = (totalUSD > 0 && btcAmt) ? ((valFiat - totalFiat) / totalFiat) * 100 : 0;
  const roiEl = document.getElementById('f-roi');
  roiEl.textContent = (roi >= 0 ? '+' : '') + roi.toFixed(1) + '%';
  roiEl.className   = 'val ' + (roi > 0 ? 'green' : roi < 0 ? 'red' : 'dim');
}

// ══════════════════════════════════════════
//  CALCULATE (reveal result)
// ══════════════════════════════════════════
function calculate() {
  const amount = parseFloat(document.getElementById('spend-amount').value);
  const since  = document.getElementById('spend-since').value;
  const freq   = document.getElementById('spend-freq').value;
  const years  = parseFloat(document.getElementById('future-years').value) || 5;
  const btcNow = parseFloat(document.getElementById('future-price').value) || prices.usd || 0;

  if (!amount || !since) { alert(t('calc_err')); return; }

  const start   = new Date(since);
  const now     = new Date();
  const days    = Math.max(0, Math.floor((now - start) / 86400000));

  let purchases;
  if (freq === 'daily')       purchases = days;
  else if (freq === 'weekly') purchases = Math.floor(days / 7);
  else                        purchases = Math.floor(days / 30);

  const totalUSD  = amount * purchases;
  const rate      = prices.usd && prices[cur] ? prices[cur] / prices.usd : 1;
  const totalFiat = totalUSD * rate;
  const btcAmt    = btcNow > 0 ? totalUSD / btcNow : 0;
  const valFiat   = btcAmt * (prices[cur] || btcNow * rate);
  const roi       = totalUSD > 0 ? ((valFiat - totalFiat) / totalFiat) * 100 : 0;

  // Future projection: simple 2x every ~4 years (rough BTC halving model)
  const futureMultiplier = Math.pow(2, years / 4);
  const futureFiat = valFiat * futureMultiplier;

  // Populate result card
  document.getElementById('r-value').textContent = fmt(valFiat);
  document.getElementById('r-btc').textContent   = fmtBTC(btcAmt);

  const spentChip = document.getElementById('r-spent');
  spentChip.textContent = t('spent_label') + ': ' + fmt(totalFiat);
  spentChip.className   = 'result-chip chip-dim';

  const roiChip = document.getElementById('r-roi');
  roiChip.textContent = (roi >= 0 ? '+' : '') + roi.toFixed(1) + '%';
  roiChip.className   = 'result-chip ' + (roi >= 0 ? 'chip-green' : 'chip-red');

  const futureLabel = t('in_years').replace('{{n}}', years);
  document.getElementById('r-future').textContent = futureLabel + ': ' + fmtBig(futureFiat);

  const vsText = t('vs_label')
    .replace('{{total}}', fmt(totalFiat))
    .replace('{{n}}', purchases.toLocaleString('en-US'));
  document.getElementById('r-vs').innerHTML = '<span>' + vsText + '</span>';

  // Show result
  const rs = document.getElementById('result-section');
  rs.classList.add('show');
  rs.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function resetCalc() {
  document.getElementById('spend-amount').value = '7';
  document.getElementById('spend-since').value  = '';
  document.getElementById('future-years').value = '5';
  const fp = document.getElementById('future-price');
  fp.removeAttribute('data-manual');
  if (prices.usd) fp.value = prices.usd;
  document.getElementById('result-section').classList.remove('show');
  ['s-count','s-total','s-daily','f-btc','f-value','f-roi'].forEach(id =>
    document.getElementById(id).textContent = '—'
  );
}

// ══════════════════════════════════════════
//  Wallet
// ══════════════════════════════════════════
function validateWallet() {
  const addr = document.getElementById('wallet-addr').value.trim();
  const el   = document.getElementById('wallet-valid');
  if (!addr) { el.textContent = ''; el.className = 'wallet-valid'; return; }
  const valid = /^(bc1|[13])[a-zA-HJ-NP-Z0-9]{25,62}$/.test(addr);
  el.textContent = valid ? '✓ ' + t('w_valid') : '✗ ' + t('w_invalid');
  el.className   = 'wallet-valid ' + (valid ? 'ok' : 'err');
  // Persist
  if (valid) localStorage.setItem('stl_wallet', addr);
}

async function copyWallet() {
  const addr = document.getElementById('wallet-addr').value.trim();
  if (!addr) return;
  try {
    await navigator.clipboard.writeText(addr);
    const btn = document.getElementById('copy-btn');
    const original = btn.textContent;
    btn.textContent = t('copied');
    btn.classList.add('copied');
    setTimeout(() => { btn.textContent = original; btn.classList.remove('copied'); }, 2000);
  } catch(e) {}
}

// ══════════════════════════════════════════
//  Manual price override
// ══════════════════════════════════════════
document.getElementById('future-price').addEventListener('input', function() {
  this.dataset.manual = 'true';
});

// Listen for all input changes
['spend-amount','spend-since','spend-freq','future-price'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', liveUpdate);
});

// ══════════════════════════════════════════
//  Init
// ══════════════════════════════════════════
// Set default since date (1 year ago)
const oneYearAgo = new Date();
oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
document.getElementById('spend-since').value = oneYearAgo.toISOString().split('T')[0];

// Restore saved wallet
const saved = localStorage.getItem('stl_wallet');
if (saved) {
  document.getElementById('wallet-addr').value = saved;
  validateWallet();
}

applyLang();
fetchPrice();
setInterval(() => fetchPrice(), 60_000);
</script>
