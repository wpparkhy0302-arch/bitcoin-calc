---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Real-time Bitcoin calculator — price converter, P&L, and DCA tracker." />
  <title>BTC Calculator</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --blue:      #1763B6;
      --blue-h:    #1357a0;
      --blue-bg:   #eaf1fb;
      --blue-lt:   #f0f5fd;
      --green:     #05b26b;
      --green-bg:  #eafaf3;
      --red:       #f04452;
      --red-bg:    #fef0f1;
      --bg:        #ffffff;
      --bg2:       #f8f9fb;
      --bg3:       #f2f4f7;
      --border:    #dde1e7;
      --border2:   #e8eaed;
      --text:      #1a1c1e;
      --text2:     #5c6370;
      --text3:     #9ea5b0;
      --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    html { font-family: var(--font); background: var(--bg2); color: var(--text); -webkit-font-smoothing: antialiased; }
    body { min-height: 100vh; display: flex; flex-direction: column; }
    button { font-family: inherit; cursor: pointer; }
    input  { font-family: inherit; }

    /* ═══════════════════════════════════════
       NAV
    ═══════════════════════════════════════ */
    nav {
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      height: 56px;
      display: flex;
      align-items: center;
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 200;
      gap: 32px;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      flex-shrink: 0;
    }
    .nav-logo-icon {
      width: 28px;
      height: 28px;
      background: var(--blue);
      border-radius: 7px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 800;
      color: #fff;
    }
    .nav-logo-text {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 2px;
      list-style: none;
      flex: 1;
    }
    .nav-links a {
      display: block;
      padding: 6px 12px;
      font-size: 14px;
      font-weight: 500;
      color: var(--text2);
      text-decoration: none;
      border-radius: 6px;
      transition: all .15s;
    }
    .nav-links a:hover,
    .nav-links a.active { color: var(--blue); background: var(--blue-lt); }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .live-pill {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 600;
      color: var(--green);
      background: var(--green-bg);
      border: 1px solid #b7ead5;
      border-radius: 20px;
      padding: 3px 10px;
    }
    .live-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--green);
      animation: blink 2s ease-in-out infinite;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

    /* Language Switcher */
    .lang-wrap {
      display: flex;
      align-items: center;
      border: 1px solid var(--border);
      border-radius: 7px;
      overflow: hidden;
    }
    .lang-btn {
      padding: 5px 10px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text2);
      background: transparent;
      border: none;
      border-right: 1px solid var(--border);
      transition: all .12s;
    }
    .lang-btn:last-child { border-right: none; }
    .lang-btn:hover { background: var(--bg2); color: var(--blue); }
    .lang-btn.active { background: var(--blue); color: #fff; }

    /* ═══════════════════════════════════════
       PRICE SECTION
    ═══════════════════════════════════════ */
    .price-wrap {
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .price-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 20px 24px 16px;
    }

    /* Top row: BTC info + currency tabs */
    .price-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 16px;
    }

    .btc-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .btc-icon-lg {
      width: 36px;
      height: 36px;
      background: var(--blue);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 800;
      color: #fff;
      flex-shrink: 0;
    }
    .btc-name  { font-size: 16px; font-weight: 700; color: var(--text); }
    .btc-sym   { font-size: 12px; font-weight: 600; color: var(--text3); background: var(--bg3); border-radius: 4px; padding: 2px 7px; }

    /* Currency tabs inline */
    .cur-tabs {
      display: flex;
      align-items: center;
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }
    .cur-tab {
      padding: 7px 16px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text2);
      background: transparent;
      border: none;
      border-right: 1px solid var(--border);
      transition: all .12s;
    }
    .cur-tab:last-child { border-right: none; }
    .cur-tab:hover { background: var(--blue-lt); color: var(--blue); }
    .cur-tab.active { background: var(--blue); color: #fff; }

    /* Price display row */
    .price-display-row {
      display: flex;
      align-items: flex-end;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }
    .price-number {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }
    .price-number.up   { color: var(--green); }
    .price-number.down { color: var(--red); }

    .price-change-block {
      display: flex;
      flex-direction: column;
      gap: 3px;
      padding-bottom: 2px;
    }
    .change-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 10px;
      border-radius: 5px;
      font-size: 13px;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }
    .change-badge.up   { background: var(--green-bg); color: var(--green); }
    .change-badge.down { background: var(--red-bg);   color: var(--red); }
    .change-badge.neu  { background: var(--bg3);      color: var(--text3); }
    .change-time { font-size: 11px; color: var(--text3); }

    /* Stats strip */
    .stats-strip {
      display: flex;
      gap: 0;
      border: 1px solid var(--border2);
      border-radius: 8px;
      overflow: hidden;
      background: var(--bg2);
    }
    .stat-cell {
      flex: 1;
      padding: 10px 16px;
      border-right: 1px solid var(--border2);
      min-width: 100px;
    }
    .stat-cell:last-child { border-right: none; }
    .stat-cell label {
      display: block;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: var(--text3);
      margin-bottom: 4px;
    }
    .stat-cell .val {
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
      font-variant-numeric: tabular-nums;
    }
    .stat-cell .val.up   { color: var(--green); }
    .stat-cell .val.down { color: var(--red); }

    /* API error */
    .api-err-wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 8px 24px 0;
      display: none;
    }
    .api-err-inner {
      background: #fff5f5;
      border: 1px solid #fcd0d3;
      border-radius: 7px;
      padding: 9px 14px;
      font-size: 12px;
      color: var(--red);
    }

    /* ═══════════════════════════════════════
       MAIN CONTENT
    ═══════════════════════════════════════ */
    .main-wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 20px 24px;
      width: 100%;
      flex: 1;
    }

    .calc-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    @media(max-width: 960px) { .calc-grid { grid-template-columns: 1fr; } }

    /* ═══════════════════════════════════════
       CARDS
    ═══════════════════════════════════════ */
    .card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      border-bottom: 1px solid var(--border2);
      background: var(--bg2);
    }
    .card-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 7px;
    }
    .card-title-icon {
      width: 20px;
      height: 20px;
      background: var(--blue-bg);
      border-radius: 5px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      color: var(--blue);
    }
    .card-body { padding: 18px; display: flex; flex-direction: column; gap: 14px; }

    /* ═══════════════════════════════════════
       FORM ELEMENTS
    ═══════════════════════════════════════ */
    .field { display: flex; flex-direction: column; gap: 5px; }
    .field label {
      font-size: 11px;
      font-weight: 600;
      color: var(--text2);
      text-transform: uppercase;
      letter-spacing: .06em;
    }
    .field label .auto-tag {
      font-size: 10px;
      font-weight: 600;
      color: var(--blue);
      background: var(--blue-lt);
      padding: 1px 6px;
      border-radius: 3px;
      margin-left: 5px;
      text-transform: none;
      letter-spacing: 0;
    }
    .input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .input-pre, .input-suf {
      position: absolute;
      font-size: 13px;
      font-weight: 600;
      color: var(--text3);
      pointer-events: none;
      z-index: 1;
    }
    .input-pre { left: 11px; }
    .input-suf { right: 11px; }

    input[type="number"],
    input[type="date"] {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 9px 11px;
      border-radius: 7px;
      font-size: 14px;
      font-weight: 500;
      font-variant-numeric: tabular-nums;
      transition: border-color .15s, box-shadow .15s;
      -moz-appearance: textfield;
    }
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; }
    input:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(23,99,182,.1);
    }
    .with-pre input { padding-left: 26px; }
    .with-suf input { padding-right: 38px; }

    /* Divider */
    .hr { border: none; border-top: 1px solid var(--border2); }

    /* ═══════════════════════════════════════
       RESULT ROWS (table-style)
    ═══════════════════════════════════════ */
    .result-table { border: 1px solid var(--border2); border-radius: 8px; overflow: hidden; }
    .result-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 9px 13px;
      border-bottom: 1px solid var(--border2);
      gap: 8px;
    }
    .result-row:last-child { border-bottom: none; }
    .result-row:nth-child(even) { background: var(--bg2); }
    .result-row label {
      font-size: 12px;
      font-weight: 500;
      color: var(--text2);
      flex-shrink: 0;
    }
    .result-row .val {
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
      font-variant-numeric: tabular-nums;
      text-align: right;
      word-break: break-all;
    }
    .result-row .val.up   { color: var(--green); }
    .result-row .val.down { color: var(--red); }
    .result-row .val.blue { color: var(--blue); }
    .result-row .val.muted { color: var(--text3); }

    /* ═══════════════════════════════════════
       BUTTONS
    ═══════════════════════════════════════ */
    .btn-primary {
      width: 100%;
      padding: 10px;
      background: var(--blue);
      color: #fff;
      border: none;
      border-radius: 7px;
      font-size: 13px;
      font-weight: 700;
      transition: background .15s;
    }
    .btn-primary:hover { background: var(--blue-h); }

    .btn-sm {
      padding: 5px 12px;
      font-size: 12px;
      font-weight: 600;
      background: var(--bg2);
      color: var(--text2);
      border: 1px solid var(--border);
      border-radius: 6px;
      transition: all .12s;
    }
    .btn-sm:hover { border-color: var(--blue); color: var(--blue); background: var(--blue-lt); }

    .btn-rm {
      width: 22px;
      height: 22px;
      border-radius: 4px;
      background: transparent;
      border: 1px solid transparent;
      color: var(--text3);
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all .12s;
    }
    .btn-rm:hover { border-color: var(--red); color: var(--red); background: var(--red-bg); }

    /* Converter arrow */
    .conv-arrow {
      text-align: center;
      color: var(--text3);
      font-size: 14px;
      margin: -4px 0;
    }

    /* ═══════════════════════════════════════
       DCA TABLE
    ═══════════════════════════════════════ */
    .dca-table {
      border: 1px solid var(--border2);
      border-radius: 8px;
      overflow: hidden;
    }
    .dca-table-head {
      display: grid;
      grid-template-columns: 1fr 1.2fr 1fr 28px;
      gap: 8px;
      padding: 8px 12px;
      background: var(--bg2);
      border-bottom: 1px solid var(--border2);
    }
    .dca-table-head span {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: var(--text3);
    }
    #dca-rows {
      display: flex;
      flex-direction: column;
    }
    .dca-row {
      display: grid;
      grid-template-columns: 1fr 1.2fr 1fr 28px;
      gap: 8px;
      align-items: center;
      padding: 7px 12px;
      border-bottom: 1px solid var(--border2);
    }
    .dca-row:last-child { border-bottom: none; }
    .dca-row:nth-child(even) { background: var(--bg2); }
    .dca-row input { padding: 6px 9px; font-size: 12px; }
    .dca-row .with-pre input { padding-left: 20px; }
    .dca-row .input-pre { font-size: 11px; left: 8px; }

    /* DCA summary table */
    .dca-summary {
      border: 1px solid var(--border2);
      border-radius: 8px;
      overflow: hidden;
    }
    .dca-summary-head {
      padding: 9px 13px;
      background: var(--blue-bg);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: var(--blue);
      border-bottom: 1px solid #d0e1f7;
    }

    /* ═══════════════════════════════════════
       REFRESH
    ═══════════════════════════════════════ */
    .refresh-btn {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 5px 12px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--bg);
      color: var(--text2);
      font-size: 12px;
      font-weight: 500;
      transition: all .12s;
    }
    .refresh-btn:hover { border-color: var(--blue); color: var(--blue); }
    .refresh-btn.spinning .spin { display: inline-block; animation: spin .6s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ═══════════════════════════════════════
       FOOTER
    ═══════════════════════════════════════ */
    footer {
      background: var(--bg);
      border-top: 1px solid var(--border);
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
    }
    footer .foot-left { font-size: 12px; color: var(--text3); }
    footer .foot-left a { color: var(--blue); text-decoration: none; }
    footer .foot-right { font-size: 11px; color: var(--text3); }

    @media(max-width: 600px) {
      nav { padding: 0 16px; gap: 16px; }
      .nav-links { display: none; }
      .price-inner { padding: 16px; }
      .stats-strip { flex-wrap: wrap; }
      .stat-cell { min-width: 50%; }
      .main-wrap { padding: 16px; }
    }
  </style>
</head>
<body>

<!-- ══════════════════════════════════════════════
     NAVIGATION
══════════════════════════════════════════════ -->
<nav>
  <a class="nav-logo" href="#">
    <div class="nav-logo-icon">₿</div>
    <span class="nav-logo-text">BTC Calculator</span>
  </a>

  <ul class="nav-links">
    <li><a href="#" class="active" data-i18n="nav_exchange">Exchange</a></li>
    <li><a href="#" data-i18n="nav_portfolio">Portfolio</a></li>
    <li><a href="#" data-i18n="nav_guide">Guide</a></li>
  </ul>

  <div class="nav-right">
    <div class="live-pill">
      <span class="live-dot"></span>
      <span data-i18n="live">Live</span>
    </div>
    <button class="refresh-btn" id="refresh-btn" onclick="fetchPrice(true)">
      <span class="spin">↻</span>
      <span data-i18n="refresh">Refresh</span>
    </button>
    <div class="lang-wrap">
      <button class="lang-btn active" onclick="setLang('en')">EN</button>
      <button class="lang-btn"        onclick="setLang('ko')">KO</button>
      <button class="lang-btn"        onclick="setLang('ja')">JA</button>
    </div>
  </div>
</nav>

<!-- ══════════════════════════════════════════════
     PRICE SECTION
══════════════════════════════════════════════ -->
<div class="price-wrap">
  <div class="price-inner">

    <!-- BTC label + currency tabs on the same row -->
    <div class="price-top-row">
      <div class="btc-info">
        <div class="btc-icon-lg">₿</div>
        <span class="btc-name" data-i18n="bitcoin">Bitcoin</span>
        <span class="btc-sym">BTC</span>
      </div>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <span style="font-size:11px;font-weight:600;color:var(--text3);" data-i18n="currency">Currency</span>
        <div class="cur-tabs">
          <button class="cur-tab active" data-cur="usd" onclick="setCurrency('usd')">USD</button>
          <button class="cur-tab"        data-cur="krw" onclick="setCurrency('krw')">KRW</button>
          <button class="cur-tab"        data-cur="jpy" onclick="setCurrency('jpy')">JPY</button>
          <button class="cur-tab"        data-cur="eur" onclick="setCurrency('eur')">EUR</button>
          <button class="cur-tab"        data-cur="gbp" onclick="setCurrency('gbp')">GBP</button>
        </div>
      </div>
    </div>

    <!-- Price display -->
    <div class="price-display-row">
      <span class="price-number" id="price-main">—</span>
      <div class="price-change-block">
        <span class="change-badge neu" id="price-change">—</span>
        <span class="change-time" id="price-time">—</span>
      </div>
    </div>

    <!-- Stats strip -->
    <div class="stats-strip">
      <div class="stat-cell">
        <label data-i18n="high24">24H High</label>
        <div class="val up" id="s-high">—</div>
      </div>
      <div class="stat-cell">
        <label data-i18n="low24">24H Low</label>
        <div class="val down" id="s-low">—</div>
      </div>
      <div class="stat-cell">
        <label data-i18n="mcap">Market Cap</label>
        <div class="val" id="s-mcap">—</div>
      </div>
      <div class="stat-cell">
        <label data-i18n="vol24">24H Volume</label>
        <div class="val" id="s-vol">—</div>
      </div>
      <div class="stat-cell">
        <label>BTC / USD</label>
        <div class="val" id="s-usd">—</div>
      </div>
      <div class="stat-cell">
        <label data-i18n="ath">All-Time High</label>
        <div class="val" id="s-ath">—</div>
      </div>
    </div>
  </div>
</div>

<!-- API Error -->
<div class="api-err-wrap" id="api-err">
  <div class="api-err-inner" data-i18n="api_err">
    ⚠ API unavailable — CoinGecko free tier rate limit or network error. Retrying automatically.
  </div>
</div>

<!-- ══════════════════════════════════════════════
     CALCULATORS
══════════════════════════════════════════════ -->
<div class="main-wrap">
  <div class="calc-grid">

    <!-- ── Card 1: Converter ── -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">
          <span class="card-title-icon">⇄</span>
          <span data-i18n="conv_title">Converter</span>
        </span>
      </div>
      <div class="card-body">

        <div class="field">
          <label data-i18n="bitcoin">Bitcoin</label>
          <div class="input-wrap with-suf">
            <input type="number" id="c-btc" placeholder="0.00000000" step="any" oninput="convFrom('btc')" />
            <span class="input-suf">BTC</span>
