---
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KMVG0NPRG5"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-KMVG0NPRG5');
  </script>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="description" content={post.data.description}/>
  <title>{post.data.title} — SkipTheLatte</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2204132369832933" crossorigin="anonymous"></script>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{--blue:#1763B6;--border:#e5e8eb;--bg:#fff;--bg2:#f7f8fa;--text:#0a0a0a;--text2:#5c6370;--font:'Inter',-apple-system,sans-serif}
    html{font-family:var(--font);background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
    body{min-height:100vh;display:flex;flex-direction:column}
    a{text-decoration:none;color:var(--blue)}
    nav{background:var(--bg);border-bottom:1px solid var(--border);height:56px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;position:sticky;top:0;z-index:100}
    .nav-logo{font-size:16px;font-weight:800;color:var(--text);letter-spacing:-.02em;display:flex;align-items:center;gap:8px}
    .nd{width:7px;height:7px;border-radius:50%;background:var(--blue)}
    .nav-links{display:flex;gap:4px}
    .nl{padding:5px 12px;font-size:13px;font-weight:500;color:var(--text2);border-radius:7px;transition:all .12s}
    .nl:hover{color:var(--blue);background:#eaf1fb}

    .container{max-width:720px;margin:0 auto;padding:48px 24px 80px;flex:1}
    .post-meta{font-size:12px;color:var(--text2);margin-bottom:12px;display:flex;align-items:center;gap:8px}
    .post-meta::before{content:'';width:14px;height:2px;background:var(--blue)}
    h1{font-size:clamp(28px,5vw,44px);font-weight:900;letter-spacing:-.03em;line-height:1.1;margin-bottom:20px}
    .desc{font-size:17px;color:var(--text2);line-height:1.65;margin-bottom:36px;padding-bottom:32px;border-bottom:1px solid var(--border)}

    /* Ad slot */
    .ad-slot{background:var(--bg2);border:1px dashed var(--border);border-radius:10px;min-height:90px;margin:32px 0;display:flex;align-items:center;justify-content:center;padding:8px}

    /* Article content */
    .content h2{font-size:22px;font-weight:800;color:var(--text);margin:36px 0 14px;letter-spacing:-.01em}
    .content h3{font-size:18px;font-weight:700;color:var(--text);margin:28px 0 10px}
    .content p{font-size:16px;line-height:1.75;color:#334155;margin-bottom:18px}
    .content ul,.content ol{padding-left:22px;margin-bottom:18px;display:flex;flex-direction:column;gap:8px}
    .content li{font-size:16px;line-height:1.65;color:#334155}
    .content strong{color:var(--text);font-weight:700}

    .back-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--blue);margin-top:32px;padding:8px 14px;border:1px solid var(--border);border-radius:8px;transition:all .12s}
    .back-link:hover{background:#eaf1fb;border-color:var(--blue)}

    footer{background:var(--bg2);border-top:1px solid var(--border);padding:20px 24px;text-align:center;font-size:12px;color:var(--text2)}
  </style>
</head>
<body>
<nav>
  <a class="nav-logo" href="/"><span class="nd"></span>SkipTheLatte</a>
  <div class="nav-links">
    <a href="/" class="nl">Calculator</a>
    <a href="/freedom" class="nl">Freedom Planner</a>
    <a href="/blog" class="nl">Blog</a>
    <a href="/faq" class="nl">FAQ</a>
  </div>
</nav>

<div class="container">
  <div class="post-meta">{fmtDate(post.data.pubDate)}</div>
  <h1>{post.data.title}</h1>
  <p class="desc">{post.data.description}</p>

  <!-- Ad: Above article -->
  <div class="ad-slot">
    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2204132369832933" data-ad-slot="5555555555" data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>

  <article class="content">
    <Content/>
  </article>

  <!-- Ad: Below article -->
  <div class="ad-slot">
    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2204132369832933" data-ad-slot="6666666666" data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>

  <a href="/blog" class="back-link">← Back to Blog</a>
</div>

<footer>© 2026 SkipTheLatte · For informational purposes only · Not financial advice</footer>
</body>
</html>
