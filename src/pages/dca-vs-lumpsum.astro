<script is:inline>
const CURR = {
  usd:{sym:'$',  name:'USD',dec:2}, eur:{sym:'€',  name:'EUR',dec:2},
  gbp:{sym:'£',  name:'GBP',dec:2}, krw:{sym:'₩',  name:'KRW',dec:0},
  jpy:{sym:'¥',  name:'JPY',dec:0}, cad:{sym:'C$', name:'CAD',dec:2},
  aud:{sym:'A$', name:'AUD',dec:2}, sgd:{sym:'S$', name:'SGD',dec:2},
  hkd:{sym:'HK$',name:'HKD',dec:2}, aed:{sym:'د.إ',name:'AED',dec:2},
  inr:{sym:'₹',  name:'INR',dec:0},
};
const SCENARIOS = {
  bear:{cagr:10,label:'Bear Case'}, base:{cagr:21,label:'Base Case'},
  bull:{cagr:35,label:'Bull Case'}, hyperbull:{cagr:55,label:'Hyperbull'},
};
const HINTS = {
  backtest:"What would have actually happened if you'd invested in the past — using real BTC price history.",
  projection:"What could happen from today, compounding at an expected annual return — lump sum now vs DCA over time.",
};

let cur = 'usd';
let prices = {}, priceData = {change24h:0}, ratesExpiry = 0;
const RATES_TTL = 5 * 60 * 1000;
let activeFreq = 'weekly';
let activeMode = 'backtest';
let historicalCache = null;

// ── YEAR DROPDOWNS ────────────────────────────────────────
(function initYears(){
  const startSel = document.getElementById('start-year');
  const endSel   = document.getElementById('end-year');
  const curYear  = new Date().getFullYear();
  for(let y = 2010; y <= curYear; y++){
    const o1 = document.createElement('option');
    o1.value = y; o1.textContent = y;
    if(y === 2020) o1.selected = true;
    startSel.appendChild(o1);
    const o2 = document.createElement('option');
    o2.value = y; o2.textContent = y;
    if(y === curYear) o2.selected = true;
    endSel.appendChild(o2);
  }
})();

// ── SLIDER HELPERS ────────────────────────────────────────
function setPct(el){
  const pct = ((el.value - el.min) / (el.max - el.min) * 100).toFixed(1) + '%';
  el.style.setProperty('--pct', pct);
}

const horizonSlider = document.getElementById('horizon-slider');
const cagrSlider    = document.getElementById('cagr-slider');

horizonSlider.addEventListener('input', function(){
  setPct(this);
  document.getElementById('horizon-val').textContent = this.value;
  document.getElementById('horizon-year').textContent = '→ ' + (new Date().getFullYear() + +this.value);
});

cagrSlider.addEventListener('input', function(){
  setPct(this);
  const v = +this.value;
  document.getElementById('cagr-val').textContent = v;
  let matched = null;
  document.querySelectorAll('.sc-btn').forEach(b => {
    if(SCENARIOS[b.dataset.sc]?.cagr === v) matched = b.dataset.sc;
    b.classList.remove('on');
  });
  if(matched) document.querySelector(`.sc-btn[data-sc="${matched}"]`).classList.add('on');
  const label = matched ? SCENARIOS[matched].label
    : v <= 15 ? 'Bear Case' : v <= 28 ? 'Base Case' : v <= 45 ? 'Bull Case' : 'Hyperbull';
  document.getElementById('cagr-label').textContent = label;
});

document.querySelectorAll('.sc-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const sc = SCENARIOS[btn.dataset.sc];
    cagrSlider.value = sc.cagr;
    setPct(cagrSlider);
    document.getElementById('cagr-val').textContent = sc.cagr;
    document.getElementById('cagr-label').textContent = sc.label;
    document.querySelectorAll('.sc-btn').forEach(b => b.classList.toggle('on', b === btn));
  });
});

setPct(horizonSlider);
setPct(cagrSlider);
document.getElementById('horizon-year').textContent = '→ ' + (new Date().getFullYear() + 10);

// ── MODE SWITCH ───────────────────────────────────────────
document.getElementById('modeswitch').addEventListener('click', e => {
  const btn = e.target.closest('.msw-btn');
  if(!btn) return;
  activeMode = btn.dataset.m;
  document.body.dataset.mode = activeMode;
  document.getElementById('modehint').textContent = HINTS[activeMode];
  document.querySelectorAll('.msw-btn').forEach(b => b.classList.toggle('on', b === btn));
  document.getElementById('results').style.display = 'none';
});

// ── FREQUENCY PILLS ───────────────────────────────────────
document.getElementById('freq-group').addEventListener('click', e => {
  const btn = e.target.closest('.pill-btn');
  if(!btn) return;
  document.querySelectorAll('#freq-group .pill-btn').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  activeFreq = btn.dataset.freq;
});

// ── CURRENCY ──────────────────────────────────────────────
document.getElementById('currency-select').addEventListener('change', function(){
  cur = this.value;
  document.getElementById('currency-symbol').textContent = CURR[cur].sym;
});

// ── NAV PRICE (CoinGecko) ─────────────────────────────────
async function fetchNavPrice(){
  const now = Date.now();
  if(now < ratesExpiry && prices.usd){ updateTicker(); return; }
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 9000);
  try{
    const r = await fetch(
      'https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd,krw,jpy,eur,gbp,cad,aud,sgd,hkd,aed,inr&include_24hr_change=true',
      { signal: ctrl.signal }
    );
    clearTimeout(timer);
    if(!r.ok) throw new Error('HTTP ' + r.status);
    const d = await r.json();
    const b = d.bitcoin;
    prices = {usd:b.usd,krw:b.krw,jpy:b.jpy,eur:b.eur,gbp:b.gbp,cad:b.cad,aud:b.aud,sgd:b.sgd,hkd:b.hkd,aed:b.aed,inr:b.inr};
    priceData = {change24h: b.usd_24h_change ?? 0};
    ratesExpiry = Date.now() + RATES_TTL;
    updateTicker();
  }catch(e){
    clearTimeout(timer);
    const np = document.getElementById('nav-btc-price');
    if(np) np.textContent = 'API Error';
  }
}

function updateTicker(){
  const np = document.getElementById('nav-btc-price');
  const nc = document.getElementById('nav-btc-change');
  if(!np || !prices.usd) return;
  np.textContent = '$' + prices.usd.toLocaleString('en-US', {maximumFractionDigits:0});
  if(nc){
    const ch = priceData.change24h ?? 0;
    nc.textContent = (ch >= 0 ? '▲' : '▼') + Math.abs(ch).toFixed(2) + '%';
    nc.style.color = ch >= 0 ? 'var(--green)' : 'var(--red)';
  }
}

// ── BINANCE PRICE (projection starting point) ─────────────
async function fetchBinancePrice(){
  const btn = document.getElementById('btn-refresh');
  if(btn) btn.classList.add('spin');
  try{
    const r = await fetch('https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT');
    if(!r.ok) throw new Error('HTTP ' + r.status);
    const d = await r.json();
    const p = Math.round(parseFloat(d.price));
    const pi = document.getElementById('btc-price-input');
    if(pi) pi.value = p;
    if(!prices.usd) prices.usd = p;
    updateTicker();
  }catch(e){
    console.warn('Binance fallback to CoinGecko:', e.message);
    await fetchNavPrice();
    const pi = document.getElementById('btc-price-input');
    if(pi && prices.usd && !pi.value) pi.value = Math.round(prices.usd);
  }finally{
    if(btn) btn.classList.remove('spin');
  }
}

document.getElementById('btn-refresh').addEventListener('click', fetchBinancePrice);

// ── HISTORICAL DATA (CoinGecko) ───────────────────────────
async function fetchHistoricalPrices(){
  if(historicalCache) return historicalCache;
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 20000);
  try{
    const r = await fetch(
      'https://api.coingecko.com/api/v3/coins/bitcoin/market_chart?vs_currency=usd&days=max&interval=daily',
      { signal: ctrl.signal }
    );
    clearTimeout(timer);
    if(!r.ok) throw new Error('HTTP ' + r.status);
    const d = await r.json();
    historicalCache = d.prices.map(([ts, price]) => ({ date: new Date(ts), priceUSD: price }));
    return historicalCache;
  }catch(e){
    clearTimeout(timer);
    throw e;
  }
}

// ── FORMAT HELPERS ────────────────────────────────────────
function fmtMoney(usd, fxRate){
  const val = usd * fxRate;
  const d   = CURR[cur].dec;
  return CURR[cur].sym + val.toLocaleString('en-US', {minimumFractionDigits:d, maximumFractionDigits:d});
}
function fmtBTC(v){
  return v < 0.001 ? (v * 1e8).toFixed(0) + ' sats' : v.toFixed(8) + ' BTC';
}
function fmtK(v, sym){
  if(v >= 1e9) return sym + (v/1e9).toFixed(1) + 'B';
  if(v >= 1e6) return sym + (v/1e6).toFixed(1) + 'M';
  if(v >= 1e3) return sym + (v/1e3).toFixed(0) + 'K';
  return sym + v.toFixed(0);
}

// ── DCA PURCHASE DATE LIST ────────────────────────────────
function buildPurchaseDates(rangeData, freq){
  const dates = [];
  const first = rangeData[0].date;
  const last  = rangeData[rangeData.length - 1].date;
  let d = new Date(first);
  while(d <= last){
    dates.push(new Date(d));
    if(freq === 'daily')       d.setDate(d.getDate() + 1);
    else if(freq === 'weekly') d.setDate(d.getDate() + 7);
    else                       d.setMonth(d.getMonth() + 1);
  }
  return dates;
}

// ── INTERPOLATE PRICE ─────────────────────────────────────
function interpolatePrice(rangeData, targetDate){
  for(let i = 0; i < rangeData.length - 1; i++){
    const a = rangeData[i], b = rangeData[i + 1];
    if(targetDate >= a.date && targetDate <= b.date){
      const t = (targetDate - a.date) / (b.date - a.date);
      return a.priceUSD + t * (b.priceUSD - a.priceUSD);
    }
  }
  if(targetDate <= rangeData[0].date) return rangeData[0].priceUSD;
  return rangeData[rangeData.length - 1].priceUSD;
}

// ── BACKTEST CHART SERIES (monthly sample) ────────────────
function buildBacktestChart(rangeData, purchaseDates, perPurchaseUSD, lsBTC){
  let dcaBTCCum = 0;
  const purchaseMap = {};
  for(const pd of purchaseDates){
    const key = pd.toISOString().slice(0, 7);
    const p   = interpolatePrice(rangeData, pd);
    if(p > 0) dcaBTCCum += perPurchaseUSD / p;
    purchaseMap[key] = dcaBTCCum;
  }
  const points = [];
  const seen   = new Set();
  let lastDCA  = 0;
  for(const point of rangeData){
    const key = point.date.toISOString().slice(0, 7);
    if(seen.has(key)) continue;
    seen.add(key);
    if(purchaseMap[key] !== undefined) lastDCA = purchaseMap[key];
    points.push({ label: key, dcaValue: lastDCA * point.priceUSD, lsValue: lsBTC * point.priceUSD });
  }
  return points;
}

// ── MAIN CALC ─────────────────────────────────────────────
async function runCalc(){
  const errEl = document.getElementById('err-msg');
  errEl.classList.remove('show');
  const totalInvest = parseFloat(document.getElementById('total-amount').value) || 0;
  if(totalInvest <= 0){
    errEl.textContent = 'Please enter an amount above 0.';
    errEl.classList.add('show');
    return;
  }
  if(activeMode === 'backtest') await runBacktest(totalInvest, errEl);
  else                          runProjection(totalInvest, errEl);
}

async function runBacktest(totalInvest, errEl){
  const startYear = parseInt(document.getElementById('start-year').value);
  const endYear   = parseInt(document.getElementById('end-year').value);
  if(startYear >= endYear){
    errEl.textContent = 'End year must be after start year.';
    errEl.classList.add('show');
    return;
  }
  const overlay = document.getElementById('loading-overlay');
  overlay.classList.add('show');
  try{
    const allData = await fetchHistoricalPrices();
    await fetchNavPrice();
    const fxRate    = (prices.usd && prices[cur]) ? prices[cur] / prices.usd : 1;
    const startDate = new Date(startYear, 0, 1);
    const endDate   = new Date(endYear, 11, 31);
    const rangeData = allData.filter(p => p.date >= startDate && p.date <= endDate);
    if(rangeData.length < 2){
      errEl.textContent = 'Not enough data for this range.';
      errEl.classList.add('show');
      return;
    }
    const totalUSD        = totalInvest / fxRate;
    const lsEntryPriceUSD = rangeData[0].priceUSD;
    const lsBTC           = totalUSD / lsEntryPriceUSD;
    const lsFinalPriceUSD = rangeData[rangeData.length - 1].priceUSD;
    const lsFinalValueUSD = lsBTC * lsFinalPriceUSD;

    const purchaseDates   = buildPurchaseDates(rangeData, activeFreq);
    const perPurchaseUSD  = totalUSD / purchaseDates.length;
    let dcaBTC = 0, dcaSpentUSD = 0;
    for(const pd of purchaseDates){
      const p = interpolatePrice(rangeData, pd);
      if(p > 0){ dcaBTC += perPurchaseUSD / p; dcaSpentUSD += perPurchaseUSD; }
    }
    const dcaAvgUSD    = dcaSpentUSD / dcaBTC;
    const dcaFinalUSD  = dcaBTC * lsFinalPriceUSD;
    const chartPoints  = buildBacktestChart(rangeData, purchaseDates, perPurchaseUSD, lsBTC);

    renderResults({
      mode:'backtest', cur, fxRate, totalInvest,
      dcaBTC, dcaAvgUSD, dcaFinalUSD, dcaInvestedUSD: dcaSpentUSD,
      lsBTC, lsEntryUSD: lsEntryPriceUSD, lsFinalUSD: lsFinalValueUSD, lsInvestedUSD: totalUSD,
      chartPoints,
    });
  }catch(e){
    errEl.textContent = 'Failed to fetch historical data. Please try again.';
    errEl.classList.add('show');
    console.error(e);
  }finally{
    overlay.classList.remove('show');
  }
}

function runProjection(totalInvest, errEl){
  const piEl = document.getElementById('btc-price-input');
  const P0   = parseFloat((piEl.value || '').replace(/[^0-9.]/g, '')) || prices.usd || 0;
  if(!P0){
    errEl.textContent = 'Live BTC price not loaded. Click ↻ to refresh.';
    errEl.classList.add('show');
    return;
  }
  const fxRate      = (prices.usd && prices[cur]) ? prices[cur] / prices.usd : 1;
  const totalUSD    = totalInvest / fxRate;
  const N           = parseInt(document.getElementById('horizon-slider').value);
  const cagr        = parseFloat(document.getElementById('cagr-slider').value) / 100;
  const stepsPerYr  = activeFreq === 'daily' ? 365 : activeFreq === 'weekly' ? 52 : 12;
  const totalSteps  = N * stepsPerYr;
  const perStep     = totalUSD / totalSteps;
  const lsBTC       = totalUSD / P0;

  // Calculate DCA BTC accumulated at each step; sample monthly for chart
  let dcaBTC = 0;
  const chartMap = new Map(); // monthIndex → cumulative dcaBTC
  for(let k = 0; k < totalSteps; k++){
    const t  = k / stepsPerYr;
    const pt = P0 * Math.pow(1 + cagr, t);
    dcaBTC  += perStep / pt;
    chartMap.set(Math.floor(t * 12), dcaBTC);
  }

  const PN         = P0 * Math.pow(1 + cagr, N);
  const dcaFinalUSD = dcaBTC * PN;
  const lsFinalUSD  = lsBTC  * PN;
  const dcaAvgUSD   = totalUSD / dcaBTC;
  const curYear     = new Date().getFullYear();

  const chartPoints = [];
  let lastDCA = 0;
  for(let m = 0; m <= N * 12; m++){
    if(chartMap.has(m)) lastDCA = chartMap.get(m);
    const t  = m / 12;
    const pt = P0 * Math.pow(1 + cagr, t);
    const yr = curYear + Math.floor(m / 12);
    const mo = String((m % 12) + 1).padStart(2, '0');
    chartPoints.push({ label: `${yr}-${mo}`, dcaValue: lastDCA * pt, lsValue: lsBTC * pt });
  }

  renderResults({
    mode:'projection', cur, fxRate, totalInvest, N,
    dcaBTC, dcaAvgUSD, dcaFinalUSD, dcaInvestedUSD: totalUSD,
    lsBTC, lsEntryUSD: P0, lsFinalUSD, lsInvestedUSD: totalUSD,
    chartPoints,
  });
}

// ── RENDER RESULTS ────────────────────────────────────────
function renderResults(r){
  const fmt = usd => fmtMoney(usd, r.fxRate);
  const sym = CURR[r.cur].sym;
  const dcaReturn = (r.dcaFinalUSD - r.dcaInvestedUSD) / r.dcaInvestedUSD * 100;
  const lsReturn  = (r.lsFinalUSD  - r.lsInvestedUSD)  / r.lsInvestedUSD  * 100;

  // Label tuning per mode
  if(r.mode === 'backtest'){
    document.getElementById('dca-l1').textContent    = 'BTC Accumulated';
    document.getElementById('dca-l2').textContent    = 'Avg Buy Price';
    document.getElementById('ls-l1').textContent     = 'BTC Accumulated';
    document.getElementById('ls-l2').textContent     = 'Buy Price (Day 1)';
    document.getElementById('dca-value-sub').textContent = 'Final Portfolio Value';
    document.getElementById('ls-value-sub').textContent  = 'Final Portfolio Value';
    document.getElementById('chart-title').textContent   = 'Portfolio Growth Comparison';
  } else {
    document.getElementById('dca-l1').textContent    = 'BTC Accumulated';
    document.getElementById('dca-l2').textContent    = 'Avg Buy Price';
    document.getElementById('ls-l1').textContent     = 'BTC Accumulated';
    document.getElementById('ls-l2').textContent     = 'Entry Price (Now)';
    document.getElementById('dca-value-sub').textContent = `Projected Value in ${r.N} yrs`;
    document.getElementById('ls-value-sub').textContent  = `Projected Value in ${r.N} yrs`;
    document.getElementById('chart-title').textContent   = `Projected Growth Over ${r.N} Years`;
  }

  document.getElementById('dca-value').textContent  = fmt(r.dcaFinalUSD);
  document.getElementById('dca-v1').textContent     = fmtBTC(r.dcaBTC);
  document.getElementById('dca-v2').textContent     = '$' + r.dcaAvgUSD.toLocaleString('en-US', {maximumFractionDigits:0});
  document.getElementById('dca-v3').textContent     = fmt(r.dcaInvestedUSD);
  document.getElementById('dca-return').textContent = (dcaReturn >= 0 ? '+' : '') + dcaReturn.toFixed(1) + '%';

  document.getElementById('ls-value').textContent   = fmt(r.lsFinalUSD);
  document.getElementById('ls-v1').textContent      = fmtBTC(r.lsBTC);
  document.getElementById('ls-v2').textContent      = '$' + r.lsEntryUSD.toLocaleString('en-US', {maximumFractionDigits:0});
  document.getElementById('ls-v3').textContent      = fmt(r.lsInvestedUSD);
  document.getElementById('ls-return').textContent  = (lsReturn >= 0 ? '+' : '') + lsReturn.toFixed(1) + '%';

  // Winner highlighting
  const dcaCard  = document.getElementById('dca-card');
  const lsCard   = document.getElementById('ls-card');
  const dcaBadge = document.getElementById('dca-badge');
  const lsBadge  = document.getElementById('ls-badge');
  const banner   = document.getElementById('conclusion-banner');
  dcaCard.classList.remove('winner', 'loser');
  lsCard.classList.remove('winner', 'loser');
  dcaBadge.style.display = 'none';
  lsBadge.style.display  = 'none';

  const diff    = Math.abs(r.dcaFinalUSD - r.lsFinalUSD);
  const diffPct = (diff / Math.min(r.dcaFinalUSD, r.lsFinalUSD) * 100).toFixed(1);

  if(r.dcaFinalUSD >= r.lsFinalUSD){
    dcaCard.classList.add('winner'); lsCard.classList.add('loser');
    dcaBadge.style.display = 'inline-block';
    banner.className = 'conclusion-banner dca-wins';
    document.getElementById('conclusion-icon').textContent  = '📈';
    document.getElementById('conclusion-title').textContent = r.mode === 'backtest' ? 'DCA wins this round!' : 'DCA projects higher!';
    document.getElementById('conclusion-sub').textContent   = r.mode === 'backtest'
      ? `DCA outperformed lump sum by ${fmt(diff)} (+${diffPct}%) over this period. Regular buying smoothed volatility and lowered avg cost basis.`
      : `DCA projects ${fmt(diff)} (+${diffPct}%) more than lump sum over ${r.N} years at this CAGR.`;
  } else {
    lsCard.classList.add('winner'); dcaCard.classList.add('loser');
    lsBadge.style.display = 'inline-block';
    banner.className = 'conclusion-banner ls-wins';
    document.getElementById('conclusion-icon').textContent  = '⚡';
    document.getElementById('conclusion-title').textContent = r.mode === 'backtest' ? 'Lump Sum wins this round!' : 'Lump Sum projects higher!';
    document.getElementById('conclusion-sub').textContent   = r.mode === 'backtest'
      ? `Lump sum outperformed DCA by ${fmt(diff)} (+${diffPct}%) over this period. An early large position captured more price appreciation.`
      : `Lump sum projects ${fmt(diff)} (+${diffPct}%) more than DCA over ${r.N} years — deploying capital early captures the full compounding period.`;
  }

  document.getElementById('results').style.display = 'block';
  drawChart(r.chartPoints, sym, r.fxRate);
  document.getElementById('results').scrollIntoView({ behavior:'smooth', block:'start' });
}

// ── CHART ─────────────────────────────────────────────────
function drawChart(points, sym, rate){
  const canvas = document.getElementById('chart');
  const dpr    = window.devicePixelRatio || 1;
  const W      = canvas.parentElement.clientWidth - 48;
  const H      = 300;
  canvas.width  = W * dpr;
  canvas.height = H * dpr;
  canvas.style.width  = W + 'px';
  canvas.style.height = H + 'px';
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);
  const PAD = {top:20, right:20, bottom:50, left:72};
  const cW  = W - PAD.left - PAD.right;
  const cH  = H - PAD.top  - PAD.bottom;
  const dcaVals = points.map(p => p.dcaValue * rate);
  const lsVals  = points.map(p => p.lsValue  * rate);
  const maxVal  = Math.max(...dcaVals, ...lsVals, 1);
  const minVal  = Math.min(0, ...dcaVals, ...lsVals);
  const xScale  = i => PAD.left + (i / (points.length - 1)) * cW;
  const yScale  = v => PAD.top  + (1 - (v - minVal) / (maxVal - minVal)) * cH;

  ctx.strokeStyle = '#e5e8eb'; ctx.lineWidth = 1;
  for(let i = 0; i <= 5; i++){
    const y = PAD.top + (i / 5) * cH;
    ctx.beginPath(); ctx.moveTo(PAD.left, y); ctx.lineTo(PAD.left + cW, y); ctx.stroke();
    const val = maxVal - (i / 5) * (maxVal - minVal);
    ctx.fillStyle = '#9ea5b0'; ctx.font = '10px Inter,sans-serif';
    ctx.textAlign = 'right';
    ctx.fillText(fmtK(val, sym), PAD.left - 6, y + 4);
  }

  ctx.textAlign = 'center'; ctx.fillStyle = '#9ea5b0'; ctx.font = '10px Inter,sans-serif';
  const step = Math.max(1, Math.floor(points.length / 10));
  for(let i = 0; i < points.length; i += step){
    ctx.fillText(points[i].label.slice(0, 7), xScale(i), H - PAD.bottom + 16);
  }

  [['#f59e0b', lsVals], ['#1763B6', dcaVals]].forEach(([color, vals]) => {
    ctx.strokeStyle = color; ctx.lineWidth = 2.5; ctx.lineJoin = 'round'; ctx.lineCap = 'round';
    ctx.beginPath();
    vals.forEach((v, i) => { const x = xScale(i), y = yScale(v); i === 0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y); });
    ctx.stroke();
  });

  ctx.strokeStyle = '#dde1e7'; ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(PAD.left, PAD.top); ctx.lineTo(PAD.left, PAD.top + cH); ctx.lineTo(PAD.left + cW, PAD.top + cH);
  ctx.stroke();
}

// ── COPY WALLET ───────────────────────────────────────────
function copyWallet(id, btn){
  navigator.clipboard.writeText(document.getElementById(id).textContent).then(() => {
    const orig = btn.textContent;
    btn.textContent = 'Copied!'; btn.classList.add('done');
    setTimeout(() => { btn.textContent = orig; btn.classList.remove('done'); }, 2000);
  }).catch(() => {});
}

