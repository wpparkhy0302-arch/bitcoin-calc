<script is:inline define:vars={{ btcHistory }}>
/* ─── STATIC PRICE DATA ────────────────────────────────────── */
const BTC_HISTORY = btcHistory.map(({date, price}) => ({
  date: new Date(date + 'T00:00:00Z'),
  priceUSD: price
}));

/* ─── CONSTANTS ────────────────────────────────────────────── */
const FIRST_YEAR = BTC_HISTORY.length ? BTC_HISTORY[0].date.getFullYear() : 2017;
const NOW_YEAR   = new Date().getFullYear();
const CAGR_NAMES = {10:'Bear Case', 21:'Base Case', 35:'Bull Case', 55:'Hyperbull'};
const HINTS = {
  backtest:   "What would have actually happened if you'd invested in the past — using real BTC price history.",
  projection: "What could happen from today, compounding at an expected annual return — lump sum now vs DCA over time."
};
// Fallback rates (1 USD = N units) in case API fails
const FALLBACK_RATES = {USD:1, KRW:1380, JPY:157, EUR:0.92, GBP:0.79,
                        CAD:1.36, AUD:1.54, SGD:1.34, HKD:7.78, AED:3.67, INR:84};

/* ─── STATE ────────────────────────────────────────────────── */
let currentPriceUSD = 0;   // BTC price in USD (from Binance)
let fxRateUSD       = 1;   // 1 USD = N units of selected currency
let fxRatesCache    = {};
let fxRatesExpiry   = 0;
let mode = 'backtest';
let freq = 'weekly';
let cagr = 0.21;
let navPricesCache = null;
let navRatesExpiry = 0;

/* ─── HELPERS ──────────────────────────────────────────────── */
const $        = s => document.querySelector(s);
const getCur = () => $('#currency').value || 'USD';
function curSym() {
  try {
    return new Intl.NumberFormat('en-US', {style:'currency', currency:getCur(), maximumFractionDigits:0})
      .formatToParts(0).find(p => p.type === 'currency')?.value || '';
  } catch(e) { return ''; }
}
const parseAmt = () => parseFloat(($('#amount').value||'').replace(/[^0-9.]/g,'')) || 0;

// Investment amount → USD (user enters in selected currency)
const parseAmtUSD = () => fxRateUSD > 0 ? parseAmt() / fxRateUSD : parseAmt();

// USD amount → display string in selected currency
function money(usdAmt) {
  try {
    return new Intl.NumberFormat('en-US', {
      style: 'currency', currency: getCur(), maximumFractionDigits: 0
    }).format(usdAmt * fxRateUSD);
  } catch(e) {
    return Math.round(usdAmt * fxRateUSD).toLocaleString();
  }
}
const btcFmt = n => `${parseFloat(n.toFixed(8))} BTC`;

/* ─── FX RATES ─────────────────────────────────────────────── */
async function fetchFxRates() {
  const now = Date.now();
  if (now < fxRatesExpiry && Object.keys(fxRatesCache).length) return fxRatesCache;
  try {
    const ctrl  = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 8000);
    const r = await fetch('https://open.er-api.com/v6/latest/USD', {signal: ctrl.signal});
    clearTimeout(timer);
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const d = await r.json();
    fxRatesCache = d.rates;
    fxRatesExpiry = Date.now() + 3600 * 1000; // 1 hour
    return fxRatesCache;
  } catch(e) {
    console.warn('FX rates fallback:', e.message);
    return FALLBACK_RATES;
  }
}

// Call whenever currency changes or on init
async function applyFxRate() {
  const cur   = getCur();
  const rates = await fetchFxRates();
  fxRateUSD   = rates[cur] || FALLBACK_RATES[cur] || 1;

  // Update all currency symbols in the UI
  $('#curSym').textContent         = curSym();
  $('#btcPriceSym').textContent    = curSym();
  $('#btcPriceCurLabel').textContent = cur;

  // Redisplay BTC price in new currency
  if (currentPriceUSD) {
    $('#btcPrice').value = Math.round(currentPriceUSD * fxRateUSD).toLocaleString();
  }
}

/* ─── YEAR DROPDOWNS ───────────────────────────────────────── */
(function initYears() {
  const s = $('#startYear'), e = $('#endYear');
  for (let y = FIRST_YEAR; y <= NOW_YEAR; y++) {
    s.add(new Option(y, y));
    e.add(new Option(y, y));
  }
  s.value = Math.min(2020, NOW_YEAR - 1);
  e.value = NOW_YEAR;
})();

/* ─── SLIDER PAINT ─────────────────────────────────────────── */
function paint(el) {
  const p = (el.value - el.min) / (el.max - el.min) * 100;
  el.style.background = `linear-gradient(to right,var(--primary) ${p}%,var(--track) ${p}%)`;
}
function refreshHorizon() {
  const N = +$('#horizon').value;
  $('#horizonVal').textContent  = N;
  $('#horizonYear').textContent = '→ ' + (NOW_YEAR + N);
  paint($('#horizon'));
}
function refreshCagr() {
  const v = +$('#cagrSlider').value;
  cagr = v / 100;
  $('#cagrVal').textContent  = v;
  $('#cagrName').textContent = CAGR_NAMES[v] || 'Custom';
  paint($('#cagrSlider'));
  $('#cagrPills').querySelectorAll('button').forEach(b => b.classList.toggle('on', +b.dataset.v === v));
}

/* ─── MODE ─────────────────────────────────────────────────── */
function setMode(m) {
  mode = m;
  document.body.dataset.mode = m;
  $('#modehint').textContent = HINTS[m];
  $('#modeswitch').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.m === m));
}

/* ─── NAV PRICE (CoinGecko, always USD) ────────────────────── */
async function fetchNavPrice() {
  const now = Date.now();
  if (now < navRatesExpiry && navPricesCache) { updateNavTicker(); return; }
  try {
    const ctrl  = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 9000);
    const r = await fetch(
      'https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_change=true',
      {signal: ctrl.signal}
    );
    clearTimeout(timer);
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const d = await r.json();
    navPricesCache = {usd: d.bitcoin.usd, change24h: d.bitcoin.usd_24h_change || 0};
    navRatesExpiry = Date.now() + 5 * 60 * 1000;
    updateNavTicker();
  } catch(e) { console.warn('Nav price:', e.message); }
}
function updateNavTicker() {
  if (!navPricesCache) return;
  const np = $('#nav-btc-price'), nc = $('#nav-btc-change');
  if (np) np.textContent = '$' + navPricesCache.usd.toLocaleString('en-US', {maximumFractionDigits:0});
  if (nc) {
    const ch = navPricesCache.change24h;
    nc.textContent = (ch >= 0 ? '▲' : '▼') + Math.abs(ch).toFixed(2) + '%';
    nc.style.color  = ch >= 0 ? '#05b26b' : '#f04452';
  }
}

/* ─── LIVE BTC PRICE (Binance → convert to selected currency) ─ */
async function loadPrice() {
  const btn = $('#refreshBtn');
  if (btn) btn.classList.add('spin');
  try {
    const r = await fetch('https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT');
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const d = await r.json();
    currentPriceUSD = Math.round(parseFloat(d.price));
    $('#btcPrice').value = Math.round(currentPriceUSD * fxRateUSD).toLocaleString();
  } catch(e) {
    console.warn('Binance price:', e.message);
    if (navPricesCache?.usd) {
      currentPriceUSD = Math.round(navPricesCache.usd);
      $('#btcPrice').value = Math.round(currentPriceUSD * fxRateUSD).toLocaleString();
    }
  } finally {
    if (btn) btn.classList.remove('spin');
  }
}

/* ─── INTERPOLATE PRICE ────────────────────────────────────── */
function interpolatePrice(data, target) {
  for (let i = 0; i < data.length - 1; i++) {
    const a = data[i], b = data[i+1];
    if (target >= a.date && target <= b.date) {
      const t = (target - a.date) / (b.date - a.date);
      return a.priceUSD + t * (b.priceUSD - a.priceUSD);
    }
  }
  if (target <= data[0].date) return data[0].priceUSD;
  return data[data.length - 1].priceUSD;
}

/* ─── BUILD PURCHASE DATES ─────────────────────────────────── */
function buildPurchaseDates(rangeData, frequency) {
  const dates = [];
  const first = rangeData[0].date, last = rangeData[rangeData.length-1].date;
  let d = new Date(first);
  while (d <= last) {
    dates.push(new Date(d));
    if (frequency === 'daily')       d.setDate(d.getDate() + 1);
    else if (frequency === 'weekly') d.setDate(d.getDate() + 7);
    else                             d.setMonth(d.getMonth() + 1);
  }
  return dates;
}

/* ─── ERROR HELPER ─────────────────────────────────────────── */
function showErr(msg) {
  const el = $('#err');
  el.textContent = msg;
  el.hidden = false;
}

/* ─── MAIN CALC ────────────────────────────────────────────── */
function runCalc() {
  $('#err').hidden = true;
  if (mode === 'backtest') runBacktest();
  else runProjection();
}

/* ─── BACKTEST ─────────────────────────────────────────────── */
function runBacktest() {
  // Input amount is in selected currency → convert to USD for BTC math
  const amtUSD = parseAmtUSD();
  if (amtUSD <= 0) { showErr('Please enter an amount above 0.'); return; }
  const sy = +$('#startYear').value, ey = +$('#endYear').value;
  if (ey <= sy) { showErr('End year must be after start year.'); return; }

  const rangeData = BTC_HISTORY.filter(p =>
    p.date >= new Date(Date.UTC(sy, 0, 1)) && p.date <= new Date(Date.UTC(ey, 11, 31))
  );
  if (rangeData.length < 2) { showErr('Not enough data for this date range.'); return; }

  // All prices in USD; display via money() which applies fxRateUSD
  const lumpBuyUSD = rangeData[0].priceUSD;
  const lumpBtc    = amtUSD / lumpBuyUSD;

  const purchaseDates  = buildPurchaseDates(rangeData, freq);
  const perPurchaseUSD = amtUSD / purchaseDates.length;
  let dcaBtc = 0;
  for (const pd of purchaseDates) {
    const p = interpolatePrice(rangeData, pd);
    if (p > 0) dcaBtc += perPurchaseUSD / p;
  }
  const dcaAvgUSD  = amtUSD / dcaBtc;
  const livePriceUSD = currentPriceUSD || rangeData[rangeData.length - 1].priceUSD;
  const dcaValUSD  = dcaBtc * livePriceUSD;
  const lumpValUSD = lumpBtc * livePriceUSD;

  // Chart (USD values; shape is currency-independent)
  const dS = [], lS = [];
  let dcaBtcSoFar = 0, pIdx = 0;
  for (const pt of rangeData) {
    while (pIdx < purchaseDates.length && purchaseDates[pIdx] <= pt.date) {
      const p = interpolatePrice(rangeData, purchaseDates[pIdx]);
      if (p > 0) dcaBtcSoFar += perPurchaseUSD / p;
      pIdx++;
    }
    dS.push(dcaBtcSoFar * pt.priceUSD);
    lS.push(lumpBtc * pt.priceUSD);
  }

  const freqUnit = {daily:'daily', weekly:'weekly', monthly:'monthly'}[freq] || 'periodic';
  render({mode:'backtest', amtUSD, dcaBtc, dcaAvgUSD, dcaValUSD, lumpBtc, lumpBuyUSD, lumpValUSD, dS, lS,
          purchaseCount: purchaseDates.length, perPurchaseUSD, freqUnit});
}

/* ─── PROJECTION ───────────────────────────────────────────── */
function runProjection() {
  const amtUSD = parseAmtUSD();
  if (amtUSD <= 0) { showErr('Please enter an amount above 0.'); return; }

  // BTC price field shows in selected currency → convert back to USD for math
  const fieldVal  = parseFloat(($('#btcPrice').value||'').replace(/[^0-9.]/g,'')) || 0;
  const P0USD     = fxRateUSD > 0 ? fieldVal / fxRateUSD : fieldVal;
  const p0Fallback = currentPriceUSD || (P0USD > 0 ? P0USD : 0);
  if (!p0Fallback) { showErr('BTC price not loaded. Click ↻ to refresh.'); return; }
  const startPriceUSD = P0USD > 0 ? P0USD : p0Fallback;

  const N           = +$('#horizon').value;
  const g           = cagr;
  const totalMonths = N * 12;
  const perMonthUSD = amtUSD / totalMonths;
  const lumpBtc     = amtUSD / startPriceUSD;
  let dcaBtc = 0;
  const dS = [], lS = [];

  for (let k = 0; k <= totalMonths; k++) {
    const pt = startPriceUSD * Math.pow(1 + g, k / 12);
    if (k < totalMonths) dcaBtc += perMonthUSD / pt;
    dS.push(dcaBtc * pt);
    lS.push(lumpBtc * pt);
  }

  const PN        = startPriceUSD * Math.pow(1 + g, N);
  const dcaValUSD = dcaBtc * PN;
  const lumpValUSD = lumpBtc * PN;
  const dcaAvgUSD  = amtUSD / dcaBtc;

  render({mode:'projection', amtUSD, N, dcaBtc, dcaAvgUSD, dcaValUSD, lumpBtc, lumpBuyUSD:startPriceUSD, lumpValUSD, dS, lS,
          purchaseCount: totalMonths, perPurchaseUSD: perMonthUSD, freqUnit:'monthly'});
}

/* ─── RENDER ───────────────────────────────────────────────── */
// All price values passed in are USD; money() handles conversion + symbol
function render(r) {
  $('#freqLabel').textContent = freq;

  // Investment detail lines
  const countStr = r.purchaseCount.toLocaleString('en-US');
  $('#dcaDesc').textContent =
    `${money(r.amtUSD)} split into ${countStr} ${r.freqUnit} buys · ~${money(r.perPurchaseUSD)} each`;
  $('#lsDesc').textContent =
    `${money(r.amtUSD)} invested all at once on day 1`;

  if (r.mode === 'backtest') {
    $('#chartTitle').textContent = 'PORTFOLIO VALUE OVER TIME';
    $('#lumpHead').textContent   = 'Lump sum (day 1)';
    $('#dL1').textContent = 'BTC accumulated'; $('#d1').textContent = btcFmt(r.dcaBtc);
    $('#dL2').textContent = 'Avg buy price';   $('#d2').textContent = money(r.dcaAvgUSD);
    $('#dL3').textContent = 'Value today';     $('#d3').textContent = money(r.dcaValUSD);
    $('#lL1').textContent = 'BTC accumulated'; $('#l1').textContent = btcFmt(r.lumpBtc);
    $('#lL2').textContent = 'Buy price';       $('#l2').textContent = money(r.lumpBuyUSD);
    $('#lL3').textContent = 'Value today';     $('#l3').textContent = money(r.lumpValUSD);

    const diff = r.lumpValUSD - r.dcaValUSD;
    const w    = diff >= 0 ? 'Lump sum' : 'DCA';
    const pct  = (Math.abs(diff) / Math.min(r.dcaValUSD, r.lumpValUSD) * 100).toFixed(0);
    $('#verdict').textContent = `${w} won by +${money(Math.abs(diff))} (+${pct}%) over this period`;
  } else {
    $('#chartTitle').textContent = 'PROJECTED VALUE OVER TIME';
    $('#lumpHead').textContent   = 'Lump sum (now)';
    $('#dL1').textContent = 'Total invested';  $('#d1').textContent = money(r.amtUSD);
    $('#dL2').textContent = 'Projected BTC';   $('#d2').textContent = btcFmt(r.dcaBtc);
    $('#dL3').textContent = 'Projected value'; $('#d3').textContent = money(r.dcaValUSD);
    $('#lL1').textContent = 'Invested now';    $('#l1').textContent = money(r.amtUSD);
    $('#lL2').textContent = 'Projected BTC';   $('#l2').textContent = btcFmt(r.lumpBtc);
    $('#lL3').textContent = 'Projected value'; $('#l3').textContent = money(r.lumpValUSD);

    const diff = r.lumpValUSD - r.dcaValUSD;
    const more = diff >= 0 ? 'more' : 'less';
    const pct  = (Math.abs(diff) / Math.min(r.dcaValUSD, r.lumpValUSD) * 100).toFixed(0);
    $('#verdict').textContent = `Lump sum now projects ${money(Math.abs(diff))} ${more} than DCA (+${pct}%) over ${r.N} years`;
  }

  drawChart(r.dS, r.lS);
}

/* ─── SVG CHART ────────────────────────────────────────────── */
function drawChart(dS, lS) {
  const svg = $('#svgChart'), W = 700, H = 240, pad = 12;
  const max = Math.max(...dS, ...lS, 1);
  const n   = Math.max(dS.length - 1, 1);
  const x   = i => pad + i / n * (W - 2 * pad);
  const y   = v => H - pad - v / max * (H - 2 * pad);
  const pts = arr => arr.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
  svg.innerHTML =
    `<polyline fill="none" stroke="#9aa1ab" stroke-width="2.5" points="${pts(dS)}"/>` +
    `<polyline fill="none" stroke="#1f5fd0" stroke-width="2.5" points="${pts(lS)}"/>`;
}

/* ─── EVENTS ───────────────────────────────────────────────── */
$('#modeswitch').addEventListener('click', e => {
  const b = e.target.closest('button');
  if (b) setMode(b.dataset.m);
});
$('#freqPills').addEventListener('click', e => {
  const b = e.target.closest('button');
  if (!b) return;
  $('#freqPills').querySelectorAll('button').forEach(x => x.classList.remove('on'));
  b.classList.add('on');
  freq = b.dataset.v;
});
$('#cagrPills').addEventListener('click', e => {
  const b = e.target.closest('button');
  if (!b) return;
  $('#cagrSlider').value = b.dataset.v;
  refreshCagr();
});
$('#horizon').addEventListener('input', refreshHorizon);
$('#cagrSlider').addEventListener('input', refreshCagr);
$('#currency').addEventListener('change', () => applyFxRate());
$('#btcPrice').addEventListener('input', () => {
  // Field shows selected currency → store USD internally
  const val = parseFloat(($('#btcPrice').value||'').replace(/[^0-9.]/g,''));
  if (val > 0) currentPriceUSD = fxRateUSD > 0 ? val / fxRateUSD : val;
});
$('#go').addEventListener('click', runCalc);
$('#refreshBtn').addEventListener('click', loadPrice);

/* ─── AMOUNT INPUT: comma formatting with cursor preservation ─ */
$('#amount').addEventListener('input', function() {
  const sel     = this.selectionStart;
  const oldVal  = this.value;
  // Count digits before cursor so we can restore relative position
  const digitsBeforeCursor = oldVal.slice(0, sel).replace(/\D/g, '').length;

  const raw = oldVal.replace(/\D/g, '');
  this.value = raw ? parseInt(raw, 10).toLocaleString('en-US') : '';

  // Restore cursor: advance through new value until we've passed the same number of digits
  let count = 0, pos = 0;
  for (let i = 0; i < this.value.length; i++) {
    if (count === digitsBeforeCursor) { pos = i; break; }
    if (/\d/.test(this.value[i])) count++;
    pos = i + 1;
  }
  this.setSelectionRange(pos, pos);
});

/* ─── INIT ─────────────────────────────────────────────────── */
setMode('backtest');
refreshHorizon();
refreshCagr();
// Fetch FX rates first, then load BTC price (so display is correct from the start)
applyFxRate().then(loadPrice);
fetchNavPrice();
setInterval(loadPrice, 60000);
setInterval(fetchNavPrice, 60000);

async function copyWallet(id, btn) {
  const v = document.getElementById(id).textContent.trim();
  try {
    await navigator.clipboard.writeText(v);
    btn.textContent = 'Copied!'; btn.classList.add('done');
    setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('done'); }, 2000);
  } catch(e) {}
}
</script>
