  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="description" content="Compare Bitcoin DCA vs Lump Sum investing strategies with real historical data and future projections."/>
  <title>DCA vs Lump Sum — Bitcoin Strategy Comparison | SkipTheLatte</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --blue:#1763B6;--blue-h:#1357a0;--blue-bg:#eaf1fb;
      --green:#05b26b;--green-bg:#eafaf3;
      --red:#f04452;--amber:#f59e0b;--amber-bg:#fffbeb;
      --bg:#fff;--bg2:#f7f8fa;--border:#e5e8eb;--border2:#dde1e7;
      --text:#0a0a0a;--text2:#5c6370;--text3:#9ea5b0;
      --font:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    }
    html{font-family:var(--font);background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
    body{min-height:100vh;display:flex;flex-direction:column}
    button{font-family:inherit;cursor:pointer}
    input,select{font-family:inherit}
    a{color:var(--blue);text-decoration:none}

    .nav{position:sticky;top:0;z-index:200;background:var(--bg);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 24px;height:56px;gap:12px}
    .nav-logo{display:flex;align-items:center;gap:8px;font-size:16px;font-weight:800;color:var(--text);letter-spacing:-.02em;white-space:nowrap}
    .logo-dot{width:8px;height:8px;border-radius:50%;background:var(--blue);flex-shrink:0}
    .nav-center{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--text2)}
    .btc-live-price{font-size:14px;font-weight:700;color:var(--text);font-variant-numeric:tabular-nums}
    #nav-btc-change{font-size:12px;font-weight:600}
    .nav-right{display:flex;align-items:center;gap:6px;flex-shrink:0}
    .live-dot{width:5px;height:5px;border-radius:50%;background:var(--green);display:inline-block;animation:blink 2s ease-in-out infinite}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

    .wrap{max-width:800px;margin:0 auto;width:100%;padding:0 24px}
    main{flex:1;padding-bottom:64px}

    .sec-head{display:flex;align-items:center;gap:12px;padding:36px 0 20px}
    .sec-num{font-size:11px;font-weight:800;letter-spacing:.1em;color:var(--blue)}
    .sec-line{flex:none;width:24px;height:1.5px;background:var(--border2)}
    .sec-title{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--text2)}

    .section-card{background:var(--bg);border:1.5px solid var(--border);border-radius:14px;padding:24px;display:flex;flex-direction:column;gap:20px}

    .field{display:flex;flex-direction:column;gap:6px}
    .field>label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--text3)}
    .irow{position:relative;display:flex;align-items:center}
    .ipre{position:absolute;left:12px;font-size:13px;font-weight:600;color:var(--text3);pointer-events:none;z-index:1}
    input[type="number"]{width:100%;background:var(--bg2);border:1.5px solid var(--border);color:var(--text);padding:11px 13px;border-radius:9px;font-size:15px;font-weight:500;transition:border-color .15s,box-shadow .15s;-moz-appearance:textfield}
    input::-webkit-inner-spin-button,input::-webkit-outer-spin-button{-webkit-appearance:none}
    input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,99,182,.1);background:#fff}
    .with-pre input{padding-left:28px}
    input::placeholder{color:var(--text3);font-size:13px}
    select{padding:11px 13px;border:1.5px solid var(--border);border-radius:9px;background:var(--bg2);font-size:15px;font-weight:500;color:var(--text);cursor:pointer;outline:none;transition:border-color .15s;width:100%}
    select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(23,99,182,.1);background:#fff}
    .field-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}

    .pill-group{display:flex;border:1px solid var(--border);border-radius:7px;overflow:hidden}
    .pill-btn{padding:5px 11px;font-size:12px;font-weight:600;flex:1;color:var(--text2);background:transparent;border:none;border-right:1px solid var(--border);transition:all .12s;text-align:center}
    .pill-btn:last-child{border-right:none}
    .pill-btn:hover{color:var(--blue);background:var(--blue-bg)}
    .pill-btn.on{background:var(--blue);color:#fff}

    .btn-calc{width:100%;padding:16px;background:var(--blue);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;box-shadow:0 4px 14px rgba(23,99,182,.25);transition:all .15s}
    .btn-calc:hover{background:var(--blue-h);box-shadow:0 6px 20px rgba(23,99,182,.3);transform:translateY(-1px)}
    .btn-calc:active{transform:translateY(0)}

    .err-msg{display:none;font-size:12px;color:var(--red);background:#fff0f1;border:1px solid #fcd0d3;border-radius:7px;padding:8px 12px}
    .err-msg.show{display:block}

    .hero-section{background:var(--bg);border-bottom:1px solid var(--border);padding:56px 24px 48px}
    .hero-inner{max-width:800px;margin:0 auto;text-align:center;display:flex;flex-direction:column;align-items:center}
    .hero-eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--blue);margin-bottom:16px;display:flex;align-items:center;gap:8px}
    .hero-eyebrow::before{content:'';width:18px;height:2px;background:var(--blue)}
    .hero-h1{font-size:clamp(36px,7vw,68px);font-weight:900;letter-spacing:-.04em;line-height:.95;margin-bottom:20px}
    .hero-h1 .blue{color:var(--blue)}
    .hero-sub{font-size:clamp(15px,2vw,17px);color:var(--text2);line-height:1.6;max-width:520px;text-align:center}

    .ad-slot{max-width:800px;margin:0 auto;width:100%;background:var(--bg2);border:1px dashed var(--border2);border-radius:10px;min-height:90px;display:flex;align-items:center;justify-content:center;text-align:center;padding:8px}
    .ad-slot-wrap{padding:16px 24px}

    /* MODE SWITCH */
    .mode-switch{display:flex;background:var(--bg2);border:1.5px solid var(--border);border-radius:12px;padding:4px;gap:4px;margin-top:8px}
    .msw-btn{flex:1;border:none;background:transparent;color:var(--text2);font-size:13px;font-weight:700;padding:12px;border-radius:9px;cursor:pointer;transition:.15s;letter-spacing:.02em}
    .msw-btn.on{background:#fff;color:var(--blue);box-shadow:0 1px 6px rgba(0,0,0,.08)}
    .mode-hint{color:var(--text3);font-size:12px;margin:8px 0 0;padding:0 2px;line-height:1.5}

    .only-backtest,.only-projection{display:none}
    body[data-mode="backtest"]  .only-backtest {display:block}
    body[data-mode="projection"] .only-projection{display:block}

    /* SLIDERS */
    .slider-row{display:flex;flex-direction:column;gap:8px}
    .slider-labels{display:flex;justify-content:space-between;align-items:center}
    .slider-val{font-size:20px;font-weight:800;color:var(--blue);font-variant-numeric:tabular-nums}
    .slider-sub{font-size:12px;color:var(--text3)}
    input[type="range"]{-webkit-appearance:none;width:100%;height:4px;border-radius:2px;background:linear-gradient(to right,var(--blue) 0%,var(--blue) var(--pct,50%),var(--border2) var(--pct,50%),var(--border2) 100%);outline:none;cursor:pointer}
    input[type="range"]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:var(--blue);border:2.5px solid #fff;box-shadow:0 1px 6px rgba(23,99,182,.3);cursor:pointer}
    input[type="range"]::-moz-range-thumb{width:20px;height:20px;border-radius:50%;background:var(--blue);border:2.5px solid #fff;cursor:pointer}
    .slider-minmax{display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-top:2px}

    /* CAGR SCENARIO PILLS */
    .scenario-pills{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:4px}
    .sc-btn{padding:6px 13px;border-radius:7px;font-size:12px;font-weight:700;background:var(--bg2);border:1.5px solid var(--border);color:var(--text2);transition:all .12s}
    .sc-btn[data-sc="bear"].on{background:#fef2f2;border-color:var(--red);color:var(--red)}
    .sc-btn[data-sc="base"].on{background:var(--blue-bg);border-color:var(--blue);color:var(--blue)}
    .sc-btn[data-sc="bull"].on{background:var(--green-bg);border-color:var(--green);color:var(--green)}
    .sc-btn[data-sc="hyperbull"].on{background:var(--amber-bg);border-color:var(--amber);color:var(--amber)}

    /* BTC PRICE ROW */
    .price-row{display:flex;gap:8px;align-items:stretch}
    .price-row .irow{flex:1}
    .btn-refresh{padding:0 14px;background:var(--bg2);border:1.5px solid var(--border);border-radius:9px;color:var(--text2);font-size:16px;transition:all .12s;flex-shrink:0}
    .btn-refresh:hover{border-color:var(--blue);color:var(--blue)}
    .btn-refresh.spin{animation:spin .6s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}

    /* RESULTS */
    #results{display:none}
    .conclusion-banner{border-radius:12px;padding:20px 24px;display:flex;align-items:center;gap:14px;margin-bottom:4px}
    .conclusion-banner.dca-wins{background:linear-gradient(135deg,#eafaf3,#d4f5e7);border:1.5px solid #a8e6c8}
    .conclusion-banner.ls-wins{background:linear-gradient(135deg,#eaf1fb,#d0e3f7);border:1.5px solid #a8c8ef}
    .conclusion-icon{font-size:28px;flex-shrink:0}
    .conclusion-text{flex:1}
    .conclusion-title{font-size:15px;font-weight:800;color:var(--text);margin-bottom:4px}
    .conclusion-sub{font-size:13px;color:var(--text2);line-height:1.5}

    .compare-cards{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:4px}
    .compare-card{border:1.5px solid var(--border);border-radius:14px;padding:20px;background:var(--bg)}
    .compare-card.winner{border-color:var(--green);background:var(--green-bg)}
    .compare-card.loser{opacity:.85}
    .card-strategy-label{font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--text3);margin-bottom:12px;display:flex;align-items:center;gap:8px}
    .winner-badge{background:var(--green);color:#fff;border-radius:4px;padding:2px 7px;font-size:9px;font-weight:800;letter-spacing:.08em}
    .card-value-main{font-size:28px;font-weight:900;letter-spacing:-.03em;color:var(--text);margin-bottom:2px}
    .card-value-sub{font-size:13px;color:var(--text2);margin-bottom:16px}
    .card-stats{display:flex;flex-direction:column;gap:8px}
    .card-stat{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)}
    .card-stat:last-child{border-bottom:none}
    .card-stat-label{font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:.05em}
    .card-stat-val{font-size:13px;font-weight:700;color:var(--text)}

    .chart-wrap{border:1.5px solid var(--border);border-radius:14px;padding:24px;background:var(--bg)}
    .chart-title{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--text2);margin-bottom:16px}
    .chart-legend{display:flex;gap:20px;margin-bottom:16px;flex-wrap:wrap}
    .legend-item{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--text2)}
    .legend-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
    .legend-dot.dca{background:var(--blue)}
    .legend-dot.ls{background:var(--amber)}
    canvas#chart{width:100%;display:block;border-radius:8px}

    .loading-overlay{display:none;position:fixed;inset:0;background:rgba(255,255,255,.8);z-index:300;align-items:center;justify-content:center;flex-direction:column;gap:12px}
    .loading-overlay.show{display:flex}
    .spinner{width:40px;height:40px;border:3px solid var(--border);border-top-color:var(--blue);border-radius:50%;animation:spin .8s linear infinite}
    .loading-text{font-size:13px;font-weight:600;color:var(--text2)}

    .tip-section{border:1.5px solid var(--border);border-radius:12px;padding:20px;margin-bottom:16px}
    .tip-head{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--text2);margin-bottom:4px;display:flex;align-items:center;gap:8px}
    .tip-head::before{content:'';width:16px;height:1.5px;background:var(--border2)}
    .tip-sub{font-size:12px;color:var(--text3);margin-bottom:14px}
    .wallet-list{display:flex;flex-direction:column;gap:10px}
    .wallet-item{display:flex;align-items:center;gap:12px;background:var(--bg2);border:1.5px solid var(--border);border-radius:10px;padding:12px 14px}
    .wallet-icon{width:36px;height:36px;border-radius:8px;background:var(--blue-bg);display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:800;color:var(--blue);flex-shrink:0}
    .wallet-info{flex:1;min-width:0}
    .wallet-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text3);margin-bottom:3px}
    .wallet-addr{font-size:12px;font-family:'Courier New',monospace;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500}
    .btn-wallet-copy{padding:7px 14px;background:var(--bg);border:1.5px solid var(--border);border-radius:7px;font-size:12px;font-weight:600;color:var(--text2);transition:all .12s;white-space:nowrap;flex-shrink:0;cursor:pointer;font-family:inherit}
    .btn-wallet-copy:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-bg)}
    .btn-wallet-copy.done{background:var(--green);border-color:var(--green);color:#fff}
    .tip-phantom{font-size:12px;color:var(--text3);margin-top:10px;text-align:center}

    footer{background:var(--bg2);border-top:1px solid var(--border);padding:40px 24px 24px}
    .footer-inner{max-width:800px;margin:0 auto}
    .footer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-bottom:32px}
    .footer-col h4{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--text);margin-bottom:12px}
    .footer-col ul{list-style:none;display:flex;flex-direction:column;gap:7px}
    .footer-col a{font-size:13px;color:var(--text2);transition:color .12s}
    .footer-col a:hover{color:var(--blue)}
    .footer-bottom{border-top:1px solid var(--border);padding-top:16px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
    .footer-bottom p{font-size:12px;color:var(--text3)}
    .footer-brand{font-size:13px;font-weight:800;color:var(--text);letter-spacing:-.01em;display:flex;align-items:center;gap:6px}

    @media(max-width:600px){
      .nav{padding:0 16px;gap:8px}
      .nav-center{display:none}
      .wrap{padding:0 16px}
      .field-row{grid-template-columns:1fr}
      .compare-cards{grid-template-columns:1fr}
      .footer-grid{grid-template-columns:1fr;gap:20px}
    }
  </style>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2204132369832933" crossorigin="anonymous"></script>
</head>
<body data-mode="backtest">

<div class="loading-overlay" id="loading-overlay">
  <div class="spinner"></div>
  <div class="loading-text">Fetching historical BTC prices…</div>
</div>

<nav class="nav">
  <a class="nav-logo" href="/"><span class="logo-dot"></span>SkipTheLatte</a>
  <div class="nav-center">
    <span class="live-dot"></span>
    <span id="nav-btc-price" class="btc-live-price">—</span>
    <span id="nav-btc-change">—</span>
  </div>
  <div class="nav-right">
    <a href="/dca-vs-lumpsum" style="font-size:13px;font-weight:600;color:var(--blue);padding:5px 12px;border:1px solid var(--blue);border-radius:7px;background:var(--blue-bg)">DCA vs Lump Sum</a>
    <a href="/freedom" style="font-size:13px;font-weight:600;color:var(--text2);padding:5px 12px;border:1px solid var(--border);border-radius:7px" onmouseover="this.style.color='#1763B6';this.style.borderColor='#1763B6'" onmouseout="this.style.color='';this.style.borderColor=''">Freedom Planner</a>
    <a href="/blog" style="font-size:13px;font-weight:600;color:var(--text2);padding:5px 12px;border:1px solid var(--border);border-radius:7px" onmouseover="this.style.color='#1763B6';this.style.borderColor='#1763B6'" onmouseout="this.style.color='';this.style.borderColor=''">Blog</a>
    <a href="/faq" style="font-size:13px;font-weight:600;color:var(--text2);padding:5px 12px;border:1px solid var(--border);border-radius:7px" onmouseover="this.style.color='#1763B6';this.style.borderColor='#1763B6'" onmouseout="this.style.color='';this.style.borderColor=''">FAQ</a>
  </div>
</nav>

<main>
<div class="hero-section">
  <div class="hero-inner">
    <div class="hero-eyebrow">Strategy Comparison</div>
    <h1 class="hero-h1"><span class="blue">DCA</span> vs LUMP SUM</h1>
    <p class="hero-sub">Compare real historical outcomes — or project forward from today's live price.</p>
  </div>
</div>

<div class="wrap">

  <div class="ad-slot-wrap">
    <div class="ad-slot">
      <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2204132369832933" data-ad-slot="3333333333" data-ad-format="auto" data-full-width-responsive="true"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  </div>

  <!-- MODE SWITCH -->
  <div class="mode-switch" id="modeswitch">
    <button class="msw-btn on" data-m="backtest">📊 Historical backtest</button>
    <button class="msw-btn" data-m="projection">🔮 Future projection</button>
  </div>
  <p class="mode-hint" id="modehint">What would have actually happened if you'd invested in the past — using real BTC price history.</p>

  <!-- 01 INPUTS -->
  <div class="sec-head">
    <span class="sec-num">01</span>
    <span class="sec-line"></span>
    <span class="sec-title">YOUR INVESTMENT</span>
  </div>
  <div class="section-card">

    <div class="field-row">
      <div class="field">
        <label for="total-amount">Total Investment</label>
        <div class="irow with-pre">
          <span class="ipre" id="currency-symbol">$</span>
          <input type="number" id="total-amount" min="1" value="10000" placeholder="10000"/>
        </div>
      </div>
      <div class="field">
        <label for="currency-select">Currency</label>
        <select id="currency-select">
          <option value="usd" selected>USD — US Dollar</option>
          <option value="eur">EUR — Euro</option>
          <option value="gbp">GBP — British Pound</option>
          <option value="krw">KRW — Korean Won</option>
          <option value="jpy">JPY — Japanese Yen</option>
          <option value="cad">CAD — Canadian Dollar</option>
          <option value="aud">AUD — Australian Dollar</option>
          <option value="sgd">SGD — Singapore Dollar</option>
          <option value="hkd">HKD — Hong Kong Dollar</option>
          <option value="aed">AED — UAE Dirham</option>
          <option value="inr">INR — Indian Rupee</option>
        </select>
      </div>
    </div>

    <!-- BACKTEST: year range -->
    <div class="only-backtest">
      <div class="field-row">
        <div class="field">
          <label for="start-year">Start Year</label>
          <select id="start-year"></select>
        </div>
        <div class="field">
          <label for="end-year">End Year</label>
          <select id="end-year"></select>
        </div>
      </div>
    </div>

    <!-- PROJECTION: horizon + CAGR + live BTC price -->
    <div class="only-projection">

      <div class="field">
        <label>Time Horizon</label>
        <div class="slider-row">
          <div class="slider-labels">
            <span class="slider-val"><span id="horizon-val">10</span> <span style="font-size:14px;font-weight:500;color:var(--text2)">years</span></span>
            <span class="slider-sub" id="horizon-year">→ 2036</span>
          </div>
          <input type="range" id="horizon-slider" min="1" max="40" value="10"/>
          <div class="slider-minmax"><span>1 yr</span><span>40 yrs</span></div>
        </div>
      </div>

      <div class="field">
        <label>Expected Annual Return (CAGR)</label>
        <div class="scenario-pills">
          <button class="sc-btn" data-sc="bear">Bear</button>
          <button class="sc-btn on" data-sc="base">Base</button>
          <button class="sc-btn" data-sc="bull">Bull</button>
          <button class="sc-btn" data-sc="hyperbull">Hyperbull</button>
        </div>
        <div class="slider-row">
          <div class="slider-labels">
            <span class="slider-val"><span id="cagr-val">21</span>%</span>
            <span class="slider-sub" id="cagr-label">Base Case</span>
          </div>
          <input type="range" id="cagr-slider" min="5" max="60" value="21"/>
          <div class="slider-minmax"><span>5%</span><span>60%</span></div>
        </div>
      </div>

      <div class="field">
        <label>Current BTC Price (USD) — via Binance</label>
        <div class="price-row">
          <div class="irow with-pre">
